<!DOCTYPE html>
<html lang="<%= (typeof pageLang !== 'undefined' && pageLang === 'en') ? 'en' : 'zh-Hant' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= (typeof pageLang !== 'undefined' && pageLang === 'en') ? 'Registration Successful' : '登記成功' %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, Helvetica, sans-serif;
            font-weight: 400;
        }
        body, body input, body select, body textarea, body button, body label,
        body h1, body h2, body h3, body h4, body h5, body h6, body p, body span, body a {
            font-family: Arial, Helvetica, sans-serif !important;
        }
        .container {
            max-width: 800px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 30px;
            margin-top: 30px;
            margin-bottom: 30px;
        }
        .form-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e9ecef;
        }
        .form-header h1 {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 10px;
        }
        .success-content {
            text-align: center;
            padding: 40px 20px;
        }
        .success-icon {
            font-size: 64px;
            color: #28a745;
            margin-bottom: 20px;
        }
        .success-title {
            color: #2c3e50;
            font-size: 1.5rem;
            font-weight: 600;
            margin-bottom: 20px;
        }
        .success-message,
        #emailMessage {
            color: #6c757d;
            font-size: 1.1rem;
            margin-bottom: 30px;
            white-space: pre-line;
        }
        .transaction-details {
            background-color: #f8f9fa;
            border-radius: 5px;
            padding: 20px;
            margin: 20px 0;
            text-align: left;
        }
        .transaction-details h5 {
            color: #2c3e50;
            margin-bottom: 15px;
        }
        .transaction-item {
            padding: 8px 0;
            border-bottom: 1px solid #dee2e6;
        }
        .transaction-item:last-child {
            border-bottom: none;
        }
        .transaction-item-sub {
            padding-top: 0;
            padding-left: 12px;
            font-size: 0.95rem;
            color: #6c757d;
        }
        .transaction-item-sub strong {
            font-weight: 500;
        }
        .transaction-item-total {
            font-weight: 600;
        }
    </style>
</head>
<body>
    <div class="container">
        <!-- 輪播 -->
        <div id="carouselExampleCaptions" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="<%= typeof eventBannerSrc !== 'undefined' ? eventBannerSrc : '/exvent/' + event_id + '.jpg' %>" class="d-block w-100" alt="第一張圖片"
                         onerror="this.onerror=null;this.src='<%= typeof fallbackBannerSrc !== 'undefined' ? fallbackBannerSrc : '/exvent/banner.jpg' %>'">
                    <div class="carousel-caption d-none d-md-block">
                    </div>
                </div>
            </div>
        </div>

        <div class="form-header">
            <div class="success-icon">✓</div>
            <h1 id="successTitle" data-zh="登記成功" data-en="Registration Successful"><%= (typeof pageLang !== 'undefined' && pageLang === 'en') ? 'Registration Successful' : '登記成功' %></h1>
        </div>

        <div class="success-content">
            <% 
                const ty = (typeof formConfig !== 'undefined' && formConfig && formConfig.thankYou) ? formConfig.thankYou : {};
                const ynq = ty.yesNoQuestion || {};
                const answerRaw = (typeof thankYouYesNo !== 'undefined' && thankYouYesNo != null)
                    ? String(thankYouYesNo).trim().toLowerCase()
                    : '';
                const answeredYes = ['yes', 'y', '是', 'true', '1'].includes(answerRaw);
                const answeredNo = answerRaw !== '' && !answeredYes;
                const useYesCopy = answeredYes && ynq && ynq.enabled;
                const useNoCopy = answeredNo && ynq && ynq.enabled;

                let freeTitleZh = (ty.title && ty.title.zh) ? ty.title.zh : '感謝你參加！';
                let freeTitleEn = (ty.title && ty.title.en) ? ty.title.en : 'Thank you for participating!';
                let freeMsgZh = (ty.message && ty.message.zh) ? ty.message.zh : '我們會透過 Email 把資訊發送給你。';
                let freeMsgEn = (ty.message && ty.message.en) ? ty.message.en : 'We will send the information to you via Email.';
                let purchaseTitleZh = (ty.purchaseTitle && ty.purchaseTitle.zh) ? ty.purchaseTitle.zh : '感謝您的購票！';
                let purchaseTitleEn = (ty.purchaseTitle && ty.purchaseTitle.en) ? ty.purchaseTitle.en : 'Thank you for your purchase!';
                let purchaseMsgZh = (ty.purchaseMessage && ty.purchaseMessage.zh) ? ty.purchaseMessage.zh : '您的付款已成功，以下是您的交易紀錄：';
                let purchaseMsgEn = (ty.purchaseMessage && ty.purchaseMessage.en) ? ty.purchaseMessage.en : 'Your payment was successful. Here are your transaction details:';

                if (useYesCopy) {
                    if (ynq.yesTitle && ynq.yesTitle.zh) freeTitleZh = ynq.yesTitle.zh;
                    if (ynq.yesTitle && ynq.yesTitle.en) freeTitleEn = ynq.yesTitle.en;
                    if (ynq.yesMessage && ynq.yesMessage.zh) freeMsgZh = ynq.yesMessage.zh;
                    if (ynq.yesMessage && ynq.yesMessage.en) freeMsgEn = ynq.yesMessage.en;
                    if (ynq.yesPurchaseTitle && ynq.yesPurchaseTitle.zh) purchaseTitleZh = ynq.yesPurchaseTitle.zh;
                    if (ynq.yesPurchaseTitle && ynq.yesPurchaseTitle.en) purchaseTitleEn = ynq.yesPurchaseTitle.en;
                    if (ynq.yesPurchaseMessage && ynq.yesPurchaseMessage.zh) purchaseMsgZh = ynq.yesPurchaseMessage.zh;
                    if (ynq.yesPurchaseMessage && ynq.yesPurchaseMessage.en) purchaseMsgEn = ynq.yesPurchaseMessage.en;
                } else if (useNoCopy) {
                    if (ynq.noTitle && ynq.noTitle.zh) freeTitleZh = ynq.noTitle.zh;
                    if (ynq.noTitle && ynq.noTitle.en) freeTitleEn = ynq.noTitle.en;
                    if (ynq.noMessage && ynq.noMessage.zh) freeMsgZh = ynq.noMessage.zh;
                    if (ynq.noMessage && ynq.noMessage.en) freeMsgEn = ynq.noMessage.en;
                    if (ynq.noPurchaseTitle && ynq.noPurchaseTitle.zh) purchaseTitleZh = ynq.noPurchaseTitle.zh;
                    if (ynq.noPurchaseTitle && ynq.noPurchaseTitle.en) purchaseTitleEn = ynq.noPurchaseTitle.en;
                    if (ynq.noPurchaseMessage && ynq.noPurchaseMessage.zh) purchaseMsgZh = ynq.noPurchaseMessage.zh;
                    if (ynq.noPurchaseMessage && ynq.noPurchaseMessage.en) purchaseMsgEn = ynq.noPurchaseMessage.en;
                }

                const successPageLang = (typeof pageLang !== 'undefined' && pageLang === 'en') ? 'en' : 'zh';
                const pickTy = function(zh, en) {
                    return successPageLang === 'en' ? (en || zh || '') : (zh || en || '');
                };
            %>
            <% if (transaction) { %>
                <h5 id="thankYouTitle"><%= pickTy(purchaseTitleZh, purchaseTitleEn) %></h5>
                <p id="emailMessage"><%= pickTy(purchaseMsgZh, purchaseMsgEn) %></p>
                
                <div class="transaction-details">
                    <h5 id="transactionTitle" data-zh="交易詳情" data-en="Transaction Details">交易詳情</h5>
                    <div class="transaction-item">
                        <strong id="orderLabel" data-zh="訂單編號：" data-en="Order Number: ">訂單編號：</strong>
                        <span><%= transaction && transaction._id ? transaction._id : '' %></span>
                    </div>
                    <div class="transaction-item">
                        <strong id="ticketLabel" data-zh="票券名稱：" data-en="Ticket Name: ">票券名稱：</strong>
                        <span><%= transaction && transaction.ticketTitle ? transaction.ticketTitle : '' %></span>
                    </div>
                    <div class="transaction-item">
                        <strong id="priceLabel" data-zh="票券價格：" data-en="Ticket Price: ">票券價格：</strong>
                        <span><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= paymentBreakdown ? paymentBreakdown.ticketPrice.toFixed(2) : (transaction && transaction.ticketPrice != null ? Number(transaction.ticketPrice).toFixed(2) : '') %></span>
                    </div>
                    <% if (paymentBreakdown) { %>
                    <div class="transaction-item transaction-item-sub">
                        <strong id="processingFeeLabel" data-zh="手續費 (5.8%)：" data-en="Processing fee (5.8%): ">手續費 (5.8%)：</strong>
                        <span><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= paymentBreakdown.processingFee.toFixed(2) %></span>
                    </div>
                    <div class="transaction-item transaction-item-total">
                        <strong id="totalLabel" data-zh="總計：" data-en="Total: ">總計：</strong>
                        <span><%= typeof currencySymbol !== 'undefined' ? currencySymbol : '$' %><%= paymentBreakdown.totalCharge.toFixed(2) %></span>
                    </div>
                    <% } %>
                    <div class="transaction-item">
                        <strong id="statusLabel" data-zh="付款狀態：" data-en="Payment Status: ">付款狀態：</strong>
                        <span><%= transaction && transaction.status ? transaction.status : '' %></span>
                    </div>
                </div>
            <% } else { %>
                <h5 id="thankYouTitle"><%= pickTy(freeTitleZh, freeTitleEn) %></h5>
                <p id="emailMessage"><%= pickTy(freeMsgZh, freeMsgEn) %></p>
            <% } %>
                <script type="application/json" id="thankYouCopyJson"><%- JSON.stringify({
                    title: { zh: freeTitleZh, en: freeTitleEn },
                    message: { zh: freeMsgZh, en: freeMsgEn },
                    purchaseTitle: { zh: purchaseTitleZh, en: purchaseTitleEn },
                    purchaseMessage: { zh: purchaseMsgZh, en: purchaseMsgEn },
                    hasTransaction: !!transaction
                }) %></script>
        </div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        // 從 URL 參數獲取語言
        function getLanguageFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const lang = urlParams.get('lang');
            if (lang === 'zh' || lang === 'en') {
                return lang;
            }
            return null;
        }
        
        const urlLanguage = getLanguageFromURL();
        const currentLanguage = urlLanguage || '<%= (typeof pageLang !== "undefined" && pageLang) ? pageLang : "zh" %>';
        
        const thankYouCopy = (function() {
            const el = document.getElementById('thankYouCopyJson');
            if (!el) return null;
            try { return JSON.parse(el.textContent); } catch (_) { return null; }
        })();

        $(document).ready(function() {
            updatePageLanguage();
        });
        
        function updatePageLanguage() {
            $('[data-zh][data-en]').each(function() {
                const $el = $(this);
                const zhText = $el.data('zh');
                const enText = $el.data('en');
                
                if (currentLanguage === 'zh' && zhText) {
                    $el.text(zhText);
                } else if (currentLanguage === 'en' && enText) {
                    $el.text(enText);
                }
            });

            if (thankYouCopy) {
                const lang = currentLanguage === 'en' ? 'en' : 'zh';
                const pick = function(obj) {
                    if (!obj) return '';
                    return (obj[lang] || obj.zh || obj.en || '').toString();
                };
                const title = thankYouCopy.hasTransaction
                    ? pick(thankYouCopy.purchaseTitle)
                    : pick(thankYouCopy.title);
                const message = thankYouCopy.hasTransaction
                    ? pick(thankYouCopy.purchaseMessage)
                    : pick(thankYouCopy.message);
                $('#thankYouTitle').text(title);
                $('#emailMessage').text(message);
            }
        }
    </script>
</body>
</html>
