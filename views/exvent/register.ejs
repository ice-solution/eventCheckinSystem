<!DOCTYPE html>
<%
function getRegisterEventTitle(formConfig, event, lang, allowEmpty) {
    var edn = (formConfig && formConfig.eventDisplayName) ? formConfig.eventDisplayName : { zh: '', en: '' };
    var fallback = (event && event.name) ? String(event.name).trim() : 'Event';
    var zh = edn.zh ? String(edn.zh).trim() : '';
    var en = edn.en ? String(edn.en).trim() : '';
    var custom = (lang === 'en') ? (en || zh) : (zh || en);
    if (allowEmpty) return custom;
    return custom || fallback;
}
var isApplicationMode = typeof applicationMode !== 'undefined' && !!applicationMode;
var applicationTokenVal = (typeof applicationToken !== 'undefined' && applicationToken) ? String(applicationToken) : '';
var applicationUserIdVal = (typeof applicationUserId !== 'undefined' && applicationUserId) ? String(applicationUserId) : '';
var lockedFieldsMap = (typeof lockedFields !== 'undefined' && lockedFields) ? lockedFields : {};
var fieldValuesMap = (typeof fieldValues !== 'undefined' && fieldValues) ? fieldValues : {};
function appIsLocked(fieldName) {
    return isApplicationMode && !!lockedFieldsMap[fieldName];
}
function appVal(fieldName) {
    if (!fieldValuesMap || fieldValuesMap[fieldName] === undefined || fieldValuesMap[fieldName] === null) return '';
    return fieldValuesMap[fieldName];
}
function appValStr(fieldName) {
    var v = appVal(fieldName);
    if (Array.isArray(v)) return v.join(', ');
    return String(v);
}
function appHasStoredValue(v) {
    if (v === undefined || v === null) return false;
    if (Array.isArray(v)) return v.length > 0;
    return String(v).trim() !== '';
}
function appNormalizeValueList(v) {
    if (!appHasStoredValue(v)) return [];
    if (Array.isArray(v)) return v.map(function (x) { return String(x); });
    return [String(v)];
}
function appStandardOptionValueSet(allOptions) {
    var standard = {};
    (allOptions || []).forEach(function (o) {
        if (!o || o.isOther) return;
        if (o.value === undefined || o.value === null) return;
        var s = String(o.value);
        if (s === '') return;
        standard[s] = true;
    });
    return standard;
}
/** Application 預填：有真實已存資料先剔；option value 空白唔好當匹配空資料 */
function appCheckboxChecked(fieldName, optionValue, optionIsOther, allOptions) {
    if (!isApplicationMode) return false;
    var list = appNormalizeValueList(appVal(fieldName));
    if (!list.length) return false;
    var optVal = (optionValue === undefined || optionValue === null) ? '' : String(optionValue);
    if (optVal !== '' && list.indexOf(optVal) !== -1) return true;
    // Other：已存值唔喺一般 option value 內（即用戶自填文字）→ 剔中 Other
    if (optionIsOther) {
        var standard = appStandardOptionValueSet(allOptions);
        return list.some(function (item) {
            return item !== '' && !standard[item];
        });
    }
    // option value 空白：唔好用空字串去 match 空資料（會全剔）
    return false;
}
function appRadioChecked(fieldName, optionValue, optionIsOther, allOptions) {
    if (!isApplicationMode) return false;
    var v = appVal(fieldName);
    if (!appHasStoredValue(v) || Array.isArray(v)) {
        // radio 通常係單值；若誤存陣列取第一個
        if (!Array.isArray(v) || !v.length) return false;
        v = v[0];
    }
    var stored = String(v);
    if (!stored) return false;
    var optVal = (optionValue === undefined || optionValue === null) ? '' : String(optionValue);
    if (optVal !== '' && stored === optVal) return true;
    if (optionIsOther) {
        var standard = appStandardOptionValueSet(allOptions);
        return !standard[stored];
    }
    return false;
}
/** Other 自填文字：DB 存嘅係自填內容（唔係 "Other" value） */
function appOtherTextValue(fieldName, optionValue, optionIsOther, allOptions) {
    if (!isApplicationMode || !optionIsOther) return '';
    var list = appNormalizeValueList(appVal(fieldName));
    if (!list.length) return '';
    var optVal = (optionValue === undefined || optionValue === null) ? '' : String(optionValue);
    var standard = appStandardOptionValueSet(allOptions);
    var customs = list.filter(function (item) {
        if (!item) return false;
        if (optVal && item === optVal) return false; // 淨剔 Other、未填文字
        if (standard[item]) return false;
        return true;
    });
    return customs.join(', ');
}
var registerPageLang = (formConfig && formConfig.defaultLanguage) ? formConfig.defaultLanguage : 'zh';
var registerEventTitle = getRegisterEventTitle(formConfig, event, registerPageLang, true);
var registerBrowserTitle = registerEventTitle || getRegisterEventTitle(formConfig, event, registerPageLang, false);
var registerPageTitleSuffix = isApplicationMode
    ? (registerPageLang === 'en' ? ' - Application' : ' - 申請')
    : (registerPageLang === 'en' ? ' - Register' : ' - 登記');
%>
<html lang="zh-Hant">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= registerBrowserTitle %><%= registerPageTitleSuffix %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body {
            background-color: #f8f9fa;
            font-family: Arial, Helvetica, sans-serif;
            font-weight: 400;
        }
        body, body input, body select, body textarea, body button, body label,
        body h1, body h2, body h3, body h4, body h5, body h6, body p, body span, body a, body .btn {
            font-family: Arial, Helvetica, sans-serif !important;
        }
        .container {
            max-width: 800px;
            background: white;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,0.1);
            padding: 30px;
            margin-top: 30px;
            margin-bottom: 30px;
        }
        .form-header {
            text-align: center;
            margin-bottom: 30px;
            padding-bottom: 20px;
            border-bottom: 2px solid #e9ecef;
        }
        .form-header h1 {
            color: #2c3e50;
            font-weight: 600;
            margin-bottom: 10px;
            text-align: center;
            overflow-wrap: anywhere;
            word-break: break-word;
            hyphens: auto;
        }
        .form-header .form-subheader,
        .form-header #formSubHeader {
            color: #34495e;
            font-size: 1.15rem;
            font-weight: 500;
            line-height: 1.4;
            margin: 0 auto 10px;
            max-width: 36em;
            text-align: center !important;
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .form-header #formSubtitle {
            font-size: 0.95rem;
            line-height: 1.5;
            margin: 0 auto;
            max-width: 36em;
            text-align: center;
        }
        .form-section {
            margin-bottom: 30px;
        }
        .form-section h3 {
            color: #34495e;
            font-size: 1.3rem;
            margin-bottom: 20px;
            font-weight: 600;
        }

        .language-switcher .btn-group .btn {
            padding: 8px 16px;
            font-size: 14px;
            border-radius: 4px;
        }

        .language-switcher .btn-group .btn.active {
            background-color: #007bff;
            border-color: #007bff;
            color: white;
        }

        .language-switcher .btn-group .btn:not(.active) {
            background-color: transparent;
            border-color: #007bff;
            color: #007bff;
        }

        .language-switcher .btn-group .btn:not(.active):hover {
            background-color: #007bff;
            color: white;
        }
        .form-note {
            background-color: #e3f2fd;
            border-left: 4px solid #2196f3;
            padding: 15px;
            margin-bottom: 25px;
            border-radius: 0 5px 5px 0;
            font-size: 0.9rem;
            color: #1565c0;
        }
        .form-row {
            display: flex;
            flex-direction: column;
            align-items: stretch;
            margin-bottom: 20px;
            padding: 10px 0;
            border-bottom: 1px solid #f1f3f4;
        }
        .form-label {
            display: block;
            width: 100%;
            font-weight: 600;
            color: #2c3e50;
            text-align: left;
            padding-right: 0;
            margin-bottom: 8px;
            line-height: 1.5;
            overflow-wrap: anywhere;
            word-break: break-word;
        }
        .form-input {
            width: 100%;
            max-width: 100%;
        }
        /* radio / checkbox：題目在上、選項在下（與一般欄位相同上下排） */
        .form-row.form-row-stacked .form-label {
            margin-bottom: 10px;
        }
        .form-row.form-row-stacked .form-input {
            width: 100%;
            max-width: 100%;
            margin-left: 0;
        }
        .radio-group,
        .checkbox-group {
            display: flex;
            flex-direction: column;
            gap: 8px;
        }
        .radio-group .form-check,
        .checkbox-group .form-check {
            display: flex;
            align-items: flex-start;
            gap: 8px;
            padding-left: 0;
            margin: 0;
            min-height: auto;
        }
        .radio-group .form-check-input,
        .checkbox-group .form-check-input {
            position: static;
            margin: 0.2rem 0 0 0;
            flex-shrink: 0;
        }
        .radio-group .form-check-label,
        .checkbox-group .form-check-label {
            line-height: 1.5;
            padding-left: 0;
        }
        .radio-group .choice-option,
        .checkbox-group .choice-option {
            display: flex;
            flex-direction: column;
            gap: 6px;
        }
        .radio-group .js-choice-other-text,
        .checkbox-group .js-choice-other-text {
            margin-left: 1.6rem;
            max-width: calc(100% - 1.6rem);
        }
        .form-row.form-row-display {
            align-items: flex-start;
        }
        .form-row.form-row-display .form-display-text {
            width: 100%;
            max-width: none;
            color: #2c3e50;
            line-height: 1.6;
            white-space: pre-wrap;
            overflow-wrap: anywhere;
            word-break: break-word;
            padding: 4px 0;
        }
        .required {
            color: #e74c3c;
            margin-left: 3px;
        }
        .form-control {
            border: 2px solid #e9ecef;
            border-radius: 5px;
            /* padding: 10px 15px; */
            font-size: 0.95rem;
            transition: border-color 0.3s ease;
        }
        .form-control:focus {
            border-color: #3498db;
            box-shadow: 0 0 0 0.2rem rgba(52, 152, 219, 0.25);
        }
        .form-control[readonly],
        .form-control:disabled,
        select.form-control:disabled {
            background-color: #eef1f4;
            color: #495057;
            cursor: not-allowed;
            opacity: 1;
        }
        .application-locked-hint {
            font-size: 0.8rem;
            color: #6c757d;
            margin-top: 4px;
        }
        .btn-container {
            text-align: center;
            margin-top: 40px;
            padding-top: 30px;
            border-top: 2px solid #e9ecef;
        }
        .btn {
            padding: 12px 30px;
            font-weight: 500;
            border-radius: 5px;
            margin: 0 10px;
            min-width: 120px;
        }
        .btn-primary {
            background-color: #3498db;
            border-color: #3498db;
        }
        .btn-primary:hover {
            background-color: #2980b9;
            border-color: #2980b9;
        }
        .btn-secondary {
            background-color: #95a5a6;
            border-color: #95a5a6;
        }
        .btn-secondary:hover {
            background-color: #7f8c8d;
            border-color: #7f8c8d;
        }
        .alert {
            border-radius: 5px;
            margin-top: 20px;
        }
        .terms-header {
            display: flex;
            align-items: baseline;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 16px;
        }
        .terms-header .section-title {
            margin-bottom: 0;
        }
        .terms-open-link {
            font-size: 1rem;
            font-weight: 500;
            color: #3498db;
            text-decoration: underline;
            cursor: pointer;
        }
        .terms-open-link:hover {
            color: #2980b9;
        }
        .terms-title-as-link {
            cursor: pointer;
        }
        .terms-title-as-link:hover {
            color: #3498db;
        }
        .terms-agree-row.form-check {
            display: flex;
            align-items: flex-start;
            gap: 0.5rem;
            text-align: left;
            padding-left: 0 !important;
            margin-left: 0;
            margin-bottom: 0;
        }
        .terms-agree-row .form-check-input {
            position: static;
            margin-left: 0;
            margin-top: 0.2rem;
            flex-shrink: 0;
        }
        .terms-agree-row .form-check-label {
            padding-left: 0;
            margin-left: 0;
            line-height: 1.5;
        }
        .terms-agree-row .form-check-label a {
            color: #3498db;
            text-decoration: underline;
            word-break: break-all;
        }
        .terms-agree-row .form-check-label a:hover {
            color: #2980b9;
        }
        .terms-overlay {
            display: none;
            position: fixed;
            inset: 0;
            z-index: 2000;
            background: rgba(0, 0, 0, 0.55);
            align-items: center;
            justify-content: center;
            padding: 20px;
        }
        .terms-overlay.is-open {
            display: flex;
        }
        .terms-modal {
            background: #fff;
            width: 100%;
            max-width: 720px;
            max-height: 85vh;
            border-radius: 10px;
            box-shadow: 0 12px 40px rgba(0, 0, 0, 0.25);
            display: flex;
            flex-direction: column;
            overflow: hidden;
        }
        .terms-modal-header {
            display: flex;
            align-items: center;
            justify-content: space-between;
            padding: 16px 20px;
            border-bottom: 1px solid #e9ecef;
        }
        .terms-modal-header h4 {
            margin: 0;
            font-size: 1.15rem;
            font-weight: 600;
            color: #2c3e50;
        }
        .terms-modal-close {
            border: none;
            background: transparent;
            font-size: 1.75rem;
            line-height: 1;
            color: #6c757d;
            cursor: pointer;
            padding: 0 4px;
        }
        .terms-modal-close:hover {
            color: #2c3e50;
        }
        .terms-modal-body {
            margin: 16px 20px 20px;
            padding: 16px;
            background: #f8f9fa;
            border: 1px solid #dee2e6;
            border-radius: 8px;
            overflow-y: auto;
            max-height: calc(85vh - 120px);
            color: #2c3e50;
            line-height: 1.6;
        }
        .terms-modal-body p {
            margin-bottom: 0.75rem;
        }
        .terms-modal-body ul,
        .terms-modal-body ol {
            margin-bottom: 0.75rem;
            padding-left: 1.25rem;
        }
        .terms-modal-body a {
            color: #3498db;
            text-decoration: underline;
            word-break: break-all;
        }
        .terms-modal-body a:hover {
            color: #2980b9;
        }
        @media (max-width: 768px) {
            .form-header h1 {
                font-size: 100%;
            }
            /* responsive：按鈕縮小約 30% */
            .btn {
                padding: 8px 20px;
                min-width: 84px;
                font-size: 0.85rem;
                margin: 0 6px;
            }
        }
        .ticket-category-buttons {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
        }
        .ticket-category-btn {
            border: 1px solid #ced4da;
            background: #fff;
            color: #333;
            padding: 8px 14px;
            border-radius: 6px;
            cursor: pointer;
            font-size: 14px;
        }
        .ticket-category-btn.active {
            background: #007bff;
            border-color: #007bff;
            color: #fff;
        }
        .ticket-select-block {
            margin-bottom: 20px;
            padding: 10px 0;
            border-bottom: 1px solid #f1f3f4;
        }
        .ticket-select-block .form-row {
            margin-bottom: 0;
            padding-bottom: 0;
            border-bottom: none;
        }
        .ticket-highlight-row {
            display: none;
            width: 100%;
            margin-top: 8px;
        }
        .ticket-highlight-row.is-visible {
            display: block;
        }
        .ticket-highlight-text {
            width: 100%;
            max-width: none;
            margin: 0;
            padding: 0;
            font-size: 14px;
            line-height: 1.5;
            color: #5a6268;
            white-space: pre-wrap;
        }
        .promo-code-row .form-input {
            display: flex;
            flex-wrap: wrap;
            gap: 8px;
            align-items: center;
        }
        .promo-code-row .form-input .form-control {
            flex: 1 1 180px;
            min-width: 140px;
        }
        .promo-code-row #promoCodeCheckBtn {
            flex: 0 0 auto;
            white-space: nowrap;
        }
        #promoCodeStatus {
            width: 100%;
            margin-top: 6px;
            font-size: 13px;
            line-height: 1.4;
            min-height: 1.2em;
        }
        #promoCodeStatus.is-ok { color: #1e7e34; }
        #promoCodeStatus.is-err { color: #c82333; }
        #promoCodeStatus.is-muted { color: #6c757d; }
    </style>
</head>
<body>
    <div class="container">
        <!-- 輪播 -->
        <div id="carouselExampleCaptions" class="carousel slide" data-ride="carousel">
            <div class="carousel-inner">
                <div class="carousel-item active">
                    <img src="<%= typeof eventBannerSrc !== 'undefined' ? eventBannerSrc : '/exvent/' + event_id + '.jpg' %>" class="d-block w-100" alt="第一張圖片" 
                         onerror="this.onerror=null;this.src='<%= typeof fallbackBannerSrc !== 'undefined' ? fallbackBannerSrc : '/exvent/banner.jpg' %>'">
                    <div class="carousel-caption d-none d-md-block">
                        
                    </div>
                </div>
            </div>
        </div>
        
        <!-- 語言切換 -->
        <% const languageSwitcherEnabled = !formConfig || formConfig.languageSwitcherEnabled !== false; %>
        <% if (languageSwitcherEnabled) { %>
        <div class="language-switcher" style="text-align: right; margin-top: 40px; margin-bottom: 30px;">
            <div class="btn-group" role="group">
                <button type="button" class="btn btn-outline-primary" id="langZhBtn" onclick="switchLanguage('zh')">中文</button>
                <button type="button" class="btn btn-outline-primary" id="langEnBtn" onclick="switchLanguage('en')">English</button>
            </div>
        </div>
        <% } %>

        <%
            const regSubHeader = (formConfig && formConfig.registerSubHeader) ? formConfig.registerSubHeader : { zh: '', en: '' };
            const regSubtitle = (formConfig && formConfig.registerSubtitle) ? formConfig.registerSubtitle : {
                zh: '請填寫以下資料完成活動報名',
                en: 'Please fill in the following information to complete event registration'
            };
            const headerInitLang = (formConfig && formConfig.defaultLanguage) ? formConfig.defaultLanguage : 'zh';
            const initSubHeader = headerInitLang === 'en'
                ? ((regSubHeader.en || regSubHeader.zh || '').trim())
                : ((regSubHeader.zh || regSubHeader.en || '').trim());
            const initSubtitle = headerInitLang === 'en'
                ? (regSubtitle.en || regSubtitle.zh || 'Please fill in the following information to complete event registration')
                : (regSubtitle.zh || regSubtitle.en || '請填寫以下資料完成活動報名');
        %>
        <div class="form-header">
            <br><br>
            <h1 id="formTitle"<%= registerEventTitle ? '' : ' style="display:none;"' %>><%= registerEventTitle %></h1>
            <p id="formSubHeader" class="form-subheader"<%= initSubHeader ? '' : ' style="display:none;"' %>><%= initSubHeader %></p>
            <p class="text-muted" id="formSubtitle"><%= initSubtitle %></p>
        </div>

        <form id="userForm" method="POST" action="#" onsubmit="return false;">
            <% if (isApplicationMode) { %>
            <input type="hidden" name="token" id="applicationTokenField" value="<%= applicationTokenVal %>">
            <% } %>
            <% if (formConfig && formConfig.sections && formConfig.sections.length > 0) { %>
                <% 
                // 根據 order 排序 sections
                const sortedSections = formConfig.sections.slice().sort((a, b) => {
                    const orderA = a.order || 0;
                    const orderB = b.order || 0;
                    return orderA - orderB;
                });
                %>
                <% sortedSections.forEach((section, sectionIndex) => { %>
                    <% if (section.visible) { %>
                        <div class="form-section">
                            <h3 class="section-title" data-zh="<%= section.sectionTitle && section.sectionTitle.zh ? section.sectionTitle.zh : section.sectionTitle %>" data-en="<%= section.sectionTitle && section.sectionTitle.en ? section.sectionTitle.en : '' %>">
                                <%= section.sectionTitle && section.sectionTitle.zh ? section.sectionTitle.zh : (typeof section.sectionTitle === 'string' ? section.sectionTitle : '') %>
                            </h3>
                            
                            <% if (section.fields && section.fields.length > 0) { %>
                                <% 
                                // 根據 order 排序 fields
                                const sortedFields = section.fields.slice().sort((a, b) => {
                                    const orderA = a.order || 0;
                                    const orderB = b.order || 0;
                                    return orderA - orderB;
                                });
                                %>
                                <% sortedFields.forEach((field, fieldIndex) => { %>
                                    <% const fieldDisplayed = (field.visible !== false) && (field.display !== undefined ? field.display : true); %>
                                    <% if (fieldDisplayed) { %>
                                        <% var _selectHasOther = (field.type === 'select' && field.options && field.options.some(function (o) { return o && o.isOther; })); %>
                                        <% var _fieldControlId = (field.type === 'select' && _selectHasOther) ? (field.fieldName + '_sel') : field.fieldName; %>
                                        <% var _isChoiceField = field.type === 'radio' || field.type === 'checkbox'; %>
                                        <% var _isDisplayField = field.type === 'display'; %>
                                        <% if (_isDisplayField) { %>
                                        <div class="form-row form-row-display">
                                            <div class="form-display-text field-display-text"
                                                 data-zh="<%= field.label && field.label.zh ? field.label.zh : (typeof field.label === 'string' ? field.label : '') %>"
                                                 data-en="<%= field.label && field.label.en ? field.label.en : '' %>">
                                                <%= field.label && field.label.zh ? field.label.zh : (typeof field.label === 'string' ? field.label : '') %>
                                            </div>
                                        </div>
                                        <% } else { %>
                                        <div class="form-row form-row-stacked">
                                            <label class="form-label field-label" for="<%= _fieldControlId %>" 
                                                   data-zh="<%= field.label && field.label.zh ? field.label.zh : (typeof field.label === 'string' ? field.label : '') %>" 
                                                   data-en="<%= field.label && field.label.en ? field.label.en : '' %>">
                                                <%= field.label && field.label.zh ? field.label.zh : (typeof field.label === 'string' ? field.label : '') %>
                                                <% if (field.required) { %>
                                                    <span class="required">*</span>
                                                <% } %>
                                            </label>
                                            <div class="form-input">
                                                <!-- Debug: field.type = <%= field.type %>, has options = <%= field.options ? 'yes' : 'no' %> -->
                                                <% var _fieldLocked = appIsLocked(field.fieldName); %>
                                                <% var _fieldVal = appVal(field.fieldName); %>
                                                <% if (field.type === 'select' && field.options) { %>
                                                    <% if (_selectHasOther) { %>
                                                        <select class="form-control js-select-maybe-other" id="<%= field.fieldName %>_sel"
                                                                data-select-other-base="<%= field.fieldName %>"
                                                                <%= _fieldLocked ? 'disabled' : '' %>
                                                                <%= (!_fieldLocked && field.required) ? 'required' : '' %>>
                                                            <option value="" class="select-placeholder" data-zh="--- 請選擇 ---" data-en="--- Please select ---">--- 請選擇 ---</option>
                                                            <% field.options.forEach((option) => { %>
                                                                <option value="<%= option.value %>"
                                                                        data-is-other="<%= option.isOther ? '1' : '' %>"
                                                                        <%= String(_fieldVal) === String(option.value) ? 'selected' : '' %>
                                                                        data-zh="<%= option.label && option.label.zh ? option.label.zh : option.label %>" 
                                                                        data-en="<%= option.label && option.label.en ? option.label.en : '' %>">
                                                                    <%= option.label && option.label.zh ? option.label.zh : (typeof option.label === 'string' ? option.label : '') %>
                                                                </option>
                                                            <% }); %>
                                                        </select>
                                                        <input type="text" class="form-control mt-2 d-none js-select-other-text"
                                                               id="<%= field.fieldName %>_other"
                                                               data-placeholder-zh="請填寫"
                                                               data-placeholder-en="Please specify"
                                                               <%= _fieldLocked ? 'readonly' : '' %>
                                                               autocomplete="off">
                                                        <input type="hidden" name="<%= field.fieldName %>" id="<%= field.fieldName %>_hidden" value="<%= _fieldLocked ? appValStr(field.fieldName) : '' %>">
                                                    <% } else { %>
                                                        <select class="form-control" id="<%= field.fieldName %>" name="<%= field.fieldName %>"
                                                                <%= _fieldLocked ? 'disabled' : '' %>
                                                                <%= (!_fieldLocked && field.required) ? 'required' : '' %>>
                                                            <option value="" class="select-placeholder" data-zh="--- 請選擇 ---" data-en="--- Please select ---">--- 請選擇 ---</option>
                                                            <% field.options.forEach((option) => { %>
                                                                <option value="<%= option.value %>"
                                                                        <%= String(_fieldVal) === String(option.value) ? 'selected' : '' %>
                                                                        data-zh="<%= option.label && option.label.zh ? option.label.zh : option.label %>" 
                                                                        data-en="<%= option.label && option.label.en ? option.label.en : '' %>">
                                                                    <%= option.label && option.label.zh ? option.label.zh : (typeof option.label === 'string' ? option.label : '') %>
                                                                </option>
                                                            <% }); %>
                                                        </select>
                                                        <% if (_fieldLocked) { %>
                                                        <input type="hidden" name="<%= field.fieldName %>" value="<%= appValStr(field.fieldName) %>">
                                                        <% } %>
                                                    <% } %>
                                                    <% if (_fieldLocked) { %><div class="application-locked-hint" data-zh="已有資料，不可修改" data-en="Data cannot be changed">已有資料，不可修改</div><% } %>
                                                <% } else if (field.type === 'checkbox' && field.options) { %>
                                                    <div class="checkbox-group" id="<%= field.fieldName %>-group">
                                                        <% field.options.forEach((option, optionIndex) => { %>
                                                            <% var _cbChecked = appCheckboxChecked(field.fieldName, option.value, !!option.isOther, field.options); %>
                                                            <% var _otherText = appOtherTextValue(field.fieldName, option.value, !!option.isOther, field.options); %>
                                                            <div class="choice-option">
                                                                <div class="form-check">
                                                                    <input class="form-check-input<%= option.isOther ? ' js-checkbox-other' : '' %>" type="checkbox"
                                                                           id="<%= field.fieldName %>_<%= optionIndex %>"
                                                                           name="<%= field.fieldName %>[]"
                                                                           value="<%= option.value %>"
                                                                           <% if (option.isOther) { %>data-other-input="<%= field.fieldName %>_<%= optionIndex %>_other"<% } %>
                                                                           data-zh="<%= option.label && option.label.zh ? option.label.zh : option.label %>"
                                                                           data-en="<%= option.label && option.label.en ? option.label.en : '' %>"
                                                                           <%= _cbChecked ? 'checked' : '' %>
                                                                           <%= _fieldLocked ? 'disabled' : '' %>
                                                                           <%= (!_fieldLocked && field.required) ? 'data-required="true"' : '' %>>
                                                                    <label class="form-check-label" for="<%= field.fieldName %>_<%= optionIndex %>"
                                                                           data-zh="<%= option.label && option.label.zh ? option.label.zh : (typeof option.label === 'string' ? option.label : '') %>"
                                                                           data-en="<%= option.label && option.label.en ? option.label.en : '' %>">
                                                                        <%= option.label && option.label.zh ? option.label.zh : (typeof option.label === 'string' ? option.label : '') %>
                                                                    </label>
                                                                </div>
                                                                <% if (option.isOther) { %>
                                                                <input type="text" class="form-control js-choice-other-text<%= _cbChecked ? '' : ' d-none' %>"
                                                                       id="<%= field.fieldName %>_<%= optionIndex %>_other"
                                                                       data-placeholder-zh="請填寫"
                                                                       data-placeholder-en="Please specify"
                                                                       value="<%= _otherText %>"
                                                                       <%= _fieldLocked ? 'readonly' : '' %>
                                                                       <%= (_cbChecked && !_fieldLocked) ? 'required' : '' %>
                                                                       autocomplete="off">
                                                                <% } %>
                                                            </div>
                                                        <% }); %>
                                                    </div>
                                                    <% if (_fieldLocked) { %><div class="application-locked-hint" data-zh="已有資料，不可修改" data-en="Data cannot be changed">已有資料，不可修改</div><% } %>
                                                    <% if (field.required && !_fieldLocked) { %>
                                                        <script>
                                                            // 驗證至少選擇一個 checkbox（勿對 div 呼叫 setCustomValidity，否則會 throw 導致 form 原生 POST）
                                                            (function() {
                                                                const checkboxes = document.querySelectorAll('#<%= field.fieldName %>-group input[type="checkbox"]');
                                                                const group = document.getElementById('<%= field.fieldName %>-group');
                                                                const fieldLabelZh = '<%= field.label && field.label.zh ? field.label.zh : (typeof field.label === "string" ? field.label : "") %>';
                                                                const fieldLabelEn = '<%= field.label && field.label.en ? field.label.en : "" %>';
                                                                let invalid = false;

                                                                function validateCheckboxGroup() {
                                                                    invalid = !Array.from(checkboxes).some(cb => cb.checked);
                                                                    return !invalid;
                                                                }

                                                                checkboxes.forEach(cb => {
                                                                    cb.addEventListener('change', validateCheckboxGroup);
                                                                });

                                                                const form = document.getElementById('userForm');
                                                                if (form) {
                                                                    form.addEventListener('submit', function(e) {
                                                                        if (!validateCheckboxGroup()) {
                                                                            e.preventDefault();
                                                                            e.stopPropagation();
                                                                            const currentLang = typeof currentLanguage !== 'undefined' ? currentLanguage : 'zh';
                                                                            const msg = (currentLang === 'en' && fieldLabelEn)
                                                                                ? ('Please select at least one option for ' + fieldLabelEn + '.')
                                                                                : (fieldLabelZh + ' 為必填欄位');
                                                                            if (group && typeof group.focus === 'function') {
                                                                                try { group.scrollIntoView({ block: 'center' }); } catch (_) {}
                                                                            }
                                                                            alert(msg);
                                                                        }
                                                                    });
                                                                }
                                                            })();
                                                        </script>
                                                    <% } %>
                                                <% } else if (field.type === 'radio' && field.options) { %>
                                                    <div class="radio-group" id="<%= field.fieldName %>-group">
                                                        <% field.options.forEach((option, optionIndex) => { %>
                                                            <% var _radioChecked = appRadioChecked(field.fieldName, option.value, !!option.isOther, field.options); %>
                                                            <% var _radioOtherText = appOtherTextValue(field.fieldName, option.value, !!option.isOther, field.options); %>
                                                            <div class="choice-option">
                                                                <div class="form-check">
                                                                    <input class="form-check-input<%= option.isOther ? ' js-radio-other' : '' %>" type="radio"
                                                                           id="<%= field.fieldName %>_<%= optionIndex %>"
                                                                           name="<%= field.fieldName %>"
                                                                           value="<%= option.value %>"
                                                                           <% if (option.isOther) { %>data-other-input="<%= field.fieldName %>_<%= optionIndex %>_other"<% } %>
                                                                           data-zh="<%= option.label && option.label.zh ? option.label.zh : option.label %>"
                                                                           data-en="<%= option.label && option.label.en ? option.label.en : '' %>"
                                                                           <%= _radioChecked ? 'checked' : '' %>
                                                                           <%= _fieldLocked ? 'disabled' : '' %>
                                                                           <%= (!_fieldLocked && field.required) ? 'required' : '' %>>
                                                                    <label class="form-check-label" for="<%= field.fieldName %>_<%= optionIndex %>"
                                                                           data-zh="<%= option.label && option.label.zh ? option.label.zh : (typeof option.label === 'string' ? option.label : '') %>"
                                                                           data-en="<%= option.label && option.label.en ? option.label.en : '' %>">
                                                                        <%= option.label && option.label.zh ? option.label.zh : (typeof option.label === 'string' ? option.label : '') %>
                                                                    </label>
                                                                </div>
                                                                <% if (option.isOther) { %>
                                                                <input type="text" class="form-control js-choice-other-text<%= _radioChecked ? '' : ' d-none' %>"
                                                                       id="<%= field.fieldName %>_<%= optionIndex %>_other"
                                                                       data-placeholder-zh="請填寫"
                                                                       data-placeholder-en="Please specify"
                                                                       value="<%= _radioOtherText %>"
                                                                       <%= _fieldLocked ? 'readonly' : '' %>
                                                                       <%= (_radioChecked && !_fieldLocked) ? 'required' : '' %>
                                                                       autocomplete="off">
                                                                <% } %>
                                                            </div>
                                                        <% }); %>
                                                    </div>
                                                    <% if (_fieldLocked) { %>
                                                    <input type="hidden" name="<%= field.fieldName %>" value="<%= appValStr(field.fieldName) %>">
                                                    <div class="application-locked-hint" data-zh="已有資料，不可修改" data-en="Data cannot be changed">已有資料，不可修改</div>
                                                    <% } %>
                                                <% } else if (field.type === 'textarea') { %>
                                                    <textarea class="form-control" id="<%= field.fieldName %>" name="<%= field.fieldName %>" 
                                                              placeholder="<%= field.placeholder && field.placeholder.zh ? field.placeholder.zh : (typeof field.placeholder === 'string' ? field.placeholder : '') %>" 
                                                              data-placeholder-zh="<%= field.placeholder && field.placeholder.zh ? field.placeholder.zh : '' %>" 
                                                              data-placeholder-en="<%= field.placeholder && field.placeholder.en ? field.placeholder.en : '' %>" 
                                                              <%= _fieldLocked ? 'readonly' : '' %>
                                                              <%= (!_fieldLocked && field.required) ? 'required' : '' %> rows="3"><%= _fieldLocked || isApplicationMode ? appValStr(field.fieldName) : '' %></textarea>
                                                    <% if (_fieldLocked) { %><div class="application-locked-hint" data-zh="已有資料，不可修改" data-en="Data cannot be changed">已有資料，不可修改</div><% } %>
                                                <% } else { %>
                                                    <input type="<%= field.type %>" class="form-control" id="<%= field.fieldName %>" name="<%= field.fieldName %>" 
                                                           placeholder="<%= field.placeholder && field.placeholder.zh ? field.placeholder.zh : (typeof field.placeholder === 'string' ? field.placeholder : '') %>" 
                                                           data-placeholder-zh="<%= field.placeholder && field.placeholder.zh ? field.placeholder.zh : '' %>" 
                                                           data-placeholder-en="<%= field.placeholder && field.placeholder.en ? field.placeholder.en : '' %>" 
                                                           value="<%= isApplicationMode ? appValStr(field.fieldName) : '' %>"
                                                           <%= _fieldLocked ? 'readonly' : '' %>
                                                           <%= (!_fieldLocked && field.required) ? 'required' : '' %>>
                                                    <% if (_fieldLocked) { %><div class="application-locked-hint" data-zh="已有資料，不可修改" data-en="Data cannot be changed">已有資料，不可修改</div><% } %>
                                                <% } %>
                                            </div>
                                        </div>
                                        <% if (field.type === 'email' && field.confirmEmail && !_fieldLocked) { %>
                                        <div class="form-row form-row-stacked email-confirm-row" data-email-field="<%= field.fieldName %>">
                                            <label class="form-label field-label" for="<%= field.fieldName %>_confirm"
                                                   data-zh="確認電子郵件"
                                                   data-en="Confirm Email">
                                                確認電子郵件
                                                <% if (field.required) { %>
                                                    <span class="required">*</span>
                                                <% } %>
                                            </label>
                                            <div class="form-input">
                                                <input type="email" class="form-control js-email-confirm"
                                                       id="<%= field.fieldName %>_confirm"
                                                       data-confirm-for="<%= field.fieldName %>"
                                                       placeholder="<%= field.placeholder && field.placeholder.zh ? field.placeholder.zh : (typeof field.placeholder === 'string' ? field.placeholder : '') %>"
                                                       data-placeholder-zh="<%= field.placeholder && field.placeholder.zh ? field.placeholder.zh : '' %>"
                                                       data-placeholder-en="<%= field.placeholder && field.placeholder.en ? field.placeholder.en : '' %>"
                                                       autocomplete="off"
                                                       <%= field.required ? 'required' : '' %>>
                                            </div>
                                        </div>
                                        <% } %>
                                        <% } %>
                                    <% } %>
                                <% }); %>
                            <% } %>
                        </div>
                    <% } %>
                <% }); %>
            <% } else { %>
                <!-- 預設表單結構（如果沒有配置） -->
                <div class="form-section">
                    <h3>聯絡人資料</h3>

                    <!-- 預設表單字段將在這裡顯示（如果沒有動態配置） -->
                    <div class="form-row">
                        <label class="form-label" for="email">
                            電子郵件 <span class="required">*</span>
                        </label>
                        <div class="form-input">
                            <input type="email" class="form-control" id="email" name="email" 
                                   placeholder="例如：peterwong@abccompany.com" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <label class="form-label" for="name">
                            姓名 <span class="required">*</span>
                        </label>
                        <div class="form-input">
                            <input type="text" class="form-control" id="name" name="name" 
                                   placeholder="例如：王小明" required>
                        </div>
                    </div>

                    <div class="form-row">
                        <label class="form-label" for="company">
                            公司名稱 <span class="required">*</span>
                        </label>
                        <div class="form-input">
                            <input type="text" class="form-control" id="company" name="company" 
                                   placeholder="例如：ABC 公司" required>
                        </div>
                    </div>
                </div>
            <% } %>

            <!-- 票券選擇（如果適用；專屬 Application 不顯示） -->
            <% if (!isApplicationMode && paymentTickets && paymentTickets.length > 0) {
                const ptUi = (formConfig && formConfig.paymentTicketUi) ? formConfig.paymentTicketUi : {};
                const ptSectionZh = (ptUi.sectionTitle && ptUi.sectionTitle.zh) ? ptUi.sectionTitle.zh : '票券選擇';
                const ptSectionEn = (ptUi.sectionTitle && ptUi.sectionTitle.en) ? ptUi.sectionTitle.en : 'Ticket Selection';
                const ptCatLabelZh = (ptUi.categoryLabel && ptUi.categoryLabel.zh) ? ptUi.categoryLabel.zh : '選擇類別';
                const ptCatLabelEn = (ptUi.categoryLabel && ptUi.categoryLabel.en) ? ptUi.categoryLabel.en : 'Select Category';
                const ptTicketLabelZh = (ptUi.ticketLabel && ptUi.ticketLabel.zh) ? ptUi.ticketLabel.zh : '選擇票券';
                const ptTicketLabelEn = (ptUi.ticketLabel && ptUi.ticketLabel.en) ? ptUi.ticketLabel.en : 'Select Ticket';
            %>
                <div class="form-section" id="paymentTicketSection">
                    <h3 class="section-title lang-text" id="ticketSectionTitle"
                        data-zh="<%= ptSectionZh %>" data-en="<%= ptSectionEn %>"><%= ptSectionZh %></h3>

                    <% if (ticketsUseCategories) { %>
                    <div class="form-row" id="ticketCategoryRow">
                        <label class="form-label field-label lang-text" id="ticketCategoryLabel"
                               data-zh="<%= ptCatLabelZh %>" data-en="<%= ptCatLabelEn %>">
                            <%= ptCatLabelZh %> <span class="required">*</span>
                        </label>
                        <div class="form-input">
                            <div id="ticketCategoryButtons" class="ticket-category-buttons" role="group"></div>
                            <input type="hidden" id="ticketCategory" name="ticketCategory" value="">
                        </div>
                    </div>
                    <% } %>

                    <div class="ticket-select-block" id="ticketSelectBlock" <%= ticketsUseCategories ? 'style="display:none;"' : '' %>>
                        <div class="form-row" id="ticketSelectRow">
                            <label class="form-label field-label lang-text" for="ticketId" id="ticketSelectLabel"
                                   data-zh="<%= ptTicketLabelZh %>" data-en="<%= ptTicketLabelEn %>">
                                <%= ptTicketLabelZh %> <span class="required">*</span>
                            </label>
                            <div class="form-input">
                                <select class="form-control" id="ticketId" name="ticketId" <%= ticketsUseCategories ? '' : 'required' %>>
                                    <option value="" class="lang-text" data-zh="--- 請選擇票券 ---" data-en="--- Please select a ticket ---">--- 請選擇票券 ---</option>
                                </select>
                            </div>
                        </div>
                        <div id="ticketHighlightRow" class="ticket-highlight-row" aria-live="polite">
                            <div id="ticketHighlightText" class="ticket-highlight-text"></div>
                        </div>
                    </div>

                    <div class="form-row mt-3 promo-code-row" id="promoCodeRow">
                        <label class="form-label field-label" for="eventPromoCode"
                               data-zh="折扣碼（可選）" data-en="Promocode (optional)">折扣碼（可選）</label>
                        <div class="form-input">
                            <input type="text" id="eventPromoCode" name="promoCode" class="form-control"
                                   placeholder="折扣碼（可選）"
                                   data-placeholder-zh="折扣碼（可選）"
                                   data-placeholder-en="Enter promocode (optional)"
                                   autocomplete="off"
                                   autocapitalize="characters"
                                   spellcheck="false"
                                   data-lpignore="true"
                                   data-1p-ignore="true"
                                   data-form-type="other">
                            <button type="button" class="btn btn-outline-primary lang-text" id="promoCodeCheckBtn"
                                    data-zh="檢查" data-en="Check">檢查</button>
                            <div id="promoCodeStatus" class="is-muted" aria-live="polite"></div>
                        </div>
                    </div>
                </div>
                <script type="application/json" id="paymentTicketsDataJson"><%- JSON.stringify(paymentTickets) %></script>
                <script type="application/json" id="paymentTicketUiJson"><%- JSON.stringify(ptUi) %></script>
                <script type="application/json" id="ticketsUseCategoriesJson"><%- JSON.stringify(!!ticketsUseCategories) %></script>
            <% } %>

            <!-- Terms & Conditions（需同意才可提交） -->
            <% if (formConfig && formConfig.terms && formConfig.terms.enabled) { %>
                <% const trm = formConfig.terms; %>
                <% const trmTitle = trm.title || {}; %>
                <% const trmLink = trm.linkLabel || {}; %>
                <% const showTrmLink = trm.showLinkLabel !== false; %>
                <div class="form-section terms-section">
                    <div class="terms-header">
                        <h3 class="section-title<%= showTrmLink ? '' : ' terms-title-as-link js-terms-modal-opener' %>" id="termsSectionTitle"
                            data-zh="<%= (trmTitle.zh ? trmTitle.zh : '條款與細則') %>"
                            data-en="<%= (trmTitle.en ? trmTitle.en : 'Terms & Conditions') %>"
                            data-required-mark="1"><%= (trmTitle.zh ? trmTitle.zh : '條款與細則') %><span class="required">*</span></h3>
                        <% if (showTrmLink) { %>
                        <a href="#" class="terms-open-link lang-text" id="termsOpenLink" role="button"
                           data-zh="<%= (trmLink.zh ? trmLink.zh : '(條款)') %>"
                           data-en="<%= (trmLink.en ? trmLink.en : '(terms)') %>"><%= (trmLink.zh ? trmLink.zh : '(條款)') %></a>
                        <% } %>
                    </div>
                    <div class="form-check terms-agree-row">
                        <input class="form-check-input" type="checkbox" id="termsAgree" required>
                        <label class="form-check-label terms-checkbox-label"
                               for="termsAgree"
                               id="termsAgreeLabel"></label>
                    </div>
                </div>

                <div id="termsOverlay" class="terms-overlay" aria-hidden="true">
                    <div class="terms-modal" role="dialog" aria-modal="true" aria-labelledby="termsModalTitle">
                        <div class="terms-modal-header">
                            <h4 id="termsModalTitle" class="lang-text"
                                data-zh="<%= (trmTitle.zh ? trmTitle.zh : '條款與細則') %>"
                                data-en="<%= (trmTitle.en ? trmTitle.en : 'Terms & Conditions') %>"><%= (trmTitle.zh ? trmTitle.zh : '條款與細則') %></h4>
                            <button type="button" class="terms-modal-close" id="termsModalClose" aria-label="Close">&times;</button>
                        </div>
                        <div class="terms-modal-body" id="termsContent"></div>
                    </div>
                </div>
                <script type="application/json" id="termsLabelJson"><%- JSON.stringify({
                    zh: (trm.label && trm.label.zh) ? trm.label.zh : '',
                    en: (trm.label && trm.label.en) ? trm.label.en : ''
                }) %></script>
                <script type="application/json" id="termsContentJson"><%- JSON.stringify({
                    zh: (trm.content && trm.content.zh) ? trm.content.zh : '',
                    en: (trm.content && trm.content.en) ? trm.content.en : ''
                }) %></script>
            <% } %>

            <!-- Agreement（可多份；共用一個頂部標題） -->
            <%
                const _agreementsAll = (formConfig && Array.isArray(formConfig.agreements) && formConfig.agreements.length)
                    ? formConfig.agreements
                    : (formConfig && formConfig.agreement ? [formConfig.agreement] : []);
                const _agreementsEnabled = _agreementsAll
                    .map(function(agr, agrIndex) { return { agr: agr, agrIndex: agrIndex }; })
                    .filter(function(x) { return x.agr && x.agr.enabled; });
                const _agrSharedTitle = (_agreementsAll[0] && _agreementsAll[0].title) ? _agreementsAll[0].title : {};
            %>
            <% if (_agreementsEnabled.length) { %>
                <div class="form-section agreement-section">
                    <h3 class="section-title" id="agreementSectionTitle"
                        data-zh="<%= (_agrSharedTitle.zh ? _agrSharedTitle.zh : '協議') %>"
                        data-en="<%= (_agrSharedTitle.en ? _agrSharedTitle.en : 'Agreement') %>"><%= (_agrSharedTitle.zh ? _agrSharedTitle.zh : '協議') %></h3>
                    <% _agreementsEnabled.forEach(function(entry) { %>
                        <% const agr = entry.agr; %>
                        <% const agrIndex = entry.agrIndex; %>
                        <% const agrTitle = agr.title || _agrSharedTitle || {}; %>
                        <% const agrLink = agr.linkLabel || {}; %>
                        <% const showAgrLink = agr.showLinkLabel !== false; %>
                        <% const agrId = agrIndex === 0 ? '' : ('_' + (agrIndex + 1)); %>
                        <% const agrAgreedName = agrIndex === 0 ? 'agreementAgreed' : ('agreementAgreed_' + (agrIndex + 1)); %>
                        <% const agrRecordedName = agrIndex === 0 ? 'agreementRecordedAt' : ('agreementRecordedAt_' + (agrIndex + 1)); %>
                        <div class="agreement-item mb-3">
                            <% if (showAgrLink) { %>
                            <div class="terms-header">
                                <a href="#" class="terms-open-link lang-text" id="agreementOpenLink<%= agrId %>" role="button"
                                   data-zh="<%= (agrLink.zh ? agrLink.zh : '(協議)') %>"
                                   data-en="<%= (agrLink.en ? agrLink.en : '(agreement)') %>"><%= (agrLink.zh ? agrLink.zh : '(協議)') %></a>
                            </div>
                            <% } %>
                            <div class="form-check terms-agree-row">
                                <input class="form-check-input js-agreement-agree" type="checkbox"
                                       id="agreementAgree<%= agrId %>"
                                       name="<%= agrAgreedName %>"
                                       data-recorded-at-name="<%= agrRecordedName %>"
                                       value="true">
                                <label class="form-check-label agreement-checkbox-label js-agreement-label"
                                       id="agreementAgreeLabel<%= agrId %>"
                                       data-checkbox-id="agreementAgree<%= agrId %>"></label>
                            </div>
                        </div>

                        <div id="agreementOverlay<%= agrId %>" class="terms-overlay" aria-hidden="true">
                            <div class="terms-modal" role="dialog" aria-modal="true" aria-labelledby="agreementModalTitle<%= agrId %>">
                                <div class="terms-modal-header">
                                    <h4 id="agreementModalTitle<%= agrId %>" class="lang-text"
                                        data-zh="<%= (agrTitle.zh || _agrSharedTitle.zh || '協議') %>"
                                        data-en="<%= (agrTitle.en || _agrSharedTitle.en || 'Agreement') %>"><%= (agrTitle.zh || _agrSharedTitle.zh || '協議') %></h4>
                                    <button type="button" class="terms-modal-close" id="agreementModalClose<%= agrId %>" aria-label="Close">&times;</button>
                                </div>
                                <div class="terms-modal-body js-agreement-content" id="agreementContent<%= agrId %>"></div>
                            </div>
                        </div>
                        <script type="application/json" class="js-agreement-label-json" data-target="agreementAgreeLabel<%= agrId %>"><%- JSON.stringify({
                            zh: (agr.label && agr.label.zh) ? agr.label.zh : '',
                            en: (agr.label && agr.label.en) ? agr.label.en : ''
                        }) %></script>
                        <script type="application/json" class="js-agreement-content-json" data-target="agreementContent<%= agrId %>"><%- JSON.stringify({
                            zh: (agr.content && agr.content.zh) ? agr.content.zh : '',
                            en: (agr.content && agr.content.en) ? agr.content.en : ''
                        }) %></script>
                    <% }); %>
                </div>
            <% } %>

            <!-- Thank You Yes/No 問題 -->
            <% if (formConfig && formConfig.thankYou && formConfig.thankYou.yesNoQuestion && formConfig.thankYou.yesNoQuestion.enabled) { %>
                <% const ynq = formConfig.thankYou.yesNoQuestion; %>
                <div class="form-section thankyou-yesno-section">
                    <h3 class="section-title"
                        data-zh="<%= (ynq.question && ynq.question.zh) ? ynq.question.zh : '請選擇' %>"
                        data-en="<%= (ynq.question && ynq.question.en) ? ynq.question.en : 'Please choose' %>">
                        <%= (ynq.question && ynq.question.zh) ? ynq.question.zh : '請選擇' %>
                    </h3>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="thankYouYesNo" id="thankYouYesNoYes" value="yes" required>
                        <label class="form-check-label field-label" for="thankYouYesNoYes"
                               data-zh="<%= (ynq.yesLabel && ynq.yesLabel.zh) ? ynq.yesLabel.zh : '是' %>"
                               data-en="<%= (ynq.yesLabel && ynq.yesLabel.en) ? ynq.yesLabel.en : 'Yes' %>">
                            <%= (ynq.yesLabel && ynq.yesLabel.zh) ? ynq.yesLabel.zh : '是' %>
                        </label>
                    </div>
                    <div class="form-check">
                        <input class="form-check-input" type="radio" name="thankYouYesNo" id="thankYouYesNoNo" value="no" required>
                        <label class="form-check-label field-label" for="thankYouYesNoNo"
                               data-zh="<%= (ynq.noLabel && ynq.noLabel.zh) ? ynq.noLabel.zh : '否' %>"
                               data-en="<%= (ynq.noLabel && ynq.noLabel.en) ? ynq.noLabel.en : 'No' %>">
                            <%= (ynq.noLabel && ynq.noLabel.zh) ? ynq.noLabel.zh : '否' %>
                        </label>
                    </div>
                </div>
            <% } %>

            <div class="btn-container">
                <% const regBtnUi = (formConfig && formConfig.paymentTicketUi && formConfig.paymentTicketUi.buttons) ? formConfig.paymentTicketUi.buttons : {}; %>
                <button type="button" class="btn btn-secondary lang-text" id="registerBackBtn"
                        data-zh="<%= (regBtnUi.back && regBtnUi.back.zh) ? regBtnUi.back.zh : '返回' %>"
                        data-en="<%= (regBtnUi.back && regBtnUi.back.en) ? regBtnUi.back.en : 'Back' %>"
                        onclick="history.back()"><%= (regBtnUi.back && regBtnUi.back.zh) ? regBtnUi.back.zh : '返回' %></button>
                <button type="submit" class="btn btn-primary lang-text" id="registerNextBtn"
                        data-zh="<%= (regBtnUi.next && regBtnUi.next.zh) ? regBtnUi.next.zh : '提交' %>"
                        data-en="<%= (regBtnUi.next && regBtnUi.next.en) ? regBtnUi.next.en : 'Submit' %>"><%= (regBtnUi.next && regBtnUi.next.zh) ? regBtnUi.next.zh : '提交' %></button>
            </div>
        </form>
        
        <div id="successMessage"></div>
        <div id="errorMessage"></div>
    </div>

    <script src="https://code.jquery.com/jquery-3.5.1.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.9.2/dist/umd/popper.min.js"></script>
    <script src="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/js/bootstrap.min.js"></script>
    <script>
        // 從 URL 參數獲取語言
        function getLanguageFromURL() {
            const urlParams = new URLSearchParams(window.location.search);
            const lang = urlParams.get('lang');
            // 如果 URL 中有 lang 參數，且為 'zh' 或 'en'，則使用該語言
            if (lang === 'zh' || lang === 'en') {
                return lang;
            }
            return null;
        }
        
        // 語言設置：優先使用 URL 參數，否則使用默認語言
        const languageSwitcherEnabled = <%- JSON.stringify(!formConfig || formConfig.languageSwitcherEnabled !== false) %>;
        const urlLanguage = languageSwitcherEnabled ? getLanguageFromURL() : null;
        let currentLanguage = urlLanguage || '<%= formConfig.defaultLanguage || "zh" %>';
        const formConfigEventName = <%- JSON.stringify(formConfig && formConfig.eventDisplayName ? formConfig.eventDisplayName : { zh: '', en: '' }) %>;
        const formConfigRegisterSubHeader = <%- JSON.stringify(formConfig && formConfig.registerSubHeader ? formConfig.registerSubHeader : { zh: '', en: '' }) %>;
        const formConfigRegisterSubtitle = <%- JSON.stringify(formConfig && formConfig.registerSubtitle ? formConfig.registerSubtitle : { zh: '請填寫以下資料完成活動報名', en: 'Please fill in the following information to complete event registration' }) %>;
        const fallbackEventName = <%- JSON.stringify(event && event.name ? event.name : 'Event') %>;
        function getBilingualFormText(obj, lang, fallbackZh, fallbackEn) {
            const zh = (obj && obj.zh) ? String(obj.zh).trim() : '';
            const en = (obj && obj.en) ? String(obj.en).trim() : '';
            if (lang === 'en') return en || zh || fallbackEn || fallbackZh || '';
            return zh || en || fallbackZh || fallbackEn || '';
        }
        function getHeaderEventName(lang) {
            // 留空 = 不顯示 H1（唔再 fallback 到 event.name）
            return getBilingualFormText(formConfigEventName, lang, '', '');
        }
        function getRegisterSubHeader(lang) {
            return getBilingualFormText(formConfigRegisterSubHeader, lang, '', '');
        }
        function getRegisterSubtitle(lang) {
            return getBilingualFormText(
                formConfigRegisterSubtitle,
                lang,
                '請填寫以下資料完成活動報名',
                'Please fill in the following information to complete event registration'
            );
        }
        function updateRegisterHeaderText() {
            var name = getHeaderEventName(currentLanguage);
            if (name) {
                $('#formTitle').text(name).show();
            } else {
                $('#formTitle').hide().empty();
            }
            // 瀏覽器 tab 標題：無自訂名稱時仍用 event.name，避免空白 tab
            document.title = (name || fallbackEventName) + (currentLanguage === 'en' ? ' - Register' : ' - 登記');
            const sub = getRegisterSubHeader(currentLanguage);
            if (sub) {
                $('#formSubHeader').text(sub).show();
            } else {
                $('#formSubHeader').hide().empty();
            }
            $('#formSubtitle').text(getRegisterSubtitle(currentLanguage));
        }
        const termsContentByLang = (function() {
            const el = document.getElementById('termsContentJson');
            if (!el) return { zh: '', en: '' };
            try { return JSON.parse(el.textContent); } catch (_) { return { zh: '', en: '' }; }
        })();
        const termsLabelByLang = (function() {
            const el = document.getElementById('termsLabelJson');
            if (!el) return { zh: '', en: '' };
            try { return JSON.parse(el.textContent); } catch (_) { return { zh: '', en: '' }; }
        })();

        // --- 付費票券：分類按鈕、票券下拉、Highlight ---
        const paymentTicketsData = (function() {
            const el = document.getElementById('paymentTicketsDataJson');
            if (!el) return [];
            try { return JSON.parse(el.textContent); } catch (_) { return []; }
        })();
        const paymentTicketUi = (function() {
            const el = document.getElementById('paymentTicketUiJson');
            if (!el) return {};
            try { return JSON.parse(el.textContent); } catch (_) { return {}; }
        })();
        const ticketsUseCategories = (function() {
            const el = document.getElementById('ticketsUseCategoriesJson');
            if (!el) return false;
            try { return !!JSON.parse(el.textContent); } catch (_) { return false; }
        })();
        let selectedTicketCategory = '';
        let validatedPromoCode = '';

        function setPromoCodeStatus(text, kind) {
            const $st = $('#promoCodeStatus');
            if (!$st.length) return;
            $st.removeClass('is-ok is-err is-muted')
                .addClass(kind === 'ok' ? 'is-ok' : (kind === 'err' ? 'is-err' : 'is-muted'))
                .text(text || '');
        }

        function clearPromoValidation(keepMessage) {
            validatedPromoCode = '';
            if (!keepMessage) setPromoCodeStatus('', 'muted');
        }

        function getEnteredPromoCode() {
            return String($('#eventPromoCode').val() || '').trim().toUpperCase();
        }

        function checkPromoCode() {
            const code = getEnteredPromoCode();
            if (!code) {
                clearPromoValidation();
                setPromoCodeStatus(
                    currentLanguage === 'en' ? 'Please enter a promocode first.' : '請先輸入折扣碼。',
                    'err'
                );
                return;
            }
            const $btn = $('#promoCodeCheckBtn');
            $btn.prop('disabled', true);
            setPromoCodeStatus(
                currentLanguage === 'en' ? 'Checking…' : '檢查中…',
                'muted'
            );
            $.ajax({
                type: 'POST',
                url: '/web/<%= event_id %>/promo-code/validate',
                contentType: 'application/json',
                data: JSON.stringify({
                    promoCode: code,
                    ticketId: $('#ticketId').val() || '',
                    lang: currentLanguage
                }),
                success: function(res) {
                    if (res && res.valid) {
                        validatedPromoCode = res.code || code;
                        setPromoCodeStatus(res.message || (currentLanguage === 'en' ? 'Promocode valid.' : '折扣碼有效。'), 'ok');
                    } else {
                        clearPromoValidation(true);
                        setPromoCodeStatus(
                            (res && res.message) || (currentLanguage === 'en' ? 'Invalid promocode.' : '無效折扣碼。'),
                            'err'
                        );
                    }
                },
                error: function(xhr) {
                    clearPromoValidation(true);
                    const msg = (xhr.responseJSON && xhr.responseJSON.message)
                        ? xhr.responseJSON.message
                        : (currentLanguage === 'en' ? 'Failed to validate promocode.' : '檢查折扣碼失敗。');
                    setPromoCodeStatus(msg, 'err');
                },
                complete: function() {
                    $btn.prop('disabled', false);
                }
            });
        }

        $(document).on('click', '#promoCodeCheckBtn', function(e) {
            e.preventDefault();
            checkPromoCode();
        });
        $(document).on('input change', '#eventPromoCode', function() {
            if (validatedPromoCode && getEnteredPromoCode() !== validatedPromoCode) {
                clearPromoValidation();
                setPromoCodeStatus(
                    currentLanguage === 'en' ? 'Promocode changed — please check again.' : '折扣碼已更改，請重新檢查。',
                    'muted'
                );
            } else if (!getEnteredPromoCode()) {
                clearPromoValidation();
            }
        });
        $(document).on('change', '#ticketId', function() {
            if (validatedPromoCode) {
                // 票券轉咗，折後價可能唔同，要重新檢查
                clearPromoValidation();
                setPromoCodeStatus(
                    currentLanguage === 'en' ? 'Ticket changed — please check promocode again.' : '票券已更改，請重新檢查折扣碼。',
                    'muted'
                );
            }
        });

        function isTicketInRange(ticket) {
            const now = new Date();
            const from = ticket.datetimeFrom ? new Date(ticket.datetimeFrom) : null;
            const to = ticket.datetimeTo ? new Date(ticket.datetimeTo) : (ticket.datetime ? new Date(ticket.datetime) : null);
            if (from && now < from) return false;
            if (to && now > to) return false;
            return true;
        }

        function getTicketCategoryKey(ticket) {
            return ticket && ticket.category != null ? String(ticket.category).trim() : '';
        }

        function getCategoryButtonLabel(key) {
            if (key === '') {
                const def = paymentTicketUi.defaultCategoryLabel || {};
                return currentLanguage === 'en'
                    ? (def.en || def.zh || 'Other')
                    : (def.zh || def.en || '其他');
            }
            const buttons = paymentTicketUi.categoryButtons || [];
            const found = buttons.find(b => b && String(b.key).trim() === key);
            if (found && found.label) {
                return currentLanguage === 'en'
                    ? (found.label.en || found.label.zh || key)
                    : (found.label.zh || found.label.en || key);
            }
            return key;
        }

        function getTicketOptionLabel(ticket) {
            const t = ticket.title || {};
            const zh = t.zh || '';
            const en = t.en || zh;
            const name = currentLanguage === 'en' ? (en || zh) : (zh || en);
            const price = ticket.price != null ? ticket.price : '';
            if (name) return name + ' - $' + price;
            return currentLanguage === 'en' ? ('Ticket - $' + price) : ('票券 - $' + price);
        }

        function getDistinctCategoryKeys() {
            const keys = [];
            const seen = new Set();
            let hasEmpty = false;
            paymentTicketsData.forEach(function(ticket) {
                if (!isTicketInRange(ticket)) return;
                const key = getTicketCategoryKey(ticket);
                if (!key) {
                    hasEmpty = true;
                    return;
                }
                if (seen.has(key)) return;
                seen.add(key);
                keys.push(key);
            });
            if (hasEmpty) keys.push('');
            return keys;
        }

        function updateTicketSectionHighlight() {
            const $hl = $('#ticketHighlightText');
            const $hlRow = $('#ticketHighlightRow');
            const $block = $('#ticketSelectBlock');
            if (!$hl.length || !$hlRow.length) return;
            if (!$block.length || $block.is(':hidden')) {
                $hlRow.removeClass('is-visible');
                $hl.empty();
                return;
            }
            const ht = paymentTicketUi.highlightText || {};
            const text = currentLanguage === 'en'
                ? (ht.en || ht.zh || '')
                : (ht.zh || ht.en || '');
            if (!String(text).trim()) {
                $hlRow.removeClass('is-visible');
                $hl.empty();
                return;
            }
            $hl.text(text);
            $hlRow.addClass('is-visible');
        }

        function rebuildTicketSelect() {
            const $sel = $('#ticketId');
            if (!$sel.length) return;
            const placeholderZh = '--- 請選擇票券 ---';
            const placeholderEn = '--- Please select a ticket ---';
            const ph = currentLanguage === 'en' ? placeholderEn : placeholderZh;
            $sel.empty().append($('<option>', { value: '', text: ph, 'data-zh': placeholderZh, 'data-en': placeholderEn }));

            paymentTicketsData.forEach(function(ticket) {
                if (!isTicketInRange(ticket)) return;
                if (ticketsUseCategories && selectedTicketCategory !== getTicketCategoryKey(ticket)) return;
                const t = ticket.title || {};
                const optZh = (t.zh ? t.zh : '票券') + ' - $' + ticket.price;
                const optEn = ((t.en || t.zh) ? (t.en || t.zh) : 'Ticket') + ' - $' + ticket.price;
                $sel.append($('<option>', {
                    value: ticket._id,
                    text: getTicketOptionLabel(ticket),
                    'data-zh': optZh,
                    'data-en': optEn
                }));
            });
            updateTicketSectionHighlight();
        }

        function renderCategoryButtons() {
            const $wrap = $('#ticketCategoryButtons');
            if (!$wrap.length) return;
            $wrap.empty();
            getDistinctCategoryKeys().forEach(function(key) {
                const $btn = $('<button>', {
                    type: 'button',
                    class: 'ticket-category-btn',
                    text: getCategoryButtonLabel(key),
                    'data-category': key
                });
                if (key === selectedTicketCategory) $btn.addClass('active');
                $wrap.append($btn);
            });
        }

        function initPaymentTickets() {
            if (!paymentTicketsData.length) return;
            if (ticketsUseCategories) {
                renderCategoryButtons();
                $('#ticketCategoryButtons').on('click', '.ticket-category-btn', function() {
                    selectedTicketCategory = $(this).data('category');
                    $('#ticketCategory').val(selectedTicketCategory);
                    $('.ticket-category-btn').removeClass('active');
                    $(this).addClass('active');
                    $('#ticketSelectBlock').show();
                    $('#ticketId').prop('required', true).val('');
                    rebuildTicketSelect();
                    updateTicketSectionHighlight();
                });
            } else {
                rebuildTicketSelect();
            }
            updateTicketSectionHighlight();
        }

        function refreshPaymentTicketUi() {
            if (!paymentTicketsData.length) return;
            if (ticketsUseCategories) renderCategoryButtons();
            rebuildTicketSelect();
            updateTicketSectionHighlight();
        }

        /** 是否為區塊級 HTML（p/div/ul 等），此類內容直接渲染 */
        function termsLooksLikeBlockHtml(s) {
            return /<\s*\/?\s*(p|div|ul|ol|li|h[1-6]|table|tbody|tr|td|th|blockquote|section|article|br|a)\b/i.test(s);
        }

        function escapeTermsHtml(text) {
            const div = document.createElement('div');
            div.textContent = text;
            return div.innerHTML;
        }

        /** 純文字中的 http(s) URL 自動變為可點連結 */
        function linkifyPlainUrls(escapedText) {
            return escapedText.replace(/(https?:\/\/[^\s<>"']+)/gi, function(url) {
                const href = url.replace(/"/g, '&quot;');
                return '<a href="' + href + '" target="_blank" rel="noopener noreferrer">' + url + '</a>';
            });
        }

        /** 純文字或簡單 HTML：保留換行；完整 HTML 區塊則原樣輸出 */
        function formatTermsContent(raw) {
            const s = String(raw || '');
            if (!s.trim()) return '';
            if (termsLooksLikeBlockHtml(s)) {
                return s;
            }
            const normalized = s.replace(/\r\n/g, '\n');
            if (/<[a-z][\s\S]*?>/i.test(normalized)) {
                return normalized.replace(/\n/g, '<br>');
            }
            return linkifyPlainUrls(escapeTermsHtml(normalized)).replace(/\n/g, '<br>');
        }

        function renderTermsContentHtml() {
            const $termsContent = $('#termsContent');
            if (!$termsContent.length) return;
            const raw = currentLanguage === 'en'
                ? (termsContentByLang.en || termsContentByLang.zh || '')
                : (termsContentByLang.zh || termsContentByLang.en || '');
            $termsContent.html(formatTermsContent(raw));
        }

        function renderTermsLabelHtml() {
            const $label = $('#termsAgreeLabel');
            if (!$label.length) return;
            const raw = currentLanguage === 'en'
                ? (termsLabelByLang.en || termsLabelByLang.zh || '')
                : (termsLabelByLang.zh || termsLabelByLang.en || '');
            $label.html(formatTermsContent(raw));
        }

        function renderAgreementContentHtml() {
            document.querySelectorAll('.js-agreement-content-json').forEach(function(el) {
                const targetId = el.getAttribute('data-target');
                const $content = targetId ? $('#' + targetId) : $();
                if (!$content.length) return;
                let parsed = { zh: '', en: '' };
                try { parsed = JSON.parse(el.textContent); } catch (_) {}
                const raw = currentLanguage === 'en'
                    ? (parsed.en || parsed.zh || '')
                    : (parsed.zh || parsed.en || '');
                $content.html(formatTermsContent(raw));
            });
        }

        function renderAgreementLabelHtml() {
            document.querySelectorAll('.js-agreement-label-json').forEach(function(el) {
                const targetId = el.getAttribute('data-target');
                const $label = targetId ? $('#' + targetId) : $();
                if (!$label.length) return;
                let parsed = { zh: '', en: '' };
                try { parsed = JSON.parse(el.textContent); } catch (_) {}
                const raw = currentLanguage === 'en'
                    ? (parsed.en || parsed.zh || '')
                    : (parsed.zh || parsed.en || '');
                $label.html(formatTermsContent(raw));
            });
        }
        
        // 初始化語言按鈕狀態
        $(document).ready(function() {
            updateLanguageButtons();
            initPaymentTickets();
            // 總是更新頁面語言（確保初始狀態正確）
            updatePageLanguage();
            
            // 頁面載入後，清除所有有效字段的驗證訊息
            setTimeout(function() {
                $('input[required], textarea[required], select[required]').each(function() {
                    const field = this;
                    const $field = $(field);
                    const fieldType = $field.attr('type');
                    
                    if (fieldType === 'checkbox' || fieldType === 'radio') {
                        return;
                    }
                    
                    // 如果字段有效，清除驗證訊息
                    if (field.validity.valid) {
                        field.setCustomValidity('');
                    }
                });
            }, 100);
        });

        // 切換語言
        function switchLanguage(lang) {
            currentLanguage = lang;
            updateLanguageButtons();
            updatePageLanguage();
            
            // 保存語言偏好到localStorage
            localStorage.setItem('preferredLanguage', lang);
        }

        // 更新語言按鈕狀態
        function updateLanguageButtons() {
            if (!languageSwitcherEnabled) return;
            $('#langZhBtn').toggleClass('active', currentLanguage === 'zh');
            $('#langEnBtn').toggleClass('active', currentLanguage === 'en');
        }

        // 更新頁面語言
        function updatePageLanguage() {
            updateRegisterHeaderText();

            // 更新區塊標題
            $('.section-title').each(function() {
                const $title = $(this);
                const zhText = $title.data('zh');
                const enText = $title.data('en');
                const requiredMark = $title.data('requiredMark');
                if (currentLanguage === 'zh' && zhText) {
                    if (requiredMark) {
                        $title.html(zhText + ' <span class="required">*</span>');
                    } else {
                        $title.text(zhText);
                    }
                } else if (currentLanguage === 'en' && enText) {
                    if (requiredMark) {
                        $title.html(enText + ' <span class="required">*</span>');
                    } else {
                        $title.text(enText);
                    }
                }
            });

            // 更新字段標籤
            $('.field-label').each(function() {
                const $label = $(this);
                const zhText = $label.data('zh');
                const enText = $label.data('en');
                // 檢查原始 HTML 中是否包含 required span，或檢查對應的輸入字段是否有 required 屬性
                const fieldId = $label.attr('for');
                const hasRequired = $label.find('.required').length > 0 || 
                                   (fieldId && $(`#${fieldId}`).attr('required') !== undefined);
                
                if (currentLanguage === 'zh' && zhText) {
                    if (hasRequired) {
                        $label.html(zhText + ' <span class="required">*</span>');
                    } else {
                        $label.text(zhText);
                    }
                } else if (currentLanguage === 'en' && enText) {
                    if (hasRequired) {
                        $label.html(enText + ' <span class="required">*</span>');
                    } else {
                        $label.text(enText);
                    }
                }
            });

            // Display 欄位（純文字）
            $('.field-display-text').each(function() {
                const $el = $(this);
                const zhText = $el.data('zh');
                const enText = $el.data('en');
                if (currentLanguage === 'zh' && zhText != null && zhText !== '') {
                    $el.text(zhText);
                } else if (currentLanguage === 'en' && enText != null && enText !== '') {
                    $el.text(enText);
                }
            });

            // 更新佔位符文本
            $('input, textarea').each(function() {
                const zhPlaceholder = $(this).data('placeholder-zh');
                const enPlaceholder = $(this).data('placeholder-en');
                if (currentLanguage === 'zh' && zhPlaceholder) {
                    $(this).attr('placeholder', zhPlaceholder);
                } else if (currentLanguage === 'en' && enPlaceholder) {
                    $(this).attr('placeholder', enPlaceholder);
                }
            });
            // select／checkbox／radio「其他」自填欄位佔位符
            $('.js-select-other-text, .js-choice-other-text').each(function() {
                const zhPlaceholder = $(this).data('placeholder-zh');
                const enPlaceholder = $(this).data('placeholder-en');
                if (currentLanguage === 'zh' && zhPlaceholder) {
                    $(this).attr('placeholder', zhPlaceholder);
                } else if (currentLanguage === 'en' && enPlaceholder) {
                    $(this).attr('placeholder', enPlaceholder);
                }
            });

            // 更新選擇框選項
            $('select option').each(function() {
                const zhText = $(this).data('zh');
                const enText = $(this).data('en');
                if (currentLanguage === 'zh' && zhText) {
                    $(this).text(zhText);
                } else if (currentLanguage === 'en' && enText) {
                    $(this).text(enText);
                }
            });

            // 更新 checkbox 和 radio 選項標籤（T&C / Agreement checkbox 含 HTML，另處理）
            $('.form-check-label:not(.agreement-checkbox-label):not(.terms-checkbox-label)').each(function() {
                const $label = $(this);
                const zhText = $label.data('zh');
                const enText = $label.data('en');
                if (currentLanguage === 'zh' && zhText) {
                    $label.text(zhText);
                } else if (currentLanguage === 'en' && enText) {
                    $label.text(enText);
                }
            });

            // 更新 T&C / Agreement 內容（支援 HTML）
            renderTermsContentHtml();
            renderTermsLabelHtml();
            renderAgreementContentHtml();
            renderAgreementLabelHtml();
            if (typeof refreshPaymentTicketUi === 'function') refreshPaymentTicketUi();

            // 更新按鈕文字（返回、下一步等）
            $('.lang-text').each(function() {
                const zhText = $(this).data('zh');
                const enText = $(this).data('en');
                if (currentLanguage === 'zh' && zhText) {
                    $(this).text(zhText);
                } else if (currentLanguage === 'en' && enText) {
                    $(this).text(enText);
                }
            });

            // Application 已鎖定欄位提示
            $('.application-locked-hint').each(function() {
                const $el = $(this);
                const zhText = $el.data('zh');
                const enText = $el.data('en');
                if (currentLanguage === 'en' && enText) {
                    $el.text(enText);
                } else if (zhText) {
                    $el.text(zhText);
                }
            });

            // 設置驗證訊息的函數（只在驗證失敗時調用）
            function setValidationMessage(field) {
                const $field = $(field);
                const fieldType = $field.attr('type');
                
                // 如果是 checkbox 或 radio，跳過（它們有特殊的驗證邏輯）
                if (fieldType === 'checkbox' || fieldType === 'radio') {
                    return;
                }
                
                // 根據語言設置驗證訊息
                if (currentLanguage === 'zh') {
                    if (field.validity.valueMissing) {
                        field.setCustomValidity('請填寫這個欄位。');
                    } else if (fieldType === 'email' && field.validity.typeMismatch) {
                        field.setCustomValidity('請輸入有效的電子郵件地址。');
                    } else {
                        field.setCustomValidity('請填寫這個欄位。');
                    }
                } else {
                    if (field.validity.valueMissing) {
                        field.setCustomValidity('Please fill in this field.');
                    } else if (fieldType === 'email' && field.validity.typeMismatch) {
                        field.setCustomValidity('Please enter a valid email address.');
                    } else {
                        field.setCustomValidity('Please fill in this field.');
                    }
                }
            }

            // 為所有必填字段設置驗證訊息處理（namespaced，避免每次切語言重複綁定）
            $('input[required], textarea[required], select[required]').each(function() {
                const field = this;
                const fieldType = ($(field).attr('type') || '').toLowerCase();
                if (fieldType === 'checkbox' || fieldType === 'radio') return;

                $(field).off('.regValidate')
                    .on('input.regValidate change.regValidate', function() {
                        this.setCustomValidity('');
                    })
                    .on('invalid.regValidate', function() {
                        if (!this.validity.valid) setValidationMessage(this);
                    });
            });

            $('input[required], textarea[required], select[required]').each(function() {
                const field = this;
                const fieldType = ($(field).attr('type') || '').toLowerCase();
                if (fieldType === 'checkbox' || fieldType === 'radio') return;
                if (field.validity.valid) {
                    field.setCustomValidity('');
                } else if (field.value && String(field.value).trim() !== '') {
                    setValidationMessage(field);
                }
            });
        }

        function initOverlayAndValidation(opts) {
            const overlay = document.getElementById(opts.overlayId);
            const openLink = document.getElementById(opts.openLinkId);
            const closeBtn = document.getElementById(opts.closeBtnId);
            const agreeEl = document.getElementById(opts.agreeId);

            function openOverlay(e) {
                if (e) e.preventDefault();
                if (!overlay) return;
                if (typeof opts.shouldOpen === 'function' && !opts.shouldOpen()) return;
                overlay.classList.add('is-open');
                overlay.setAttribute('aria-hidden', 'false');
                document.body.style.overflow = 'hidden';
            }

            function closeOverlay() {
                if (!overlay) return;
                overlay.classList.remove('is-open');
                overlay.setAttribute('aria-hidden', 'true');
                document.body.style.overflow = '';
            }

            if (openLink) openLink.addEventListener('click', openOverlay);
            if (opts.openTitleId) {
                const openTitle = document.getElementById(opts.openTitleId);
                if (openTitle && openTitle.classList.contains('terms-title-as-link')) {
                    openTitle.addEventListener('click', openOverlay);
                }
            }
            if (closeBtn) closeBtn.addEventListener('click', closeOverlay);
            if (overlay) {
                overlay.addEventListener('click', function(e) {
                    if (e.target === overlay) closeOverlay();
                });
            }
            document.addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && overlay && overlay.classList.contains('is-open')) {
                    closeOverlay();
                }
            });

            if (agreeEl && !opts.optionalAgree) {
                agreeEl.addEventListener('change', function() {
                    this.setCustomValidity('');
                });
                agreeEl.addEventListener('invalid', function() {
                    const msg = currentLanguage === 'zh'
                        ? (opts.invalidMsgZh || '請先閱讀並勾選同意，才可提交。')
                        : (opts.invalidMsgEn || 'Please agree before submitting.');
                    this.setCustomValidity(msg);
                });
            }
        }

        // Terms & Conditions
        initOverlayAndValidation({
            overlayId: 'termsOverlay',
            openLinkId: 'termsOpenLink',
            openTitleId: 'termsSectionTitle',
            closeBtnId: 'termsModalClose',
            agreeId: 'termsAgree',
            invalidMsgZh: '請先閱讀並勾選同意條款，才可提交。',
            invalidMsgEn: 'Please agree to the terms before submitting.'
        });

        // Agreement：只有「顯示連結文字」時，用 link text 開 content；否則只當 tickbox
        function agreementHasContent(suffix) {
            const jsonEl = document.querySelector('.js-agreement-content-json[data-target="agreementContent' + suffix + '"]');
            if (!jsonEl) return false;
            try {
                const parsed = JSON.parse(jsonEl.textContent || '{}');
                const raw = currentLanguage === 'en'
                    ? (parsed.en || parsed.zh || '')
                    : (parsed.zh || parsed.en || '');
                return String(raw).replace(/<[^>]*>/g, '').trim().length > 0;
            } catch (_) {
                return false;
            }
        }
        document.querySelectorAll('.js-agreement-agree').forEach(function(el) {
            const suffix = (el.id || '').replace(/^agreementAgree/, '');
            const openLink = document.getElementById('agreementOpenLink' + suffix);
            // 冇 show link text → 完全唔綁開框；有 link 先綁
            if (!openLink) return;
            initOverlayAndValidation({
                overlayId: 'agreementOverlay' + suffix,
                openLinkId: 'agreementOpenLink' + suffix,
                closeBtnId: 'agreementModalClose' + suffix,
                agreeId: el.id,
                optionalAgree: true,
                shouldOpen: function() { return agreementHasContent(suffix); }
            });
        });

        // 勾選框 label：點文字 = tick；點 URL = 正常開啟連結（唔 tick、唔開 content）
        $(document).on('click', '.agreement-checkbox-label', function(e) {
            if ($(e.target).closest('a').length) return;
            e.preventDefault();
            const cbId = this.getAttribute('data-checkbox-id');
            const cb = cbId ? document.getElementById(cbId) : null;
            if (!cb || cb.disabled) return;
            cb.checked = !cb.checked;
            $(cb).trigger('change');
        });
        $(document).on('click', '.agreement-checkbox-label a, .terms-checkbox-label a', function(e) {
            e.stopPropagation();
        });
        $(document).on('mousedown', '.agreement-checkbox-label a, .terms-checkbox-label a', function(e) {
            e.stopPropagation();
        });

        // stripe public key
        const STRIPE_PK = '<%= process.env.STRIPE_PK || "" %>';
        let stripe;
        if (STRIPE_PK) {
            stripe = Stripe(STRIPE_PK);
        }

        // FormConfig：select 勾選「其他可自填」時，以隱藏欄位送出用戶輸入文字
        function syncSelectWithOther(selectEl) {
            if (!selectEl || !selectEl.getAttribute('data-select-other-base')) return;
            var base = selectEl.getAttribute('data-select-other-base');
            var hidden = document.getElementById(base + '_hidden');
            var other = document.getElementById(base + '_other');
            if (!hidden || !other) return;
            var opt = selectEl.options[selectEl.selectedIndex];
            var isOther = opt && opt.getAttribute('data-is-other') === '1';
            if (isOther) {
                $(other).removeClass('d-none');
                if (selectEl.hasAttribute('required')) {
                    other.setAttribute('required', 'required');
                } else {
                    other.removeAttribute('required');
                }
                hidden.value = (other.value || '').trim();
            } else {
                $(other).addClass('d-none');
                other.removeAttribute('required');
                other.value = '';
                other.setCustomValidity('');
                hidden.value = selectEl.value || '';
            }
        }
        function syncChoiceOtherInput(choiceEl) {
            if (!choiceEl) return;
            var otherId = choiceEl.getAttribute('data-other-input');
            if (!otherId) return;
            var other = document.getElementById(otherId);
            if (!other) return;
            if (choiceEl.checked) {
                $(other).removeClass('d-none');
                other.setAttribute('required', 'required');
                // 唔清已有 value（Application 預填自填文字要保留）
            } else {
                $(other).addClass('d-none');
                other.removeAttribute('required');
                other.value = '';
                other.setCustomValidity('');
            }
        }
        function syncAllChoiceOtherInGroup(choiceEl) {
            if (!choiceEl || !choiceEl.name) return;
            if ((choiceEl.type || '').toLowerCase() === 'radio') {
                document.querySelectorAll('input[type="radio"][name="' + choiceEl.name + '"].js-radio-other').forEach(function(el) {
                    syncChoiceOtherInput(el);
                });
            } else {
                syncChoiceOtherInput(choiceEl);
            }
        }
        $(document).on('change', '.js-select-maybe-other', function() {
            syncSelectWithOther(this);
        });
        $(document).on('input', '.js-select-other-text', function() {
            var id = this.id;
            if (id && id.indexOf('_other') !== -1) {
                var base = id.replace(/_other$/, '');
                var sel = document.getElementById(base + '_sel');
                if (sel) syncSelectWithOther(sel);
            }
        });
        $(document).on('change', '.js-checkbox-other, .js-radio-other', function() {
            syncAllChoiceOtherInGroup(this);
        });
        $(document).on('change', 'input[type="radio"]', function() {
            if ($(this).hasClass('js-radio-other')) return;
            var name = this.name;
            if (!name) return;
            document.querySelectorAll('input[type="radio"][name="' + name + '"].js-radio-other').forEach(function(el) {
                syncChoiceOtherInput(el);
            });
        });
        $(document).on('input', '.js-choice-other-text', function() {
            this.setCustomValidity('');
        });
        $(function() {
            $('.js-select-maybe-other').each(function() { syncSelectWithOther(this); });
            $('.js-checkbox-other, .js-radio-other').each(function() { syncChoiceOtherInput(this); });
        });

        function getEmailConfirmMismatchMsg() {
            return currentLanguage === 'zh'
                ? '確認電子郵件必須與電子郵件相同。'
                : 'Confirm email must match the email address.';
        }

        function validateEmailConfirmPair(emailFieldName) {
            const emailEl = document.getElementById(emailFieldName);
            const confirmEl = document.getElementById(emailFieldName + '_confirm');
            if (!emailEl || !confirmEl) return true;
            const emailVal = (emailEl.value || '').trim();
            const confirmVal = (confirmEl.value || '').trim();
            if (!emailVal && !confirmVal) {
                confirmEl.setCustomValidity('');
                return true;
            }
            if (emailVal !== confirmVal) {
                confirmEl.setCustomValidity(getEmailConfirmMismatchMsg());
                return false;
            }
            confirmEl.setCustomValidity('');
            return true;
        }

        function validateAllEmailConfirms() {
            let ok = true;
            document.querySelectorAll('.js-email-confirm').forEach(function(confirmEl) {
                const forField = confirmEl.getAttribute('data-confirm-for');
                if (forField && !validateEmailConfirmPair(forField)) ok = false;
            });
            return ok;
        }

        $(document).on('input change', '.js-email-confirm', function() {
            const forField = $(this).data('confirm-for');
            if (forField) validateEmailConfirmPair(forField);
        });
        $(document).on('input change', 'input[type="email"]:not(.js-email-confirm)', function() {
            const id = $(this).attr('id');
            if (!id) return;
            $('.js-email-confirm[data-confirm-for="' + id + '"]').each(function() {
                validateEmailConfirmPair(id);
            });
        });

        $('#userForm').on('submit', function(e) {
            e.preventDefault(); // 防止表單默認提交
            e.stopPropagation();
            $('.js-select-maybe-other').each(function() { syncSelectWithOther(this); });
            $('.js-checkbox-other, .js-radio-other').each(function() { syncChoiceOtherInput(this); });
            var formEl = document.getElementById('userForm');
            var otherRequiredMsg = currentLanguage === 'zh' ? '請填寫這個欄位。' : 'Please fill in this field.';
            $('.js-select-other-text, .js-choice-other-text').each(function() {
                if (!$(this).hasClass('d-none') && this.hasAttribute('required') && !((this.value || '').trim())) {
                    this.setCustomValidity(otherRequiredMsg);
                } else {
                    this.setCustomValidity('');
                }
            });
            if (ticketsUseCategories && paymentTicketsData.length) {
                if ($('#ticketCategoryButtons').length && !$('#ticketCategoryButtons .active').length) {
                    alert(currentLanguage === 'zh' ? '請先選擇票券類別。' : 'Please select a ticket category first.');
                    return;
                }
                if (!$('#ticketId').val()) {
                    alert(currentLanguage === 'zh' ? '請選擇票券。' : 'Please select a ticket.');
                    return;
                }
            }
            const enteredPromo = getEnteredPromoCode ? getEnteredPromoCode() : String($('#eventPromoCode').val() || '').trim().toUpperCase();
            if (enteredPromo) {
                if (!validatedPromoCode || validatedPromoCode !== enteredPromo) {
                    alert(currentLanguage === 'zh'
                        ? '請先按「檢查」確認折扣碼可用。'
                        : 'Please click Check to verify the promocode first.');
                    $('#eventPromoCode').focus();
                    return;
                }
            }
            if (typeof validateAllEmailConfirms === 'function') {
                validateAllEmailConfirms();
            }
            if (formEl && !formEl.checkValidity()) {
                formEl.reportValidity();
                return;
            }
            const ticketId = $('#ticketId').val();
            
            // 動態收集所有表單字段
            const newUser = {};
            $('#userForm').find('input, select, textarea').each(function() {
                const fieldName = $(this).attr('name');
                if (!fieldName || fieldName === 'ticketId' || /^(agreementAgreed|agreementRecordedAt)(_\d+)?$/.test(fieldName)) return;
                if ($(this).prop('disabled')) return;
                if ($(this).hasClass('js-email-confirm') || String(fieldName).endsWith('_confirm')) return;
                const type = (this.type || '').toLowerCase();
                if (type === 'checkbox') {
                    if (!this.checked) return;
                    if (fieldName.endsWith('[]')) {
                        const key = fieldName.slice(0, -2);
                        if (!Array.isArray(newUser[key])) newUser[key] = [];
                        var cbVal = $(this).val();
                        if ($(this).hasClass('js-checkbox-other')) {
                            var cbOtherId = $(this).attr('data-other-input');
                            var cbOtherEl = cbOtherId ? document.getElementById(cbOtherId) : null;
                            cbVal = cbOtherEl ? (cbOtherEl.value || '').trim() : '';
                            if (!cbVal) return;
                        }
                        newUser[key].push(cbVal);
                    } else {
                        newUser[fieldName] = $(this).val();
                    }
                    return;
                }
                if (type === 'radio') {
                    if (!this.checked) return;
                    var radioVal = $(this).val();
                    if ($(this).hasClass('js-radio-other')) {
                        var radioOtherId = $(this).attr('data-other-input');
                        var radioOtherEl = radioOtherId ? document.getElementById(radioOtherId) : null;
                        radioVal = radioOtherEl ? (radioOtherEl.value || '').trim() : '';
                        if (!radioVal) return;
                    }
                    newUser[fieldName] = radioVal;
                    return;
                }
                newUser[fieldName] = $(this).val();
            });
            document.querySelectorAll('.js-agreement-agree').forEach(function(agreementEl) {
                const agreedName = agreementEl.getAttribute('name');
                const recordedName = agreementEl.getAttribute('data-recorded-at-name');
                if (agreedName) newUser[agreedName] = agreementEl.checked;
                if (recordedName) newUser[recordedName] = new Date().toISOString();
            });
            newUser.ticketId = ticketId;
            <% if (isApplicationMode) { %>
            if (!newUser.token) {
                newUser.token = <%- JSON.stringify(applicationTokenVal) %>;
            }
            newUser.lang = currentLanguage;
            $.ajax({
                type: 'POST',
                url: '/web/<%= event_id %>/application/<%= applicationUserIdVal %>',
                data: newUser,
                dataType: 'json',
                success: function(response) {
                    if (response && response.redirectUrl) {
                        window.location.href = response.redirectUrl;
                        return;
                    }
                    const params = new URLSearchParams();
                    if (currentLanguage && currentLanguage !== 'zh') params.set('lang', currentLanguage);
                    if (newUser.thankYouYesNo) params.set('thankYouYesNo', newUser.thankYouYesNo);
                    const qs = params.toString();
                    window.location.href = `/web/<%= event_id %>/register/success${qs ? '?' + qs : ''}`;
                },
                error: function(error) {
                    var errMsg = (error.responseJSON && error.responseJSON.message) ? error.responseJSON.message : '提交失敗';
                    $('#errorMessage').html('<div class="alert alert-danger">'+errMsg+'</div>');
                    $('#successMessage').html('');
                }
            });
            return;
            <% } %>
            if (ticketId) {
                // Wonder Payment checkout（沿用舊 API 路徑）

                newUser.lang = currentLanguage;
                
                $.ajax({
                    type: 'POST',
                    url: '/web/<%= event_id %>/stripe-checkout',
                    contentType: 'application/json',
                    data: JSON.stringify(newUser),
                    success: function(response) {
                        if (response.url) {
                            window.location.href = response.url;
                        } else {
                            $('#errorMessage').html('<div class="alert alert-danger">無法跳轉到付款頁面</div>');
                        }
                    },
                    error: function(error) {
                        var errMsg = error.responseJSON && error.responseJSON.message ? error.responseJSON.message : '付款失敗';
                        $('#errorMessage').html('<div class="alert alert-danger">'+errMsg+'</div>');
                    }
                });
            } else {
                // 無票券：公開免費報名（/web 路由，iframe 可用，不需 CORS）
                $.ajax({
                    type: 'POST',
                    url: '/web/<%= event_id %>/register',
                    data: newUser,
                    success: function(response) {
                        const params = new URLSearchParams();
                        if (currentLanguage && currentLanguage !== 'zh') params.set('lang', currentLanguage);
                        if (newUser.thankYouYesNo) params.set('thankYouYesNo', newUser.thankYouYesNo);
                        const qs = params.toString();
                        window.location.href = `/web/<%= event_id %>/register/success${qs ? '?' + qs : ''}`;
                    },
                    error: function(error) {
                        var errMsg = error.responseJSON.message;
                        $('#errorMessage').html('<div class="alert alert-danger">登記失敗！'+errMsg+'</div>');
                        $('#successMessage').html('');
                    }
                });
            }
        });
    </script>
</body>
</html>