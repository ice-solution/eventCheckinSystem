<!DOCTYPE html>
<html lang="<%= typeof lang !== 'undefined' && lang === 'en' ? 'en' : 'zh-Hant' %>">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title><%= title || (status === 'completed' ? '申請已完成' : '申請連結') %></title>
    <link rel="stylesheet" href="https://stackpath.bootstrapcdn.com/bootstrap/4.5.2/css/bootstrap.min.css">
    <style>
        body { background: #f8f9fa; font-family: Arial, Helvetica, sans-serif; font-weight: 400; }
        body, body input, body select, body textarea, body button, body label,
        body h1, body h2, body h3, body h4, body h5, body h6, body p, body span, body a, body .btn {
            font-family: Arial, Helvetica, sans-serif !important;
        }
        .box {
            max-width: 560px;
            margin: 60px auto;
            background: #fff;
            border-radius: 10px;
            box-shadow: 0 0 20px rgba(0,0,0,.08);
            padding: 36px 28px;
            text-align: center;
        }
        .box h1 { font-size: 1.5rem; color: #2c3e50; margin-bottom: 12px; }
        .box .message { color: #555; margin: 0; line-height: 1.6; text-align: left; }
        .box .message p { margin: 0 0 0.75em; }
        .box .message p:last-child { margin-bottom: 0; }
        .box .message a { color: #007bff; }
        .ok { color: #1e7e34; }
        .err { color: #c0392b; }
    </style>
</head>
<body>
    <div class="box">
        <h1 class="<%= status === 'completed' ? 'ok' : 'err' %>">
            <%= title || (status === 'completed' ? '申請已完成' : '無法開啟申請表') %>
        </h1>
        <div class="message"><%- message || '' %></div>
    </div>
</body>
</html>
