<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
    <title><%= voteTitle || 'Vote' %> — PMI HK Annual Dinner 2026</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Orbitron:wght@500;700&family=Rajdhani:wght@500;600;700&display=swap" rel="stylesheet">
    <style>
        :root {
            --void: #07041a;
            --violet: #6d28d9;
            --magenta: #c026d3;
            --cyan: #22d3ee;
            --gold: #fde047;
            --ink: #f5f3ff;
            --muted: #c4b5fd;
            --glass: rgba(15, 8, 40, 0.78);
            --line: rgba(34, 211, 238, 0.45);
            --safe-b: env(safe-area-inset-bottom, 0px);
        }
        * { box-sizing: border-box; }
        html, body { margin: 0; min-height: 100%; }
        body {
            font-family: 'Rajdhani', system-ui, sans-serif;
            color: var(--ink);
            background:
                radial-gradient(900px 480px at 50% -8%, rgba(192, 38, 211, 0.32), transparent 60%),
                radial-gradient(700px 420px at 90% 110%, rgba(109, 40, 217, 0.38), transparent 55%),
                linear-gradient(180deg, #14082e 0%, var(--void) 55%, #050210 100%);
            min-height: 100vh;
            -webkit-tap-highlight-color: transparent;
        }
        ::selection { background: rgba(34, 211, 238, 0.35); color: #fff; }
        button:focus-visible, input:focus-visible {
            outline: 2px solid var(--cyan);
            outline-offset: 2px;
        }

        .shell {
            width: min(720px, 100%);
            margin: 0 auto;
            padding: 14px 14px calc(18px + var(--safe-b));
        }

        .topbar {
            display: flex;
            justify-content: space-between;
            align-items: flex-start;
            gap: 10px;
            margin-bottom: 14px;
        }
        .brand {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(1rem, 4.2vw, 1.35rem);
            letter-spacing: 0.03em;
            margin: 0;
            line-height: 1.25;
            text-shadow: 0 0 18px rgba(34, 211, 238, 0.35);
        }
        .meta {
            color: var(--ink);
            text-align: right;
            max-width: 48%;
            word-break: break-word;
        }
        .meta-event {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(0.85rem, 3.2vw, 1.15rem);
            letter-spacing: 0.03em;
            line-height: 1.25;
            text-shadow: 0 0 18px rgba(34, 211, 238, 0.35);
            margin: 0;
        }
        .meta-email {
            display: block;
            margin-top: 6px;
            color: var(--muted);
            font-size: 0.85rem;
            word-break: break-all;
        }

        .gate {
            min-height: calc(100vh - 90px);
            display: grid;
            place-items: center;
            padding: 12px 0 24px;
        }
        .gate-panel {
            width: min(420px, 100%);
            background: var(--glass);
            border: 1px solid var(--line);
            border-radius: 16px;
            padding: 24px 18px;
            box-shadow: 0 18px 50px rgba(0, 0, 0, 0.45);
            backdrop-filter: blur(10px);
            animation: rise 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        .gate-panel h1 {
            font-family: 'Orbitron', sans-serif;
            font-size: 1.2rem;
            margin: 0 0 8px;
        }
        .gate-panel p {
            margin: 0 0 16px;
            color: var(--muted);
            line-height: 1.45;
            font-size: 0.98rem;
        }
        .gate-panel label {
            display: block;
            font-size: 0.9rem;
            margin-bottom: 6px;
            color: var(--muted);
        }
        .gate-panel input[type="email"] {
            width: 100%;
            border: 1px solid rgba(196, 181, 253, 0.35);
            background: rgba(7, 4, 26, 0.65);
            color: var(--ink);
            border-radius: 12px;
            padding: 14px 14px;
            font: inherit;
            font-size: 16px; /* prevent iOS zoom */
            margin-bottom: 10px;
        }
        .err {
            color: #fda4af;
            font-size: 0.92rem;
            min-height: 1.2em;
            margin: 0 0 10px;
        }
        .btn {
            appearance: none;
            border: 0;
            cursor: pointer;
            font-family: inherit;
            font-weight: 700;
            letter-spacing: 0.04em;
            border-radius: 999px;
            padding: 13px 20px;
            font-size: 1rem;
            transition: transform 0.15s ease, box-shadow 0.15s ease, opacity 0.15s ease;
            touch-action: manipulation;
        }
        .btn:disabled { opacity: 0.45; cursor: not-allowed; }
        .btn-primary {
            width: 100%;
            color: #0b0618;
            background: linear-gradient(90deg, var(--gold), var(--cyan));
            box-shadow: 0 8px 24px rgba(34, 211, 238, 0.25);
        }
        .btn-ghost {
            background: transparent;
            color: var(--muted);
            border: 1px solid rgba(196, 181, 253, 0.35);
            padding: 10px 14px;
            font-size: 0.9rem;
        }

        .stepper {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
            margin-bottom: 12px;
        }
        .step {
            text-align: center;
            padding: 10px 6px;
            border-radius: 12px;
            border: 1px solid rgba(196, 181, 253, 0.25);
            background: rgba(15, 8, 40, 0.55);
            color: var(--muted);
            cursor: pointer;
            font-weight: 700;
            font-size: 0.82rem;
            line-height: 1.2;
            min-height: 44px;
            touch-action: manipulation;
        }
        .step.is-active {
            border-color: var(--cyan);
            color: var(--ink);
            box-shadow: 0 0 0 1px rgba(34, 211, 238, 0.35);
        }
        .step.is-done { border-color: rgba(253, 224, 71, 0.55); color: var(--gold); }

        .q-title {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(0.95rem, 3.6vw, 1.15rem);
            margin: 0 0 10px;
            letter-spacing: 0.02em;
            line-height: 1.3;
        }

        .kv-stage {
            width: 100%;
            border-radius: 14px;
            overflow: hidden;
            border: 1px solid var(--line);
            background: #050210;
            box-shadow: 0 16px 40px rgba(0, 0, 0, 0.4);
            animation: rise 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        .kv-stage img {
            display: block;
            width: 100%;
            height: auto;
            user-select: none;
            pointer-events: none;
        }
        .kv-missing {
            min-height: 180px;
            display: grid;
            place-items: center;
            color: var(--muted);
            padding: 20px;
            text-align: center;
        }

        .pick-label {
            margin: 14px 0 8px;
            color: var(--muted);
            font-size: 0.95rem;
            font-weight: 600;
        }
        .slot-picks {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
            gap: 10px;
        }
        .chip {
            border: 1px solid rgba(196, 181, 253, 0.4);
            background: rgba(15, 8, 40, 0.72);
            color: var(--ink);
            border-radius: 14px;
            padding: 14px 10px;
            font-weight: 700;
            font-size: 1.05rem;
            cursor: pointer;
            min-height: 52px;
            touch-action: manipulation;
        }
        .chip.is-selected {
            border-color: var(--gold);
            color: var(--gold);
            box-shadow: 0 0 18px rgba(253, 224, 71, 0.28);
            background: rgba(253, 224, 71, 0.08);
        }

        .footer-bar {
            position: sticky;
            bottom: 0;
            margin-top: 16px;
            padding: 12px 0 calc(8px + var(--safe-b));
            background: linear-gradient(180deg, transparent, rgba(7, 4, 26, 0.96) 28%);
            display: grid;
            gap: 10px;
        }
        .nav-row {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 8px;
        }
        .footer-bar .hint {
            color: var(--muted);
            font-size: 0.92rem;
            text-align: center;
        }
        .footer-bar .btn-primary { width: 100%; }

        .done {
            text-align: center;
            padding: 56px 12px;
            animation: rise 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
        }
        .done h2 {
            font-family: 'Orbitron', sans-serif;
            font-size: clamp(1.25rem, 5vw, 1.8rem);
            margin: 0 0 10px;
        }
        .done p { color: var(--muted); margin: 0; }

        .hidden { display: none !important; }

        @keyframes rise {
            from { opacity: 0; transform: translateY(10px); }
            to { opacity: 1; transform: none; }
        }

        @media (min-width: 768px) {
            .shell { width: min(860px, 100%); padding: 22px 20px 36px; }
            .slot-picks { grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); }
            .footer-bar {
                display: flex;
                align-items: center;
                justify-content: space-between;
                gap: 12px;
            }
            .nav-row { width: auto; }
            .footer-bar .btn-primary { width: auto; min-width: 180px; }
            .footer-bar .hint { text-align: left; }
        }
    </style>
</head>
<body>
<%
  const questionsJson = JSON.stringify(questions || []);
  const hasVoter = !!voter;
%>
<div class="shell">
    <div class="topbar">
        <h1 class="brand"><%= voteTitle || 'Vote' %></h1>
        <div class="meta" id="voterMeta">
            <p class="meta-event">PMI HK Annual Dinner 2026</p>
            <% if (hasVoter) { %>
                <span class="meta-email"><%= voter.email %></span>
                <button type="button" class="btn btn-ghost" id="logoutBtn" style="margin-top:6px;">Sign out</button>
            <% } %>
        </div>
    </div>

    <% if (hasVoted) { %>
        <div class="done" id="doneView">
            <h2>Ballot submitted</h2>
        </div>
    <% } else { %>
        <div id="gateView" class="<%= hasVoter ? 'hidden' : '' %>">
            <div class="gate">
                <div class="gate-panel">
                    <h1>Please insert your PMI email address</h1>
                    <form id="emailForm">
                        <label for="emailInput">Email</label>
                        <input id="emailInput" type="email" autocomplete="email" inputmode="email" required placeholder="name@pmi.com">
                        <p class="err" id="emailErr" aria-live="polite"></p>
                        <button class="btn btn-primary" type="submit" id="emailBtn">Continue</button>
                    </form>
                </div>
            </div>
        </div>

        <div id="ballotView" class="<%= hasVoter ? '' : 'hidden' %>">
            <div class="stepper" id="stepper"></div>
            <h2 class="q-title" id="qTitle"></h2>
            <div class="kv-stage" id="kvStage">
                <div class="kv-missing" id="kvMissing">KV image not uploaded yet</div>
                <img id="kvImg" alt="KV" class="hidden" width="1600" height="600" src="data:image/gif;base64,R0lGODlhAQABAIAAAAAAAP///yH5BAEAAAAALAAAAAABAAEAAAIBRAA7">
            </div>
            <div class="pick-label" id="pickLabel">Tap one option below: Please vote one</div>
            <div class="slot-picks" id="slotPicks" role="listbox" aria-label="Options"></div>
            <div class="footer-bar">
                <div class="hint" id="progressHint">Select one option for each question</div>
                <div class="nav-row">
                    <button type="button" class="btn btn-ghost" id="prevBtn">Previous</button>
                    <button type="button" class="btn btn-ghost" id="nextBtn">Next</button>
                </div>
                <button type="button" class="btn btn-primary" id="submitBtn" disabled>Submit vote</button>
            </div>
            <p class="err" id="submitErr" aria-live="polite"></p>
        </div>

        <div class="done hidden" id="doneView">
            <h2>Vote submitted</h2>
        </div>
    <% } %>
</div>

<script>
(function () {
    var eventId = <%- JSON.stringify(String(eventId)) %>;
    var questions = <%- questionsJson %>;
    var answers = {};
    var current = 0;

    var gateView = document.getElementById('gateView');
    var ballotView = document.getElementById('ballotView');
    var doneView = document.getElementById('doneView');

    function bindLogout() {
        var logoutBtn = document.getElementById('logoutBtn');
        if (!logoutBtn) return;
        logoutBtn.addEventListener('click', function () {
            logoutBtn.disabled = true;
            fetch('/votes/' + eventId + '/logout', {
                method: 'POST',
                credentials: 'same-origin',
                headers: { 'Content-Type': 'application/json' }
            }).then(function (r) {
                if (!r.ok) throw new Error('logout failed');
                location.reload();
            }).catch(function () {
                logoutBtn.disabled = false;
                alert('Sign out failed. Please try again.');
            });
        });
    }
    bindLogout();

    if (!ballotView) return;

    function answeredCount() {
        return questions.reduce(function (n, q) {
            return n + (answers[q._id] ? 1 : 0);
        }, 0);
    }

    function updateProgress() {
        var n = answeredCount();
        var hint = document.getElementById('progressHint');
        var submitBtn = document.getElementById('submitBtn');
        if (hint) hint.textContent = 'Selected ' + n + ' / ' + questions.length;
        if (submitBtn) submitBtn.disabled = n !== questions.length;
        renderStepper();
    }

    function shortTitle(t, i) {
        var s = String(t || ('Q' + (i + 1)));
        if (s.length > 18) return s.slice(0, 16) + '…';
        return s;
    }

    function renderStepper() {
        var el = document.getElementById('stepper');
        if (!el) return;
        el.innerHTML = questions.map(function (q, i) {
            var cls = 'step';
            if (i === current) cls += ' is-active';
            if (answers[q._id]) cls += ' is-done';
            return '<button type="button" class="' + cls + '" data-i="' + i + '">' + (i + 1) + '. ' + escapeHtml(shortTitle(q.title, i)) + '</button>';
        }).join('');
        Array.prototype.forEach.call(el.querySelectorAll('.step'), function (btn) {
            btn.addEventListener('click', function () {
                current = Number(btn.getAttribute('data-i')) || 0;
                renderQuestion();
            });
        });
    }

    function escapeHtml(s) {
        return String(s || '').replace(/[&<>"']/g, function (c) {
            return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
        });
    }

    function selectSlot(qid, sid) {
        answers[qid] = sid;
        renderQuestion();
        updateProgress();
    }

    function renderQuestion() {
        var q = questions[current];
        if (!q) return;
        document.getElementById('qTitle').textContent = (current + 1) + ' / ' + questions.length + ' — ' + (q.title || '');
        var img = document.getElementById('kvImg');
        var missing = document.getElementById('kvMissing');
        var picks = document.getElementById('slotPicks');

        if (q.kvImage) {
            img.src = q.kvImage;
            img.alt = q.title || 'Key visual';
            img.classList.remove('hidden');
            missing.classList.add('hidden');
        } else {
            img.classList.add('hidden');
            missing.classList.remove('hidden');
        }

        picks.innerHTML = (q.slots || []).map(function (s) {
            var selected = answers[q._id] === s._id ? ' is-selected' : '';
            return '<button type="button" class="chip' + selected + '" data-sid="' + s._id + '" role="option" aria-selected="' + (selected ? 'true' : 'false') + '">' + escapeHtml(s.label) + '</button>';
        }).join('');
        Array.prototype.forEach.call(picks.querySelectorAll('.chip'), function (btn) {
            btn.addEventListener('click', function () {
                selectSlot(q._id, btn.getAttribute('data-sid'));
            });
        });

        document.getElementById('prevBtn').disabled = current === 0;
        document.getElementById('nextBtn').disabled = current >= questions.length - 1;
        renderStepper();
    }

    document.getElementById('prevBtn').addEventListener('click', function () {
        if (current > 0) { current -= 1; renderQuestion(); }
    });
    document.getElementById('nextBtn').addEventListener('click', function () {
        if (current < questions.length - 1) { current += 1; renderQuestion(); }
    });

    document.getElementById('emailForm').addEventListener('submit', function (e) {
        e.preventDefault();
        var email = document.getElementById('emailInput').value;
        var err = document.getElementById('emailErr');
        var btn = document.getElementById('emailBtn');
        err.textContent = '';
        btn.disabled = true;
        fetch('/votes/' + eventId + '/auth', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ email: email })
        }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
            btn.disabled = false;
            if (!res.ok) {
                err.textContent = (res.j && res.j.message) || 'Sign-in failed';
                return;
            }
            if (res.j.hasVoted) {
                gateView.classList.add('hidden');
                ballotView.classList.add('hidden');
                doneView.classList.remove('hidden');
                return;
            }
            location.reload();
        }).catch(function () {
            btn.disabled = false;
            err.textContent = 'Network error. Please try again.';
        });
    });

    document.getElementById('submitBtn').addEventListener('click', function () {
        var err = document.getElementById('submitErr');
        err.textContent = '';
        if (answeredCount() !== questions.length) {
            err.textContent = 'Please complete all three questions before submitting.';
            return;
        }
        var payload = {
            answers: questions.map(function (q) {
                return { questionId: q._id, slotId: answers[q._id] };
            })
        };
        var btn = document.getElementById('submitBtn');
        btn.disabled = true;
        fetch('/votes/' + eventId + '/submit', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify(payload)
        }).then(function (r) { return r.json().then(function (j) { return { ok: r.ok, j: j }; }); })
        .then(function (res) {
            if (!res.ok) {
                btn.disabled = false;
                err.textContent = (res.j && res.j.message) || 'Submit failed';
                updateProgress();
                return;
            }
            ballotView.classList.add('hidden');
            doneView.classList.remove('hidden');
        }).catch(function () {
            btn.disabled = false;
            err.textContent = 'Network error. Please try again.';
            updateProgress();
        });
    });

    if (!ballotView.classList.contains('hidden')) {
        renderQuestion();
        updateProgress();
    }
})();
</script>
</body>
</html>
