<%- include("components/header") %>
<%- include("components/menu", { eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>

<div id="right-panel" class="right-panel">
    <%- include("components/rightpanel_header", { backUrl: '/events/' + eventId }) %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-8">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title"><%= t('event_settings.title') %></strong>
                            <% if (typeof eventName !== 'undefined' && eventName) { %>
                            <span class="text-muted ml-2"><%= eventName %></span>
                            <% } %>
                        </div>
                        <div class="card-body">
                            <form id="eventSettingsForm">
                                <div class="form-group">
                                    <label for="emailSenderName"><%= t('event_settings.senderNameLabel') %></label>
                                    <input type="text" class="form-control" id="emailSenderName" maxlength="120"
                                           placeholder="<%= t('event_settings.senderNamePlaceholder') %>">
                                    <small class="form-text text-muted"><%= t('event_settings.senderNameHint') %></small>
                                </div>
                                <div class="form-group">
                                    <label><%= t('event_settings.senderEmailLabel') %></label>
                                    <input type="text" class="form-control" value="<%= senderEmail %>" readonly>
                                </div>
                                <p class="text-muted" id="senderPreview"></p>
                                <button type="submit" class="btn btn-primary"><%= t('common.save') %></button>
                            </form>
                            <div id="alertContainer" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("components/footer_minimal") %>
<script>
(function($) {
    var eventId = '<%= eventId %>';
    var senderEmail = <%- JSON.stringify(typeof senderEmail !== 'undefined' ? senderEmail : '') %>;
    var initialName = <%- JSON.stringify(typeof emailSenderName !== 'undefined' ? emailSenderName : '') %>;
    var saveLabel = '<%= t("common.save") %>';
    var savingLabel = '<%= t("event_settings.saving") %>';
    var savedMsg = '<%= t("event_settings.saved") %>';
    var errorMsg = '<%= t("event_settings.error") %>';

    function updatePreview() {
        var name = $('#emailSenderName').val().trim();
        var text = name && senderEmail
            ? (name + ' <' + senderEmail + '>')
            : (senderEmail || '');
        $('#senderPreview').text(text);
    }

    $('#emailSenderName').val(initialName);
    updatePreview();
    $('#emailSenderName').on('input', updatePreview);

    $('#eventSettingsForm').on('submit', function(e) {
        e.preventDefault();
        var btn = $(this).find('button[type="submit"]');
        btn.prop('disabled', true).text(savingLabel);
        $.ajax({
            url: '/events/' + eventId + '/settings',
            type: 'PATCH',
            contentType: 'application/json',
            data: JSON.stringify({ emailSenderName: $('#emailSenderName').val() }),
            success: function() {
                $('#alertContainer').html('<div class="alert alert-success">' + savedMsg + '</div>');
            },
            error: function(xhr) {
                var msg = errorMsg;
                try {
                    var j = JSON.parse(xhr.responseText);
                    if (j.message) msg = j.message;
                } catch (_) {}
                $('#alertContainer').html('<div class="alert alert-danger">' + msg + '</div>');
            },
            complete: function() {
                btn.prop('disabled', false).text(saveLabel);
            }
        });
    });
})(jQuery);
</script>
