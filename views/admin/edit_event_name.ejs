<%- include("components/header") %>
<%- include("components/menu", { eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>

<div id="right-panel" class="right-panel">
    <%- include("components/rightpanel_header", { backUrl: '/events/' + eventId }) %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title"><%= t('edit_event_name.title') %></strong>
                        </div>
                        <div class="card-body">
                            <p class="text-muted mb-3">
                                <%= t('edit_event_name.currentName') %>
                                <strong><%= typeof eventName !== 'undefined' ? eventName : '' %></strong>
                            </p>
                            <form id="editEventNameForm">
                                <div class="form-group">
                                    <label for="name"><%= t('edit_event_name.label') %></label>
                                    <input type="text" class="form-control" id="name" required>
                                </div>
                                <button type="submit" class="btn btn-primary"><%= t('common.save') %></button>
                            </form>
                            <div id="alertContainer" class="mt-3"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("components/footer_minimal") %>
<script>
(function($) {
    var eventId = '<%= eventId %>';
    var initialName = <%- JSON.stringify(typeof eventName !== 'undefined' ? eventName : '') %>;
    var saveLabel = '<%= t("common.save") %>';
    var savingLabel = '<%= t("edit_event_name.saving") %>';
    var requiredMsg = '<%= t("edit_event_name.required") %>';
    var savedMsg = '<%= t("edit_event_name.saved") %>';
    var errorMsg = '<%= t("edit_event_name.error") %>';

    $('#name').val(initialName);
    $('#editEventNameForm').on('submit', function(e) {
        e.preventDefault();
        var name = $('#name').val().trim();
        if (!name) {
            alert(requiredMsg);
            return;
        }
        var btn = $(this).find('button[type="submit"]');
        btn.prop('disabled', true).text(savingLabel);
        $.ajax({
            url: '/events/' + eventId + '/name',
            type: 'PATCH',
            contentType: 'application/json',
            data: JSON.stringify({ name: name }),
            success: function() {
                $('#alertContainer').html(
                    '<div class="alert alert-success">' + savedMsg + '</div>'
                );
                document.title = name + ' - Edit';
            },
            error: function(xhr) {
                var msg = errorMsg;
                try {
                    var j = JSON.parse(xhr.responseText);
                    if (j.message) msg = j.message;
                } catch (_) {}
                $('#alertContainer').html(
                    '<div class="alert alert-danger">' + msg + '</div>'
                );
            },
            complete: function() {
                btn.prop('disabled', false).text(saveLabel);
            }
        });
    });
})(jQuery);
</script>
