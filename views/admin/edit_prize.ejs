<%- include ("components/header") %>
<%- include ("components/menu", {eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header") %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title"><%= t('edit_prize.title') %> - <%= event.name %></strong>
                        </div>
                        <div class="card-body">
                            <form id="editPrizeForm">
                                <div class="form-group">
                                    <label for="name"><%= t('edit_prize.prizeName') %></label>
                                    <input type="text" class="form-control" id="name" name="name" value="<%= prize.name %>" required>
                                </div>
                                <div class="form-group">
                                    <label for="prizeImage"><%= t('edit_prize.prizeImage') %></label>
                                    <input type="file" class="form-control-file" id="prizeImage" name="prizeImage" accept="image/*">
                                    <small class="form-text text-muted"><%= t('edit_prize.imageSupport') %></small>
                                    <% if (prize.picture) { %>
                                        <div class="mt-2">
                                            <label><%= t('edit_prize.currentImage') %></label>
                                            <img src="<%= prize.picture %>" alt="<%= prize.name %>" style="max-width: 100px; max-height: 100px; display: block; margin-top: 5px;">
                                        </div>
                                    <% } %>
                                </div>
                                <div class="form-group">
                                    <label for="picture"><%= t('edit_prize.imageUrl') %></label>
                                    <input type="text" class="form-control" id="picture" name="picture" value="<%= prize.picture || '' %>" placeholder="https://example.com/image.jpg">
                                    <small class="form-text text-muted"><%= t('edit_prize.imageUrlNote') %></small>
                                </div>
                                <div class="form-group">
                                    <label for="unit"><%= t('edit_prize.quantity') %></label>
                                    <input type="number" class="form-control" id="unit" name="unit" value="<%= prize.unit %>" min="0" required>
                                </div>
                                <button type="submit" class="btn btn-primary"><%= t('edit_prize.updateBtn') %></button>
                                <a href="/prizes/<%= eventId %>/prizes/list" class="btn btn-secondary"><%= t('edit_prize.backToList') %></a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include ("components/footer_minimal") %>
<script>
(function () {
    var MSG = {
        updateSuccess: <%- JSON.stringify(t('edit_prize.updateSuccess')) %>,
        updateFailed: <%- JSON.stringify(t('edit_prize.updateFailed')) %>,
        nameRequired: 'Name required',
        invalidQty: 'Invalid quantity'
    };
    var eventId = <%- JSON.stringify(String(eventId)) %>;
    var prizeId = <%- JSON.stringify(String(prize._id)) %>;
    var form = document.getElementById('editPrizeForm');
    if (!form) return;

    form.addEventListener('submit', function (e) {
        e.preventDefault();
        var nameEl = document.getElementById('name');
        var unitEl = document.getElementById('unit');
        var imageEl = document.getElementById('prizeImage');
        var pictureEl = document.getElementById('picture');

        var name = String(nameEl && nameEl.value || '').trim();
        var unit = parseInt(String(unitEl && unitEl.value || '').trim(), 10);
        if (!name) { alert(MSG.updateFailed + MSG.nameRequired); return; }
        if (!Number.isFinite(unit) || unit < 0) { alert(MSG.updateFailed + MSG.invalidQty); return; }

        var imageFile = imageEl && imageEl.files && imageEl.files[0];
        var picture = String(pictureEl && pictureEl.value || '').trim();
        var url = '/prizes/' + encodeURIComponent(eventId) + '/prizes/' + encodeURIComponent(prizeId);

        var req;
        if (imageFile) {
            var formData = new FormData();
            formData.append('name', name);
            formData.append('unit', String(unit));
            formData.append('prizeImage', imageFile);
            req = fetch(url, { method: 'PUT', body: formData });
        } else {
            req = fetch(url, {
                method: 'PUT',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ name: name, unit: unit, picture: picture })
            });
        }

        req.then(function (r) {
            return r.json().then(function (data) {
                return { ok: r.ok, status: r.status, data: data || {} };
            }).catch(function () {
                return { ok: r.ok, status: r.status, data: {} };
            });
        }).then(function (res) {
            if (!res.ok) {
                alert(MSG.updateFailed + (res.data.message || (' HTTP ' + res.status)));
                return;
            }
            if (res.data._id) {
                alert(MSG.updateSuccess);
                window.location.href = '/prizes/' + encodeURIComponent(eventId) + '/prizes/list';
            } else {
                alert(MSG.updateFailed + (res.data.message || ''));
            }
        }).catch(function () {
            alert(MSG.updateFailed);
        });
    });
})();
</script>
