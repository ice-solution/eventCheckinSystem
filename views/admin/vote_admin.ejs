<%- include ("components/header") %>
<%- include ("components/menu", {eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<style>
    .vote-q-list { display: flex; flex-direction: column; gap: 14px; }
    .vote-q-card {
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 18px;
        background: #fff;
        position: relative;
    }
    .vote-q-card.is-dragging {
        opacity: 0.85;
        box-shadow: 0 12px 28px rgba(15, 23, 42, 0.18);
    }
    .vote-q-handle {
        cursor: grab;
        user-select: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #64748b;
        font-size: 13px;
        font-weight: 600;
        margin-right: 10px;
    }
    .vote-q-handle:active { cursor: grabbing; }
    .vote-kv-preview {
        width: 100%;
        max-height: 220px;
        object-fit: contain;
        background: #0b0618;
        border-radius: 8px;
        border: 1px solid #334155;
    }
    .vote-kv-empty {
        height: 140px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #f1f5f9;
        border-radius: 8px;
        color: #64748b;
        font-size: 13px;
    }
    .results-block {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        margin-top: 8px;
    }
    .slot-bar {
        height: 10px;
        background: #e2e8f0;
        border-radius: 999px;
        overflow: hidden;
    }
    .slot-bar > span {
        display: block;
        height: 100%;
        background: linear-gradient(90deg, #7c3aed, #22d3ee);
    }
    .settings-box {
        background: #f8fafc;
        border: 1px solid #e2e8f0;
        border-radius: 12px;
        padding: 16px;
        margin-bottom: 20px;
    }
</style>

<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header", { backUrl: '/events/' + eventId }) %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header d-flex justify-content-between align-items-center flex-wrap" style="gap:8px;">
                            <strong class="card-title"><%= t('vote_admin.title') %> — <%= event.name %></strong>
                            <a href="/votes/<%= eventId %>" target="_blank" class="btn btn-sm btn-outline-primary">
                                <i class="fa fa-external-link"></i> <%= t('vote_admin.viewVotePage') %>
                            </a>
                        </div>
                        <div class="card-body">
                            <div class="settings-box">
                                <h5 class="mb-3"><%= t('vote_admin.settingsTitle') %></h5>
                                <form id="voteSettingsForm">
                                    <div class="form-group">
                                        <label for="title"><%= t('vote_admin.voteTitle') %></label>
                                        <input type="text" class="form-control" id="title" value="<%= vote.title %>" required>
                                        <small class="form-text text-muted"><%= t('vote_admin.voteTitleHint') %></small>
                                    </div>
                                    <div class="form-group">
                                        <label for="headerRight"><%= t('vote_admin.headerRight') %></label>
                                        <input type="text" class="form-control" id="headerRight" value="<%= vote.headerRight || '' %>" placeholder="<%= t('vote_admin.emptyPlaceholder') %>">
                                        <small class="form-text text-muted"><%= t('vote_admin.headerRightHint') %></small>
                                    </div>
                                    <div class="form-group">
                                        <label for="gateTitle"><%= t('vote_admin.gateTitle') %></label>
                                        <input type="text" class="form-control" id="gateTitle" value="<%= vote.gateTitle || '' %>" placeholder="<%= t('vote_admin.emptyPlaceholder') %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="description"><%= t('vote_admin.voteDescription') %></label>
                                        <textarea class="form-control" id="description" rows="2" placeholder="<%= t('vote_admin.emptyPlaceholder') %>"><%= vote.description || '' %></textarea>
                                        <small class="form-text text-muted"><%= t('vote_admin.voteDescriptionHint') %></small>
                                    </div>
                                    <div class="form-group">
                                        <label for="pickHint"><%= t('vote_admin.pickHint') %></label>
                                        <input type="text" class="form-control" id="pickHint" value="<%= vote.pickHint || '' %>" placeholder="<%= t('vote_admin.emptyPlaceholder') %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="submitLabel"><%= t('vote_admin.submitLabel') %></label>
                                        <input type="text" class="form-control" id="submitLabel" value="<%= vote.submitLabel || '' %>" placeholder="<%= t('vote_admin.emptyPlaceholder') %>">
                                    </div>
                                    <div class="form-group">
                                        <label for="doneTitle"><%= t('vote_admin.doneTitle') %></label>
                                        <input type="text" class="form-control" id="doneTitle" value="<%= vote.doneTitle || '' %>" placeholder="<%= t('vote_admin.emptyPlaceholder') %>">
                                    </div>
                                    <div class="form-group">
                                        <div class="custom-control custom-switch">
                                            <input type="checkbox" class="custom-control-input" id="isActive" <%= vote.isActive ? 'checked' : '' %>>
                                            <label class="custom-control-label" for="isActive"><%= t('vote_admin.enableVote') %></label>
                                        </div>
                                    </div>
                                    <button type="submit" class="btn btn-primary"><i class="fa fa-save mr-1"></i><%= t('vote_admin.updateSettings') %></button>
                                </form>
                            </div>

                            <h5 class="mb-2"><%= t('vote_admin.questionsTitle') %></h5>
                            <p class="text-muted small mb-3"><%= t('vote_admin.questionsHint') %> · <%= t('vote_admin.dragHint') %></p>

                            <div class="vote-q-list" id="voteQuestionList">
                            <% (vote.questions || []).forEach(function(q, qi) { %>
                                <div class="vote-q-card" data-question-id="<%= q._id %>">
                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap" style="gap:8px;">
                                        <div>
                                            <span class="vote-q-handle" draggable="true" title="<%= t('vote_admin.dragHint') %>">
                                                <i class="fa fa-bars"></i> <%= t('vote_admin.dragHandle') %>
                                            </span>
                                            <strong class="js-q-order-label"><%= t('vote_admin.questionN') %> <%= qi + 1 %></strong>
                                        </div>
                                        <span class="badge badge-secondary"><%= (q.slots || []).length %> slots</span>
                                    </div>
                                    <div class="row">
                                        <div class="col-md-6 mb-3">
                                            <% if (q.kvImage) { %>
                                                <img class="vote-kv-preview" src="<%= q.kvImage %>" alt="KV">
                                            <% } else { %>
                                                <div class="vote-kv-empty"><%= t('vote_admin.kvEmpty') %></div>
                                            <% } %>
                                            <div class="mt-2">
                                                <label class="small mb-1"><%= t('vote_admin.uploadKv') %></label>
                                                <input type="file" class="form-control-file js-kv-upload" accept="image/*" data-qid="<%= q._id %>">
                                            </div>
                                        </div>
                                        <div class="col-md-6 mb-3">
                                            <div class="form-group">
                                                <label><%= t('vote_admin.questionTitle') %></label>
                                                <input type="text" class="form-control js-q-title" value="<%= q.title || '' %>" data-qid="<%= q._id %>">
                                            </div>
                                            <div class="form-group">
                                                <label><%= t('vote_admin.slotCount') %></label>
                                                <input type="number" min="1" max="10" class="form-control js-q-slots" value="<%= (q.slots || []).length %>" data-qid="<%= q._id %>">
                                                <small class="text-muted"><%= t('vote_admin.slotCountHint') %></small>
                                            </div>
                                            <div class="form-group">
                                                <label><%= t('vote_admin.slotLabels') %></label>
                                                <input type="text" class="form-control js-q-labels" data-qid="<%= q._id %>"
                                                    value="<%= (q.slots || []).map(function(s){ return s.label; }).join(', ') %>"
                                                    placeholder="1, 2, 3">
                                                <small class="text-muted"><%= t('vote_admin.slotLabelsHint') %></small>
                                            </div>
                                            <button type="button" class="btn btn-sm btn-success js-save-q" data-qid="<%= q._id %>">
                                                <i class="fa fa-save"></i> <%= t('vote_admin.saveQuestion') %>
                                            </button>
                                        </div>
                                    </div>
                                </div>
                            <% }) %>
                            </div>

                            <div class="results-block mt-4">
                                <h5 class="mb-1"><%= t('vote_admin.resultsTitle') %></h5>
                                <p class="text-muted small mb-3">
                                    <%= t('vote_admin.totalBallots') %>: <strong><%= results.ballotCount %></strong>
                                    · <%= t('vote_admin.resultsStaticHint') %>
                                </p>
                                <% (results.questions || []).forEach(function(q, qi) { %>
                                    <div class="mb-4">
                                        <h6 class="mb-2"><%= qi + 1 %>. <%= q.title || ('Q' + (qi + 1)) %></h6>
                                        <% (q.slots || []).forEach(function(s) { %>
                                            <div class="mb-2">
                                                <div class="d-flex justify-content-between small">
                                                    <span><%= s.label %></span>
                                                    <span><%= s.votes %> <%= t('vote_admin.voteUnit') %> (<%= s.percentage %>%)</span>
                                                </div>
                                                <div class="slot-bar"><span style="width:<%= s.percentage %>%"></span></div>
                                            </div>
                                        <% }) %>
                                    </div>
                                <% }) %>

                                <hr>
                                <h6 class="mb-2"><%= t('vote_admin.clearBallotTitle') %></h6>
                                <p class="text-muted small mb-3"><%= t('vote_admin.clearBallotHint') %></p>
                                <div class="form-inline mb-3" style="gap:8px; flex-wrap:wrap;">
                                    <input type="email" id="clearBallotEmail" class="form-control form-control-sm" style="min-width:240px;" placeholder="guest@example.com">
                                    <button type="button" class="btn btn-sm btn-warning" id="clearBallotByEmailBtn">
                                        <i class="fa fa-undo"></i> <%= t('vote_admin.clearBallotBtn') %>
                                    </button>
                                </div>
                                <% if (typeof ballots !== 'undefined' && ballots && ballots.length) { %>
                                    <div class="table-responsive" style="max-height:280px; overflow:auto;">
                                        <table class="table table-sm table-bordered mb-0">
                                            <thead>
                                                <tr>
                                                    <th>Email</th>
                                                    <th>Name</th>
                                                    <th>Voted at</th>
                                                    <th></th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <% ballots.forEach(function(b) { %>
                                                    <tr>
                                                        <td><%= b.userEmail || '-' %></td>
                                                        <td><%= b.userName || '-' %></td>
                                                        <td><%= b.votedAt ? new Date(b.votedAt).toLocaleString('en-HK', { timeZone: 'Asia/Hong_Kong', hour12: false }) : '-' %></td>
                                                        <td>
                                                            <button type="button" class="btn btn-xs btn-outline-danger js-clear-ballot" data-ballot-id="<%= b._id %>" data-email="<%= b.userEmail %>">
                                                                <%= t('vote_admin.clearBallotBtn') %>
                                                            </button>
                                                        </td>
                                                    </tr>
                                                <% }) %>
                                            </tbody>
                                        </table>
                                    </div>
                                <% } else { %>
                                    <p class="text-muted small mb-0"><%= t('vote_admin.noBallots') %></p>
                                <% } %>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include ("components/footer") %>
<script>
jQuery(function ($) {
    var eventId = '<%= eventId %>';
    var msg = {
        updateFailed: <%- JSON.stringify(t('vote_admin.updateFailed')) %>,
        saveFailed: <%- JSON.stringify(t('vote_admin.saveFailed')) %>,
        uploadFailed: <%- JSON.stringify(t('vote_admin.uploadFailed')) %>,
        saved: <%- JSON.stringify(t('vote_admin.saved')) %>,
        reorderFailed: <%- JSON.stringify(t('vote_admin.reorderFailed')) %>,
        clearConfirm: <%- JSON.stringify(t('vote_admin.clearBallotConfirm')) %>,
        clearFailed: <%- JSON.stringify(t('vote_admin.clearBallotFailed')) %>,
        clearOk: <%- JSON.stringify(t('vote_admin.clearBallotOk')) %>,
        clearNeedEmail: <%- JSON.stringify(t('vote_admin.clearNeedEmail')) %>
    };

    function clearBallot(payload) {
        return $.ajax({
            url: '/votes/' + eventId + '/ballots/clear',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify(payload)
        });
    }

    $('#clearBallotByEmailBtn').on('click', function () {
        var email = ($('#clearBallotEmail').val() || '').trim();
        if (!email) {
            alert(msg.clearNeedEmail);
            return;
        }
        if (!confirm(msg.clearConfirm)) return;
        clearBallot({ email: email })
            .done(function () {
                alert(msg.clearOk);
                location.reload();
            })
            .fail(function (xhr) {
                alert((xhr.responseJSON && xhr.responseJSON.message) || msg.clearFailed);
            });
    });

    $(document).on('click', '.js-clear-ballot', function () {
        if (!confirm(msg.clearConfirm)) return;
        var ballotId = $(this).data('ballot-id');
        var email = $(this).data('email');
        clearBallot({ ballotId: ballotId, email: email })
            .done(function () {
                alert(msg.clearOk);
                location.reload();
            })
            .fail(function (xhr) {
                alert((xhr.responseJSON && xhr.responseJSON.message) || msg.clearFailed);
            });
    });

    $('#voteSettingsForm').on('submit', function (e) {
        e.preventDefault();
        $.ajax({
            url: '/votes/' + eventId + '/settings',
            method: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify({
                title: $('#title').val(),
                description: $('#description').val(),
                headerRight: $('#headerRight').val(),
                gateTitle: $('#gateTitle').val(),
                pickHint: $('#pickHint').val(),
                submitLabel: $('#submitLabel').val(),
                doneTitle: $('#doneTitle').val(),
                isActive: $('#isActive').is(':checked')
            }),
            success: function () { alert(msg.saved); },
            error: function (xhr) {
                alert((xhr.responseJSON && xhr.responseJSON.message) || msg.updateFailed);
            }
        });
    });

    $(document).on('click', '.js-save-q', function () {
        var qid = $(this).data('qid');
        var $card = $('[data-question-id="' + qid + '"]');
        var title = $card.find('.js-q-title').val();
        var slotCount = Number($card.find('.js-q-slots').val()) || 1;
        var labelsRaw = ($card.find('.js-q-labels').val() || '').split(',').map(function (s) { return s.trim(); }).filter(Boolean);
        var payload = { title: title, slotCount: slotCount };
        if (labelsRaw.length) payload.slotLabels = labelsRaw;

        $.ajax({
            url: '/votes/' + eventId + '/questions/' + qid,
            method: 'PUT',
            contentType: 'application/json',
            data: JSON.stringify(payload),
            success: function () { location.reload(); },
            error: function (xhr) {
                alert((xhr.responseJSON && xhr.responseJSON.message) || msg.saveFailed);
            }
        });
    });

    $(document).on('change', '.js-kv-upload', function () {
        var qid = $(this).data('qid');
        var file = this.files && this.files[0];
        if (!file) return;
        var fd = new FormData();
        fd.append('kv', file);
        $.ajax({
            url: '/votes/' + eventId + '/questions/' + qid + '/kv',
            method: 'POST',
            data: fd,
            processData: false,
            contentType: false,
            success: function () { location.reload(); },
            error: function (xhr) {
                alert((xhr.responseJSON && xhr.responseJSON.message) || msg.uploadFailed);
            }
        });
    });

    // Drag & drop reorder — only from handle (avoid breaking file/text inputs)
    var $list = $('#voteQuestionList');
    var dragEl = null;

    $list.on('dragstart', '.vote-q-handle', function (e) {
        dragEl = $(this).closest('.vote-q-card')[0];
        if (!dragEl) return;
        $(dragEl).addClass('is-dragging');
        if (e.originalEvent && e.originalEvent.dataTransfer) {
            e.originalEvent.dataTransfer.effectAllowed = 'move';
            e.originalEvent.dataTransfer.setData('text/plain', $(dragEl).data('question-id'));
        }
    });

    $list.on('dragend', '.vote-q-handle', function () {
        if (dragEl) $(dragEl).removeClass('is-dragging');
        dragEl = null;
        persistOrder();
    });

    $list.on('dragover', '.vote-q-card', function (e) {
        e.preventDefault();
        if (!dragEl || dragEl === this) return;
        var $target = $(this);
        var mid = $target.offset().top + $target.outerHeight() / 2;
        var y = e.originalEvent.clientY;
        if (y < mid) $target.before(dragEl);
        else $target.after(dragEl);
        refreshOrderLabels();
    });

    $list.on('drop', '.vote-q-card', function (e) {
        e.preventDefault();
    });

    function refreshOrderLabels() {
        $list.find('.vote-q-card').each(function (i) {
            $(this).find('.js-q-order-label').text('<%= t("vote_admin.questionN") %> ' + (i + 1));
        });
    }

    var reorderTimer = null;
    function persistOrder() {
        clearTimeout(reorderTimer);
        reorderTimer = setTimeout(function () {
            var order = [];
            $list.find('.vote-q-card').each(function () {
                order.push(String($(this).data('question-id')));
            });
            $.ajax({
                url: '/votes/' + eventId + '/questions/reorder',
                method: 'PUT',
                contentType: 'application/json',
                data: JSON.stringify({ order: order }),
                error: function (xhr) {
                    alert((xhr.responseJSON && xhr.responseJSON.message) || msg.reorderFailed);
                }
            });
        }, 200);
    }
});
</script>
