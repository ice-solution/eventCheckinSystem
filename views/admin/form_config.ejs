    function applyMetaToFormConfig(meta) {
        if (!meta) return;
        Object.keys(meta).forEach(function(key) {
            formConfig[key] = meta[key];
        });
    }

    function buildExportableConfig() {
        const meta = collectMetaConfigFromForm();
        applyMetaToFormConfig(meta);
        return {
            defaultLanguage: formConfig.defaultLanguage || 'zh',
            languageSwitcherEnabled: meta.languageSwitcherEnabled,
            registerPageEnabled: meta.registerPageEnabled,
            registerClosedMessage: meta.registerClosedMessage,
            registerSlug: meta.registerSlug,
            eventDisplayName: meta.eventDisplayName,
            registerSubHeader: meta.registerSubHeader,
            registerSubtitle: meta.registerSubtitle,
            terms: meta.terms,
            agreement: meta.agreement,
            agreements: meta.agreements,
            thankYou: meta.thankYou,
            paymentTicketUi: meta.paymentTicketUi,
            sections: (formConfig.sections || []).map(function(section) {
                return {
                    sectionName: section.sectionName,
                    sectionTitle: section.sectionTitle,
                    visible: section.visible,
                    order: section.order || 0,
                    fields: (section.fields || []).map(function(field) {
                        return {
                            fieldName: field.fieldName,
                            label: field.label,
                            type: field.type,
                            required: field.required,
                            confirmEmail: !!field.confirmEmail,
                            display: field.display !== undefined ? field.display : field.visible !== false,
                            visible: field.visible,
                            placeholder: field.placeholder,
                            options: (field.options || []).map(function(opt) {
                                return {
                                    value: opt.value,
                                    label: opt.label,
                                    isOther: !!opt.isOther
                                };
                            }),
                            validation: field.validation || {},
                            order: field.order || 0
                        };
                    })
                };
            })
        };
    }

    // 儲存配置
    async function saveConfig() {
        try {
            const meta = collectMetaConfigFromForm();
            applyMetaToFormConfig(meta);
            const response = await fetch('/formConfig/' + eventId + '/config', {
                method: 'PUT',
                headers: {
                    'Content-Type': 'application/json',
                },
                body: JSON.stringify({
                    sections: formConfig.sections,
                    defaultLanguage: formConfig.defaultLanguage,
                    languageSwitcherEnabled: meta.languageSwitcherEnabled,
                    registerPageEnabled: meta.registerPageEnabled,
                    registerClosedMessage: meta.registerClosedMessage,
                    registerSlug: meta.registerSlug,
                    eventDisplayName: meta.eventDisplayName,
                    registerSubHeader: meta.registerSubHeader,
                    registerSubtitle: meta.registerSubtitle,
                    terms: meta.terms,
                    agreement: meta.agreement,
                    agreements: meta.agreements,
                    thankYou: meta.thankYou,
                    paymentTicketUi: meta.paymentTicketUi
                })
            });
            
            const result = await response.json();
            if (result.success) {
                if (result.formConfig && typeof result.formConfig.languageSwitcherEnabled === 'boolean') {
                    formConfig.languageSwitcherEnabled = result.formConfig.languageSwitcherEnabled;
                }
                if (result.formConfig && typeof result.formConfig.registerSlug === 'string') {
                    formConfig.registerSlug = result.formConfig.registerSlug;
                    setInputValue('registerSlug', result.formConfig.registerSlug);
                } else if (result.formConfig && !result.formConfig.registerSlug) {
                    formConfig.registerSlug = '';
                    setInputValue('registerSlug', '');
                }
                updateRegisterSlugPreview();
                showAlert('success', '<%= t("form_config.savedSuccess") %>');
            } else {
                console.error('儲存失敗：' + result.message);
                throw new Error(result.message);
            }
        } catch (error) {
            console.error('儲存失敗：' + error.message);
            throw error;
        }
    }

    // 重置為預設
    async function resetToDefault() {
        if (confirm('確定要重置為預設配置嗎？這將覆蓋所有現有設定。')) {
            try {
                const response = await fetch('/formConfig/' + eventId + '/reset', {
                    method: 'POST'
                });
                
                const result = await response.json();
                if (result.success) {
                    alert('已重置為預設配置！');
                    location.reload();
                } else {
                    alert('重置失敗：' + result.message);
                }
            } catch (error) {
                alert('重置失敗：' + error.message);
            }
        }
    }

    // 更新區塊屬性
    function updateSectionProperty(sectionIndex, property, value) {
        if (formConfig.sections[sectionIndex]) {
            formConfig.sections[sectionIndex][property] = value;
            updatePreview();
        }
    }

    // 導出配置為 JSON
    function exportConfig() {
        try {
            const exportData = buildExportableConfig();
            
            // 轉換為 JSON 字符串
            const jsonString = JSON.stringify(exportData, null, 2);
            
            // 創建下載鏈接
            const blob = new Blob([jsonString], { type: 'application/json' });
            const url = URL.createObjectURL(blob);
            const a = document.createElement('a');
            a.href = url;
            a.download = `formConfig_${eventId}_${new Date().toISOString().split('T')[0]}.json`;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
            
            alert('配置已成功導出！');
        } catch (error) {
            console.error('導出失敗:', error);
            alert('導出失敗：' + error.message);
        }
    }

    // 導入配置從 JSON
    function importConfig(event) {
        const file = event.target.files[0];
        if (!file) {
            return;
        }
        
        const reader = new FileReader();
        reader.onload = function(e) {
            try {
                const importedData = JSON.parse(e.target.result);
                
                // 驗證導入的數據結構
                if (!importedData.sections || !Array.isArray(importedData.sections)) {
                    throw new Error('無效的配置文件格式：缺少 sections 數組');
                }
                
                // 確認導入
                if (confirm('確定要導入此配置嗎？這將覆蓋現有的表單配置。')) {
                    // 更新 formConfig meta
                    formConfig.defaultLanguage = importedData.defaultLanguage || formConfig.defaultLanguage;
                    if (typeof importedData.languageSwitcherEnabled === 'boolean') {
                        formConfig.languageSwitcherEnabled = importedData.languageSwitcherEnabled;
                    }
                    if (typeof importedData.registerPageEnabled === 'boolean') {
                        formConfig.registerPageEnabled = importedData.registerPageEnabled;
                    }
                    if (typeof importedData.registerClosedMessage === 'string') {
                        formConfig.registerClosedMessage = importedData.registerClosedMessage;
                    }
                    if (typeof importedData.registerSlug === 'string') {
                        formConfig.registerSlug = importedData.registerSlug;
                    }
                    formConfig.terms = importedData.terms || formConfig.terms || {
                        enabled: false,
                        title: { zh: '條款與細則', en: 'Terms & Conditions' },
                        linkLabel: { zh: '(條款)', en: '(terms)' },
                        showLinkLabel: true,
                        label: { zh: '', en: '' },
                        content: { zh: '', en: '' }
                    };
                    formConfig.agreement = importedData.agreement || formConfig.agreement || {
                        enabled: false,
                        title: { zh: '協議', en: 'Agreement' },
                        linkLabel: { zh: '(協議)', en: '(agreement)' },
                        showLinkLabel: true,
                        label: { zh: '', en: '' },
                        content: { zh: '', en: '' }
                    };
                    if (Array.isArray(importedData.agreements) && importedData.agreements.length) {
                        formConfig.agreements = importedData.agreements;
                    } else {
                        formConfig.agreements = [JSON.parse(JSON.stringify(formConfig.agreement))];
                    }
                    formConfig.thankYou = importedData.thankYou || formConfig.thankYou || {
                        title: { zh: '感謝你參加！', en: 'Thank you for participating!' },
                        message: { zh: '我們會透過 Email 把資訊發送給你。', en: 'We will send the information to you via Email.' },
                        purchaseTitle: { zh: '感謝您的購票！', en: 'Thank you for your purchase!' },
                        purchaseMessage: {
                            zh: '您的付款已成功，以下是您的交易紀錄：',
                            en: 'Your payment was successful. Here are your transaction details:'
                        },
                        yesNoQuestion: {
                            enabled: false,
                            question: { zh: '', en: '' },
                            yesLabel: { zh: '是', en: 'Yes' },
                            noLabel: { zh: '否', en: 'No' },
                            yesEmailTemplateId: '',
                            noEmailTemplateId: '',
                            yesTitle: { zh: '', en: '' },
                            yesMessage: { zh: '', en: '' },
                            yesPurchaseTitle: { zh: '', en: '' },
                            yesPurchaseMessage: { zh: '', en: '' },
                            noTitle: { zh: '', en: '' },
                            noMessage: { zh: '', en: '' },
                            noPurchaseTitle: { zh: '', en: '' },
                            noPurchaseMessage: { zh: '', en: '' }
                        }
                    };
                    formConfig.eventDisplayName = importedData.eventDisplayName || formConfig.eventDisplayName || { zh: '', en: '' };
                    formConfig.registerSubHeader = importedData.registerSubHeader || formConfig.registerSubHeader || { zh: '', en: '' };
                    formConfig.registerSubtitle = importedData.registerSubtitle || formConfig.registerSubtitle || {
                        zh: '請填寫以下資料完成活動報名',
                        en: 'Please fill in the following information to complete event registration'
                    };
                    if (importedData.paymentTicketUi) {
                        formConfig.paymentTicketUi = importedData.paymentTicketUi;
                    }
                    formConfig.sections = importedData.sections.map(section => ({
                        sectionName: section.sectionName || '新區塊',
                        sectionTitle: section.sectionTitle || { zh: '新區塊', en: 'New Section' },
                        visible: section.visible !== undefined ? section.visible : true,
                        order: section.order || 0,
                        fields: (section.fields || []).map(field => {
                            const disp = field.display !== undefined ? field.display : (field.visible !== undefined ? field.visible : true);
                            return {
                            fieldName: field.fieldName || 'newField',
                            label: field.label || { zh: '', en: '' },
                            type: field.type || 'text',
                            required: field.required || false,
                            confirmEmail: !!field.confirmEmail,
                            display: disp,
                            visible: disp,
                            placeholder: field.placeholder || { zh: '', en: '' },
                            options: (field.options || []).map(function(opt) {
                                return {
                                    value: opt.value,
                                    label: opt.label || { zh: '', en: '' },
                                    isOther: !!opt.isOther
                                };
                            }),
                            validation: field.validation || {},
                            order: field.order || 0
                        };
                        })
                    }));
                    
                    // 保存配置（會再從 DOM 收集；先把導入值寫回 DOM）
                    applyImportedMetaToDom(importedData);
                    saveConfig().then(() => {
                        alert('配置已成功導入！');
                        location.reload();
                    }).catch(error => {
                        console.error('保存失敗:', error);
                        alert('導入失敗：' + error.message);
                    });
                }
            } catch (error) {
                console.error('導入失敗:', error);
                alert('導入失敗：' + error.message + '\n請確保文件是有效的 JSON 格式。');
            }
        };
        
        reader.readAsText(file);
        // 重置文件輸入，以便可以再次選擇同一個文件
        event.target.value = '';
    }

    function setInputValue(id, value) {
        const el = document.getElementById(id);
        if (!el || value == null) return;
        if (el.type === 'checkbox') {
            el.checked = !!value;
        } else {
            el.value = value;
        }
    }

    function applyImportedMetaToDom(data) {
        if (!data) return;
        if (typeof data.languageSwitcherEnabled === 'boolean') setInputValue('languageSwitcherEnabled', data.languageSwitcherEnabled);
        if (typeof data.registerPageEnabled === 'boolean') setInputValue('registerPageEnabled', data.registerPageEnabled);
        if (typeof data.registerClosedMessage === 'string') setInputValue('registerClosedMessage', data.registerClosedMessage);
        if (typeof data.registerSlug === 'string') setInputValue('registerSlug', data.registerSlug);
        updateRegisterSlugPreview();
        const edn = data.eventDisplayName || {};
        setInputValue('eventDisplayNameZh', edn.zh || '');
        setInputValue('eventDisplayNameEn', edn.en || '');
        const rsh = data.registerSubHeader || {};
        setInputValue('registerSubHeaderZh', rsh.zh || '');
        setInputValue('registerSubHeaderEn', rsh.en || '');
        const rst = data.registerSubtitle || {};
        setInputValue('registerSubtitleZh', rst.zh || '');
        setInputValue('registerSubtitleEn', rst.en || '');

        const t = data.terms || {};
        setInputValue('termsEnabled', !!t.enabled);
        setInputValue('termsTitleZh', (t.title && t.title.zh) || '');
        setInputValue('termsTitleEn', (t.title && t.title.en) || '');
        setInputValue('termsShowLinkLabel', t.showLinkLabel !== false);
        setInputValue('termsLinkLabelZh', (t.linkLabel && t.linkLabel.zh) || '');
        setInputValue('termsLinkLabelEn', (t.linkLabel && t.linkLabel.en) || '');
        setInputValue('termsLabelZh', (t.label && t.label.zh) || '');
        setInputValue('termsLabelEn', (t.label && t.label.en) || '');
        setInputValue('termsContentZh', (t.content && t.content.zh) || '');
        setInputValue('termsContentEn', (t.content && t.content.en) || '');

        const a = data.agreements && data.agreements.length ? data.agreements : (data.agreement ? [data.agreement] : [defaultAgreementItem()]);
        renderAgreementsList(a);

        const ty = data.thankYou || {};
        setInputValue('thankYouTitleZh', (ty.title && ty.title.zh) || '');
        setInputValue('thankYouTitleEn', (ty.title && ty.title.en) || '');
        setInputValue('thankYouMessageZh', (ty.message && ty.message.zh) || '');
        setInputValue('thankYouMessageEn', (ty.message && ty.message.en) || '');
        setInputValue('thankYouPurchaseTitleZh', (ty.purchaseTitle && ty.purchaseTitle.zh) || '');
        setInputValue('thankYouPurchaseTitleEn', (ty.purchaseTitle && ty.purchaseTitle.en) || '');
        setInputValue('thankYouPurchaseMessageZh', (ty.purchaseMessage && ty.purchaseMessage.zh) || '');
        setInputValue('thankYouPurchaseMessageEn', (ty.purchaseMessage && ty.purchaseMessage.en) || '');
        const ynq = ty.yesNoQuestion || {};
        setInputValue('thankYouYesNoEnabled', !!ynq.enabled);
        setInputValue('thankYouYesNoQuestionZh', (ynq.question && ynq.question.zh) || '');
        setInputValue('thankYouYesNoQuestionEn', (ynq.question && ynq.question.en) || '');
        setInputValue('thankYouYesLabelZh', (ynq.yesLabel && ynq.yesLabel.zh) || '');
        setInputValue('thankYouYesLabelEn', (ynq.yesLabel && ynq.yesLabel.en) || '');
        setInputValue('thankYouNoLabelZh', (ynq.noLabel && ynq.noLabel.zh) || '');
        setInputValue('thankYouNoLabelEn', (ynq.noLabel && ynq.noLabel.en) || '');
        setInputValue('thankYouYesEmailTemplateId', ynq.yesEmailTemplateId || '');
        setInputValue('thankYouNoEmailTemplateId', ynq.noEmailTemplateId || '');
        setInputValue('thankYouYesTitleZh', (ynq.yesTitle && ynq.yesTitle.zh) || '');
        setInputValue('thankYouYesTitleEn', (ynq.yesTitle && ynq.yesTitle.en) || '');
        setInputValue('thankYouYesMessageZh', (ynq.yesMessage && ynq.yesMessage.zh) || '');
        setInputValue('thankYouYesMessageEn', (ynq.yesMessage && ynq.yesMessage.en) || '');
        setInputValue('thankYouYesPurchaseTitleZh', (ynq.yesPurchaseTitle && ynq.yesPurchaseTitle.zh) || '');
        setInputValue('thankYouYesPurchaseTitleEn', (ynq.yesPurchaseTitle && ynq.yesPurchaseTitle.en) || '');
        setInputValue('thankYouYesPurchaseMessageZh', (ynq.yesPurchaseMessage && ynq.yesPurchaseMessage.zh) || '');
        setInputValue('thankYouYesPurchaseMessageEn', (ynq.yesPurchaseMessage && ynq.yesPurchaseMessage.en) || '');
        setInputValue('thankYouNoTitleZh', (ynq.noTitle && ynq.noTitle.zh) || '');
        setInputValue('thankYouNoTitleEn', (ynq.noTitle && ynq.noTitle.en) || '');
        setInputValue('thankYouNoMessageZh', (ynq.noMessage && ynq.noMessage.zh) || '');
        setInputValue('thankYouNoMessageEn', (ynq.noMessage && ynq.noMessage.en) || '');
        setInputValue('thankYouNoPurchaseTitleZh', (ynq.noPurchaseTitle && ynq.noPurchaseTitle.zh) || '');
        setInputValue('thankYouNoPurchaseTitleEn', (ynq.noPurchaseTitle && ynq.noPurchaseTitle.en) || '');
        setInputValue('thankYouNoPurchaseMessageZh', (ynq.noPurchaseMessage && ynq.noPurchaseMessage.zh) || '');
        setInputValue('thankYouNoPurchaseMessageEn', (ynq.noPurchaseMessage && ynq.noPurchaseMessage.en) || '');

        const pt = data.paymentTicketUi || {};
        if (pt.sectionTitle) {
            setInputValue('ptSectionTitleZh', pt.sectionTitle.zh || '');
            setInputValue('ptSectionTitleEn', pt.sectionTitle.en || '');
        }
        if (pt.categoryLabel) {
            setInputValue('ptCategoryLabelZh', pt.categoryLabel.zh || '');
            setInputValue('ptCategoryLabelEn', pt.categoryLabel.en || '');
        }
        if (pt.ticketLabel) {
            setInputValue('ptTicketLabelZh', pt.ticketLabel.zh || '');
            setInputValue('ptTicketLabelEn', pt.ticketLabel.en || '');
        }
        if (pt.defaultCategoryLabel) {
            setInputValue('ptDefaultCategoryZh', pt.defaultCategoryLabel.zh || '');
            setInputValue('ptDefaultCategoryEn', pt.defaultCategoryLabel.en || '');
        }
        if (pt.buttons && pt.buttons.back) {
            setInputValue('ptBackBtnZh', pt.buttons.back.zh || '');
            setInputValue('ptBackBtnEn', pt.buttons.back.en || '');
        }
        if (pt.buttons && pt.buttons.next) {
            setInputValue('ptNextBtnZh', pt.buttons.next.zh || '');
            setInputValue('ptNextBtnEn', pt.buttons.next.en || '');
        }
        if (pt.highlightText) {
            setInputValue('ptHighlightZh', pt.highlightText.zh || '');
            setInputValue('ptHighlightEn', pt.highlightText.en || '');
        }
        if (Array.isArray(pt.categoryButtons)) {
            formConfig.paymentTicketUi = formConfig.paymentTicketUi || {};
            formConfig.paymentTicketUi.categoryButtons = pt.categoryButtons;
            if (typeof renderPtCategoryButtonsList === 'function') {
                renderPtCategoryButtonsList();
            }
        }
    }

    // 初始化預覽
    updatePreview();

    // 初始化 T&C UI（載入 formConfig.terms 到表單欄位）
    (function initTermsUi() {
        try {
            const t = formConfig.terms || {};
            const enabledEl = document.getElementById('termsEnabled');
            const titleZhEl = document.getElementById('termsTitleZh');
            const titleEnEl = document.getElementById('termsTitleEn');
            const showLinkEl = document.getElementById('termsShowLinkLabel');
            const linkLabelZhEl = document.getElementById('termsLinkLabelZh');
            const linkLabelEnEl = document.getElementById('termsLinkLabelEn');
            const labelZhEl = document.getElementById('termsLabelZh');
            const labelEnEl = document.getElementById('termsLabelEn');
            const contentZhEl = document.getElementById('termsContentZh');
            const contentEnEl = document.getElementById('termsContentEn');
            if (!enabledEl) return;
            enabledEl.checked = !!t.enabled;
            if (titleZhEl) titleZhEl.value = (t.title && t.title.zh) ? t.title.zh : titleZhEl.value;
            if (titleEnEl) titleEnEl.value = (t.title && t.title.en) ? t.title.en : titleEnEl.value;
            if (showLinkEl) showLinkEl.checked = t.showLinkLabel !== false;
            if (linkLabelZhEl) linkLabelZhEl.value = (t.linkLabel && t.linkLabel.zh) ? t.linkLabel.zh : linkLabelZhEl.value;
            if (linkLabelEnEl) linkLabelEnEl.value = (t.linkLabel && t.linkLabel.en) ? t.linkLabel.en : linkLabelEnEl.value;
            if (labelZhEl) labelZhEl.value = (t.label && t.label.zh) ? t.label.zh : labelZhEl.value;
            if (labelEnEl) labelEnEl.value = (t.label && t.label.en) ? t.label.en : labelEnEl.value;
            if (contentZhEl) contentZhEl.value = (t.content && t.content.zh) ? t.content.zh : contentZhEl.value;
            if (contentEnEl) contentEnEl.value = (t.content && t.content.en) ? t.content.en : contentEnEl.value;
        } catch (_) {}
    })();

    // 初始化 Agreement UI
    renderAgreementsList(formConfig.agreements);
    document.getElementById('addAgreementBtn')?.addEventListener('click', function() {
        const list = collectAgreementsFromDom();
        list.push(defaultAgreementItem());
        renderAgreementsList(list);
    });
    document.getElementById('agreementsList')?.addEventListener('click', function(e) {
        const btn = e.target.closest('.js-agr-remove');
        if (!btn) return;
        const list = collectAgreementsFromDom();
        const row = btn.closest('.js-agreement-item');
        const idx = Array.prototype.indexOf.call(document.querySelectorAll('#agreementsList .js-agreement-item'), row);
        if (idx >= 0 && list.length > 1) {
            list.splice(idx, 1);
            renderAgreementsList(list);
        }
    });
    document.getElementById('agreementsList')?.addEventListener('change', function(e) {
        if (!e.target.classList.contains('js-agr-show-link')) return;
        const wrap = e.target.closest('.js-agreement-item')?.querySelector('.js-agr-link-wrap');
        if (wrap) wrap.style.display = e.target.checked ? '' : 'none';
    });

    (function initLinkLabelVisibilityToggles() {
        function bindToggle(checkboxId, fieldsId) {
            const checkbox = document.getElementById(checkboxId);
            const fields = document.getElementById(fieldsId);
            if (!checkbox || !fields) return;
            const sync = function() {
                fields.style.display = checkbox.checked ? '' : 'none';
            };
            checkbox.addEventListener('change', sync);
            sync();
        }
        bindToggle('termsShowLinkLabel', 'termsLinkLabelWrap');
    })();

    // 初始化 Thank You UI
    (function initThankYouUi() {
        try {
            const ty = formConfig.thankYou || {};
            const setVal = (id, val) => {
                const el = document.getElementById(id);
                if (el && val != null) el.value = val;
            };
            setVal('thankYouTitleZh', ty.title && ty.title.zh);
            setVal('thankYouTitleEn', ty.title && ty.title.en);
            setVal('thankYouMessageZh', ty.message && ty.message.zh);
            setVal('thankYouMessageEn', ty.message && ty.message.en);
            setVal('thankYouPurchaseTitleZh', ty.purchaseTitle && ty.purchaseTitle.zh);
            setVal('thankYouPurchaseTitleEn', ty.purchaseTitle && ty.purchaseTitle.en);
            setVal('thankYouPurchaseMessageZh', ty.purchaseMessage && ty.purchaseMessage.zh);
            setVal('thankYouPurchaseMessageEn', ty.purchaseMessage && ty.purchaseMessage.en);
        } catch (_) {}
    })();

    function renderPtCategoryButtonsList() {
        const list = document.getElementById('ptCategoryButtonsList');
        if (!list) return;
        const rows = formConfig.paymentTicketUi.categoryButtons || [];
        list.innerHTML = '';
        rows.forEach((row, idx) => {
            const div = document.createElement('div');
            div.className = 'row mb-2 pt-cat-row';
            div.dataset.idx = String(idx);
            div.innerHTML =
                '<div class="col-md-2"><input type="text" class="form-control form-control-sm pt-cat-key" placeholder="' + _t.ptCategoryKeyPh + '" value="' + (row.key || '').replace(/"/g, '&quot;') + '"></div>' +
                '<div class="col-md-4"><input type="text" class="form-control form-control-sm pt-cat-label-zh" placeholder="' + _t.ptCategoryLabelZhPh + '" value="' + ((row.label && row.label.zh) || '').replace(/"/g, '&quot;') + '"></div>' +
                '<div class="col-md-4"><input type="text" class="form-control form-control-sm pt-cat-label-en" placeholder="' + _t.ptCategoryLabelEnPh + '" value="' + ((row.label && row.label.en) || '').replace(/"/g, '&quot;') + '"></div>' +
                '<div class="col-md-2"><button type="button" class="btn btn-sm btn-outline-danger pt-cat-remove">' + _t.ptCategoryDelete + '</button></div>';
            list.appendChild(div);
        });
    }

    function syncPtCategoryButtonsFromDom() {
        const rows = [];
        document.querySelectorAll('#ptCategoryButtonsList .pt-cat-row').forEach(el => {
            const key = (el.querySelector('.pt-cat-key').value || '').trim();
            if (!key) return;
            rows.push({
                key,
                label: {
                    zh: (el.querySelector('.pt-cat-label-zh').value || '').trim(),
                    en: (el.querySelector('.pt-cat-label-en').value || '').trim()
                }
            });
        });
        formConfig.paymentTicketUi.categoryButtons = rows;
    }

    function collectPaymentTicketUiFromForm() {
        syncPtCategoryButtonsFromDom();
        return {
            sectionTitle: {
                zh: (document.getElementById('ptSectionTitleZh').value || '').trim(),
                en: (document.getElementById('ptSectionTitleEn').value || '').trim()
            },
            categoryLabel: {
                zh: (document.getElementById('ptCategoryLabelZh').value || '').trim(),
                en: (document.getElementById('ptCategoryLabelEn').value || '').trim()
            },
            ticketLabel: {
                zh: (document.getElementById('ptTicketLabelZh').value || '').trim(),
                en: (document.getElementById('ptTicketLabelEn').value || '').trim()
            },
            defaultCategoryLabel: {
                zh: (document.getElementById('ptDefaultCategoryZh').value || '').trim(),
                en: (document.getElementById('ptDefaultCategoryEn').value || '').trim()
            },
            buttons: {
                back: {
                    zh: (document.getElementById('ptBackBtnZh').value || '').trim(),
                    en: (document.getElementById('ptBackBtnEn').value || '').trim()
                },
                next: {
                    zh: (document.getElementById('ptNextBtnZh').value || '').trim(),
                    en: (document.getElementById('ptNextBtnEn').value || '').trim()
                }
            },
            highlightText: {
                zh: (document.getElementById('ptHighlightZh').value || '').trim(),
                en: (document.getElementById('ptHighlightEn').value || '').trim()
            },
            categoryButtons: formConfig.paymentTicketUi.categoryButtons || []
        };
    }

    document.getElementById('ptAddCategoryBtn')?.addEventListener('click', function() {
        syncPtCategoryButtonsFromDom();
        formConfig.paymentTicketUi.categoryButtons.push({ key: '', label: { zh: '', en: '' } });
        renderPtCategoryButtonsList();
    });
    document.getElementById('ptCategoryButtonsList')?.addEventListener('click', function(e) {
        if (!e.target.classList.contains('pt-cat-remove')) return;
        const row = e.target.closest('.pt-cat-row');
        const idx = parseInt(row.dataset.idx, 10);
        syncPtCategoryButtonsFromDom();
        formConfig.paymentTicketUi.categoryButtons.splice(idx, 1);
        renderPtCategoryButtonsList();
    });

    renderPtCategoryButtonsList();

    // 初始化 eventDisplayName UI
    (function initEventDisplayNameUi() {
        try {
            const n = formConfig.eventDisplayName || {};
            const zhEl = document.getElementById('eventDisplayNameZh');
            const enEl = document.getElementById('eventDisplayNameEn');
            if (zhEl) zhEl.value = n.zh || zhEl.value;
            if (enEl) enEl.value = n.en || enEl.value;
        } catch (_) {}
    })();

    function normalizeRegisterSlugInput(raw) {
        return (raw || '').trim().toLowerCase().replace(/\s+/g, '-');
    }

    function updateRegisterSlugPreview() {
        const slugEl = document.getElementById('registerSlug');
        const row = document.getElementById('registerSlugPreviewRow');
        const link = document.getElementById('registerSlugPreviewLink');
        if (!slugEl || !row || !link) return;
        const slug = normalizeRegisterSlugInput(slugEl.value);
        if (slug) {
            row.classList.remove('d-none');
            link.textContent = '/' + slug;
            link.href = '/' + slug;
        } else {
            row.classList.add('d-none');
            link.textContent = '';
            link.href = '#';
        }
    }

    document.getElementById('registerSlug')?.addEventListener('input', updateRegisterSlugPreview);
    document.getElementById('registerSlug')?.addEventListener('blur', function() {
        this.value = normalizeRegisterSlugInput(this.value);
        updateRegisterSlugPreview();
    });
    updateRegisterSlugPreview();
</script>

<%- include ("components/footer") %>