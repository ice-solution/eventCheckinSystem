<%- include ("components/header") %>
<%- include ("components/menu", {eventId: event._id}) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<style>
    .form-section {
        border: 1px solid #dee2e6;
        border-radius: 8px;
        margin-bottom: 20px;
        padding: 20px;
        background-color: #f8f9fa;
    }
    .field-item {
        border: 1px solid #e9ecef;
        border-radius: 6px;
        margin-bottom: 15px;
        padding: 15px;
        background-color: white;
    }
    .field-controls {
        display: flex;
        gap: 10px;
        margin-bottom: 10px;
    }
    .section-controls {
        display: flex;
        gap: 10px;
        margin-bottom: 15px;
    }
    .hidden-field {
        opacity: 0.5;
    }
    .hidden-section {
        opacity: 0.3;
    }
    .collapsible-card-header {
        cursor: pointer;
        user-select: none;
    }
    .collapsible-card-header:hover {
        background-color: #e9ecef;
    }
    .collapsible-card-header .collapse-icon {
        transition: transform 0.2s;
        display: inline-block;
    }
    .collapsible-card-header[aria-expanded="true"] .collapse-icon {
        transform: rotate(45deg);
    }
</style>
<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header") %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">Form Config - <%= event.name %></strong>
                            <div class="d-flex flex-wrap mt-2" style="gap: 8px;">
                                <button type="button" class="btn btn-sm btn-info" onclick="exportConfig()">
                                    <i class="fas fa-upload"></i> <%= t('form_config.exportJson') %>
                                </button>
                                <button type="button" class="btn btn-sm btn-success" onclick="document.getElementById('importFileInput').click()">
                                    <i class="fas fa-download"></i> <%= t('form_config.importJson') %>
                                </button>
                                <input type="file" id="importFileInput" accept=".json" style="display: none;" onchange="importConfig(event)">
                                <button type="button" class="btn btn-sm btn-secondary" onclick="resetToDefault()">
                                    <i class="fas fa-undo"></i> <%= t('form_config.resetToDefault') %>
                                </button>
                                <button type="button" class="btn btn-sm btn-primary" onclick="saveConfig()">
                                    <i class="fas fa-save"></i> <%= t('form_config.saveConfig') %>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- 事件信息 -->
                            <div class="alert alert-info">
                                <h5><%= event.name %></h5>
                                <p class="mb-0"><%= t('form_config.configureHint') %></p>
                            </div>

                            <!-- 語言設置 -->
                            <div class="card mb-3">
                                <div class="card-header collapsible-card-header" data-toggle="collapse" data-target="#collapseRegisterPage" aria-expanded="false">
                                    <i class="fa fa-plus-circle collapse-icon mr-2 text-primary"></i><h6 class="d-inline mb-0"><%= t('form_config.cardRegisterPageTitle') %></h6>
                                </div>
                                <div id="collapseRegisterPage" class="collapse">
                                <div class="card-body">
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="registerPageEnabled" 
                                               <%= (formConfig.registerPageEnabled !== false) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="registerPageEnabled">
                                            <%= t('form_config.registerPageEnabledLabel') %>
                                        </label>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label"><%= t('form_config.closedMessageLabel') %></label>
                                        <textarea class="form-control" id="registerClosedMessage" rows="4"
                                                  placeholder="<%= t('form_config.closedMessagePlaceholder') %>"><%= (formConfig.registerClosedMessage || '') %></textarea>
                                        <small class="text-muted"><%= t('form_config.closedMessageHint') %></small>
                                    </div>
                                    <div class="mb-2">
                                        <label class="form-label" for="registerSlug"><%= t('form_config.registerSlugLabel') %></label>
                                        <input type="text" class="form-control" id="registerSlug"
                                               value="<%= (formConfig.registerSlug || '') %>"
                                               placeholder="<%= t('form_config.registerSlugPlaceholder') %>"
                                               pattern="[a-z0-9]+(?:-[a-z0-9]+)*"
                                               autocomplete="off">
                                        <small class="text-muted d-block mt-1"><%= t('form_config.registerSlugHint').replace('{{domain}}', (typeof publicDomain !== 'undefined' && publicDomain) ? publicDomain.replace(/\/$/, '') : '') %></small>
                                        <div class="mt-2 small">
                                            <div><strong><%= t('form_config.registerSlugLegacy') %>:</strong>
                                                <a href="/web/<%= event._id %>/register" target="_blank" rel="noopener">/web/<%= event._id %>/register</a>
                                            </div>
                                            <div id="registerSlugPreviewRow" class="<%= (formConfig.registerSlug) ? '' : 'd-none' %>">
                                                <strong><%= t('form_config.registerSlugPreview') %>:</strong>
                                                <a id="registerSlugPreviewLink" href="/<%= formConfig.registerSlug || '' %>" target="_blank" rel="noopener">/<%= formConfig.registerSlug || '' %></a>
                                            </div>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </div>

                            <!-- Event Banner Management（搬到 FormConfig） -->
                            <div class="card mb-3">
                                <div class="card-header collapsible-card-header" data-toggle="collapse" data-target="#collapseBanner" aria-expanded="false">
                                    <i class="fa fa-plus-circle collapse-icon mr-2 text-primary"></i><h6 class="d-inline mb-0"><%= t('form_config.cardBannerTitle') %></h6>
                                </div>
                                <div id="collapseBanner" class="collapse">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-7">
                                            <% if (currentBanner) { %>
                                                <div class="mb-2">
                                                    <img src="<%= currentBanner %>" alt="Current Banner" style="max-width: 100%; max-height: 220px; border-radius: 8px; border: 1px solid #dee2e6;">
                                                </div>
                                                <form action="/events/<%= event._id %>/banner/delete" method="POST"
                                                      onsubmit="return confirm('<%= t('form_config.deleteBannerConfirm') %>')" style="display:inline;">
                                                    <button type="submit" class="btn btn-sm btn-outline-danger">
                                                        <i class="fas fa-trash"></i> <%= t('form_config.deleteBanner') %>
                                                    </button>
                                                </form>
                                            <% } else { %>
                                                <p class="text-muted mb-2"><%= t('form_config.noBanner') %></p>
                                            <% } %>
                                        </div>
                                        <div class="col-md-5">
                                            <form action="/events/<%= event._id %>/banner/upload" method="POST" enctype="multipart/form-data">
                                                <div class="mb-2">
                                                    <label class="form-label"><%= t('form_config.uploadBannerLabel') %></label>
                                                    <input type="file" name="banner" class="form-control" accept="image/png,image/jpeg,image/jpg" required>
                                                </div>
                                                <button type="submit" class="btn btn-sm btn-primary">
                                                    <i class="fas fa-upload"></i> <%= t('form_config.upload') %>
                                                </button>
                                            </form>
                                            <small class="text-muted d-block mt-2"><%= t('form_config.uploadBannerHint') %></small>
                                        </div>
                                    </div>
                                </div>
                                </div>
                            </div>

                            <!-- Register Header Event Name（可覆蓋 event.name） -->
                            <div class="card mb-3">
                                <div class="card-header collapsible-card-header" data-toggle="collapse" data-target="#collapseHeaderName" aria-expanded="false">
                                    <i class="fa fa-plus-circle collapse-icon mr-2 text-primary"></i><h6 class="d-inline mb-0"><%= t('form_config.cardHeaderNameTitle') %></h6>
                                </div>
                                <div id="collapseHeaderName" class="collapse">
                                <div class="card-body">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.eventNameZhLabel') %></label>
                                            <input type="text" class="form-control" id="eventDisplayNameZh"
                                                   value="<%= (formConfig.eventDisplayName && formConfig.eventDisplayName.zh) ? formConfig.eventDisplayName.zh : '' %>"
                                                   placeholder="<%= t('form_config.eventNameZhPlaceholder') %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.eventNameEnLabel') %></label>
                                            <input type="text" class="form-control" id="eventDisplayNameEn"
                                                   value="<%= (formConfig.eventDisplayName && formConfig.eventDisplayName.en) ? formConfig.eventDisplayName.en : '' %>"
                                                   placeholder="<%= t('form_config.eventNameEnPlaceholder') %>">
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-2"><%= t('form_config.eventNameHint') %></small>
                                    <hr class="my-3">
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.subHeaderZhLabel') %></label>
                                            <input type="text" class="form-control" id="registerSubHeaderZh"
                                                   value="<%= (formConfig.registerSubHeader && formConfig.registerSubHeader.zh) ? formConfig.registerSubHeader.zh : '' %>"
                                                   placeholder="<%= t('form_config.subHeaderZhPlaceholder') %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.subHeaderEnLabel') %></label>
                                            <input type="text" class="form-control" id="registerSubHeaderEn"
                                                   value="<%= (formConfig.registerSubHeader && formConfig.registerSubHeader.en) ? formConfig.registerSubHeader.en : '' %>"
                                                   placeholder="<%= t('form_config.subHeaderEnPlaceholder') %>">
                                        </div>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.subtitleZhLabel') %></label>
                                            <input type="text" class="form-control" id="registerSubtitleZh"
                                                   value="<%= (formConfig.registerSubtitle && formConfig.registerSubtitle.zh) ? formConfig.registerSubtitle.zh : '請填寫以下資料完成活動報名' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.subtitleEnLabel') %></label>
                                            <input type="text" class="form-control" id="registerSubtitleEn"
                                                   value="<%= (formConfig.registerSubtitle && formConfig.registerSubtitle.en) ? formConfig.registerSubtitle.en : 'Please fill in the following information to complete event registration' %>">
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-2"><%= t('form_config.subHeaderHint') %></small>
                                </div>
                                </div>
                            </div>

                            <!-- 條款 / T&C 設定 -->
                            <div class="card mb-3">
                                <div class="card-header collapsible-card-header" data-toggle="collapse" data-target="#collapseTerms" aria-expanded="false">
                                    <i class="fa fa-plus-circle collapse-icon mr-2 text-primary"></i><h6 class="d-inline mb-0"><%= t('form_config.cardTermsTitle') %></h6>
                                </div>
                                <div id="collapseTerms" class="collapse">
                                <div class="card-body">
                                    <div class="form-check form-switch mb-3">
                                        <input class="form-check-input" type="checkbox" id="termsEnabled"
                                               <%= (formConfig.terms && formConfig.terms.enabled) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="termsEnabled">
                                            <%= t('form_config.termsEnabledLabel') %>
                                        </label>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.termsTitleZhLabel') %></label>
                                            <input type="text" class="form-control" id="termsTitleZh"
                                                   value="<%= (formConfig.terms && formConfig.terms.title && formConfig.terms.title.zh) ? formConfig.terms.title.zh : '條款與細則' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.termsTitleEnLabel') %></label>
                                            <input type="text" class="form-control" id="termsTitleEn"
                                                   value="<%= (formConfig.terms && formConfig.terms.title && formConfig.terms.title.en) ? formConfig.terms.title.en : 'Terms & Conditions' %>">
                                        </div>
                                    </div>
                                    <div class="form-check form-switch mb-2 mt-3">
                                        <input class="form-check-input" type="checkbox" id="termsShowLinkLabel"
                                               <%= (formConfig.terms && formConfig.terms.showLinkLabel !== false) ? 'checked' : '' %>>
                                        <label class="form-check-label" for="termsShowLinkLabel">
                                            <%= t('form_config.showLinkLabel') %>
                                        </label>
                                    </div>
                                    <div id="termsLinkLabelWrap">
                                    <div class="row" id="termsLinkLabelFields">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.termsLinkLabelZhLabel') %></label>
                                            <input type="text" class="form-control" id="termsLinkLabelZh"
                                                   value="<%= (formConfig.terms && formConfig.terms.linkLabel && formConfig.terms.linkLabel.zh) ? formConfig.terms.linkLabel.zh : '(條款)' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.termsLinkLabelEnLabel') %></label>
                                            <input type="text" class="form-control" id="termsLinkLabelEn"
                                                   value="<%= (formConfig.terms && formConfig.terms.linkLabel && formConfig.terms.linkLabel.en) ? formConfig.terms.linkLabel.en : '(terms)' %>">
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-1 mb-2"><%= t('form_config.termsLinkHint') %></small>
                                    </div>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.checkboxLabelZh') %></label>
                                            <textarea class="form-control" id="termsLabelZh" rows="4"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (formConfig.terms && formConfig.terms.label && formConfig.terms.label.zh) ? formConfig.terms.label.zh : '' %></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.checkboxLabelEn') %></label>
                                            <textarea class="form-control" id="termsLabelEn" rows="4"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (formConfig.terms && formConfig.terms.label && formConfig.terms.label.en) ? formConfig.terms.label.en : '' %></textarea>
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-1 mb-2"><%= t('form_config.termsCheckboxLabelHint') %></small>
                                    <div class="row mt-2">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.termsContentZhLabel') %></label>
                                            <textarea class="form-control" id="termsContentZh" rows="6"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (formConfig.terms && formConfig.terms.content && formConfig.terms.content.zh) ? formConfig.terms.content.zh : '' %></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.termsContentEnLabel') %></label>
                                            <textarea class="form-control" id="termsContentEn" rows="6"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (formConfig.terms && formConfig.terms.content && formConfig.terms.content.en) ? formConfig.terms.content.en : '' %></textarea>
                                        </div>
                                    </div>
                                    <small class="text-muted d-block mt-2"><%= t('form_config.termsHint') %></small>
                                </div>
                                </div>
                            </div>

                            <!-- Agreement（可新增多份） -->
                            <div class="card mb-3">
                                <div class="card-header collapsible-card-header" data-toggle="collapse" data-target="#collapseAgreement" aria-expanded="false">
                                    <i class="fa fa-plus-circle collapse-icon mr-2 text-primary"></i><h6 class="d-inline mb-0"><%= t('form_config.cardAgreementTitle') %></h6>
                                </div>
                                <div id="collapseAgreement" class="collapse">
                                <div class="card-body">
                                    <p class="text-muted small mb-3"><%- t('form_config.agreementHint') %></p>
                                    <%
                                        const _agr0 = (formConfig.agreements && formConfig.agreements[0])
                                            ? formConfig.agreements[0]
                                            : (formConfig.agreement || {});
                                    %>
                                    <div class="row mb-3">
                                        <div class="col-md-6">
                                            <label class="form-label" for="agreementTitleZh"><%= t('form_config.agreementTitleZhLabel') %></label>
                                            <input type="text" class="form-control" id="agreementTitleZh"
                                                   value="<%= (_agr0.title && _agr0.title.zh) ? _agr0.title.zh : '協議' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label" for="agreementTitleEn"><%= t('form_config.agreementTitleEnLabel') %></label>
                                            <input type="text" class="form-control" id="agreementTitleEn"
                                                   value="<%= (_agr0.title && _agr0.title.en) ? _agr0.title.en : 'Agreement' %>">
                                        </div>
                                    </div>
                                    <div id="agreementsList"></div>
                                    <button type="button" class="btn btn-sm btn-outline-primary" id="addAgreementBtn">
                                        <i class="fa fa-plus"></i> <%= t('form_config.addAgreement') %>
                                    </button>
                                </div>
                                </div>
                            </div>

                            <!-- Thank You（報名成功頁文案） -->
                            <div class="card mb-3">
                                <div class="card-header collapsible-card-header" data-toggle="collapse" data-target="#collapseThankYou" aria-expanded="false">
                                    <i class="fa fa-plus-circle collapse-icon mr-2 text-primary"></i><h6 class="d-inline mb-0"><%= t('form_config.cardThankYouTitle') %></h6>
                                </div>
                                <div id="collapseThankYou" class="collapse">
                                <div class="card-body">
                                    <% const ty = (formConfig.thankYou) ? formConfig.thankYou : {}; %>
                                    <% const ynq = (ty.yesNoQuestion) ? ty.yesNoQuestion : {}; %>
                                    <p class="text-muted small mb-3"><%= t('form_config.thankYouHint') %></p>

                                    <h6 class="mb-2"><%= t('form_config.thankYouYesNoSection') %></h6>
                                    <div class="form-check mb-2">
                                        <input class="form-check-input" type="checkbox" id="thankYouYesNoEnabled"
                                               <%= ynq.enabled ? 'checked' : '' %>>
                                        <label class="form-check-label" for="thankYouYesNoEnabled">
                                            <%= t('form_config.thankYouYesNoEnabled') %>
                                        </label>
                                    </div>
                                    <p class="text-muted small mb-3"><%= t('form_config.thankYouYesNoHint') %></p>

                                    <div id="thankYouGeneralSettings"<%= ynq.enabled ? ' style="display:none;"' : '' %>>
                                    <hr class="my-4">
                                    <h6 class="mb-2"><%= t('form_config.thankYouFreeSection') %></h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouTitleZhLabel') %></label>
                                            <input type="text" class="form-control" id="thankYouTitleZh"
                                                   value="<%= (ty.title && ty.title.zh) ? ty.title.zh : '感謝你參加！' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouTitleEnLabel') %></label>
                                            <input type="text" class="form-control" id="thankYouTitleEn"
                                                   value="<%= (ty.title && ty.title.en) ? ty.title.en : 'Thank you for participating!' %>">
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouMessageZhLabel') %></label>
                                            <textarea class="form-control" id="thankYouMessageZh" rows="3"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (ty.message && ty.message.zh) ? ty.message.zh : '我們會透過 Email 把資訊發送給你。' %></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouMessageEnLabel') %></label>
                                            <textarea class="form-control" id="thankYouMessageEn" rows="3"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (ty.message && ty.message.en) ? ty.message.en : 'We will send the information to you via Email.' %></textarea>
                                        </div>
                                    </div>
                                    <hr class="my-4">
                                    <h6 class="mb-2"><%= t('form_config.thankYouPurchaseSection') %></h6>
                                    <div class="row">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouPurchaseTitleZhLabel') %></label>
                                            <input type="text" class="form-control" id="thankYouPurchaseTitleZh"
                                                   value="<%= (ty.purchaseTitle && ty.purchaseTitle.zh) ? ty.purchaseTitle.zh : '感謝您的購票！' %>">
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouPurchaseTitleEnLabel') %></label>
                                            <input type="text" class="form-control" id="thankYouPurchaseTitleEn"
                                                   value="<%= (ty.purchaseTitle && ty.purchaseTitle.en) ? ty.purchaseTitle.en : 'Thank you for your purchase!' %>">
                                        </div>
                                    </div>
                                    <div class="row mt-3">
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouPurchaseMessageZhLabel') %></label>
                                            <textarea class="form-control" id="thankYouPurchaseMessageZh" rows="3"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (ty.purchaseMessage && ty.purchaseMessage.zh) ? ty.purchaseMessage.zh : '您的付款已成功，以下是您的交易紀錄：' %></textarea>
                                        </div>
                                        <div class="col-md-6">
                                            <label class="form-label"><%= t('form_config.thankYouPurchaseMessageEnLabel') %></label>
                                            <textarea class="form-control" id="thankYouPurchaseMessageEn" rows="3"
                                                      placeholder="<%= t('form_config.multilinePlaceholder') %>"><%= (ty.purchaseMessage && ty.purchaseMessage.en) ? ty.purchaseMessage.en : 'Your payment was successful. Here are your transaction details:' %></textarea>
                                        </div>
                                    </div>
                                    </div>

                                    <div id="thankYouYesNoSettings"<%= ynq.enabled ? '' : ' style="display:none;"' %>>
                                    <hr class="my-4">
                                        <div class="row">
                                            <div class="col-md-6">
                                                <label class="form-label"><%= t('form_config.thankYouYesNoQuestionZh') %></label>
                                                <input type="text" class="form-control" id="thankYouYesNoQuestionZh"
                                                       value="<%= (ynq.question && ynq.question.zh) ? ynq.question.zh : '' %>"
                                                       placeholder="<%= t('form_config.thankYouYesNoQuestionZhPh') %>">
                                            </div>
                                            <div class="col-md-6">
                                                <label class="form-label"><%= t('form_config.thankYouYesNoQuestionEn') %></label>
                                                <input type="text" class="form-control" id="thankYouYesNoQuestionEn"
                                                       value="<%= (ynq.question && ynq.question.en) ? ynq.question.en : '' %>"
                                                       placeholder="<%= t('form_config.thankYouYesNoQuestionEnPh') %>">
                                            </div>
                                        </div>
                                        <div class="row mt-3">
                                            <div class="col-md-3">
                                                <label class="form-label"><%= t('form_config.thankYouYesLabelZh') %></label>
                                                <input type="text" class="form-control" id="thankYouYesLabelZh"
                                                       value="<%= (ynq.yesLabel && ynq.yesLabel.zh) ? ynq.yesLabel.zh : '是' %>">
                                            </div>
                                            <div class="col-md-3">
