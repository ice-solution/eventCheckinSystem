<%- include ("components/header") %>
<%- include ("components/menu", { eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">

<style>
    .seating-wrap { display: flex; gap: 16px; min-height: calc(100vh - 200px); align-items: stretch; }
    .seating-sidebar {
        width: 360px; flex-shrink: 0; border: 1px solid #dee2e6; border-radius: 8px; padding: 12px;
        background: #fafafa; max-height: 78vh; overflow: auto;
    }
    .seating-canvas-wrap {
        flex: 1; position: relative; display: flex; flex-direction: column; min-width: 0;
    }
    .seating-canvas-toolbar {
        display: flex; flex-wrap: wrap; align-items: center; gap: 10px;
        margin-bottom: 8px; padding: 8px 10px; background: #f8f9fa; border-radius: 8px;
        border: 1px solid #dee2e6; font-size: 13px;
    }
    .seating-canvas-toolbar input[type="range"] { width: 160px; vertical-align: middle; }
    .seating-canvas-toolbar .toolbar-hint { color: #6c757d; font-size: 12px; max-width: 100%; }
    .seating-canvas-scroll {
        overflow: auto;
        max-height: calc(100vh - 300px);
        min-height: 520px;
        position: relative;
        border: 1px solid #dee2e6;
        border-radius: 8px;
        background: #f0f2f5 url('data:image/svg+xml,<svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 20 20"><path fill="%23e0e3e8" d="M0 0h1v20H0zm19 0h1v20h-1zM0 0h20v1H0zm0 19h20v1H0z"/></svg>');
        background-attachment: local;
    }
    .seating-canvas-scale { display: inline-block; vertical-align: top; min-width: 100%; min-height: 100%; }
    .seating-canvas {
        position: relative;
        width: 1200px;
        height: 900px;
        min-width: 800px;
        min-height: 600px;
        background: transparent;
    }
    .guest-group-title { font-size: 13px; font-weight: 600; color: #495057; margin: 12px 0 6px; padding-bottom: 4px; border-bottom: 1px solid #dee2e6; }
    .guest-row {
        display: flex; align-items: center; justify-content: space-between; gap: 8px;
        padding: 6px 8px; margin-bottom: 6px; background: #fff; border: 1px solid #e9ecef; border-radius: 6px;
        cursor: grab; font-size: 13px;
    }
    .guest-row.dragging { opacity: 0.5; }
    .guest-name { flex: 1; min-width: 0; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
    .companion-stepper { display: inline-flex; align-items: center; border: 1px solid #ced4da; border-radius: 6px; overflow: hidden; background: #fff; }
    .companion-stepper button { width: 28px; height: 28px; border: none; background: #f8f9fa; cursor: pointer; font-size: 16px; line-height: 1; }
    .companion-stepper button:hover { background: #e9ecef; }
    .companion-stepper span { min-width: 28px; text-align: center; font-size: 13px; }
    .stat-line { font-size: 12px; color: #6c757d; margin-bottom: 10px; }
    .round-table {
        position: absolute; width: 340px; min-height: 420px;
        cursor: move; user-select: none;
        z-index: 1;
    }
    .round-table.drag-over .rt-plate { box-shadow: 0 0 0 3px rgba(40,167,69,.45); }
    .rt-toolbar {
        position: relative; z-index: 20;
        display: flex; align-items: center; justify-content: space-between; gap: 6px; flex-wrap: wrap;
        margin-bottom: 8px; padding: 6px 8px; font-size: 12px; font-weight: 600; color: #495057;
        background: #fff; border: 1px solid #dee2e6; border-radius: 6px;
        box-shadow: 0 1px 2px rgba(0,0,0,.04);
    }
    .rt-toolbar .cap-row { display: flex; align-items: center; gap: 4px; margin: 0; font-weight: normal; flex-wrap: wrap; }
    .rt-toolbar .tbl-name {
        width: 110px; padding: 2px 6px; font-size: 12px; height: 30px; line-height: 1.25; font-weight: 600;
    }
    .rt-toolbar .tbl-seat-prefix {
        width: 52px; padding: 2px 4px; font-size: 12px; height: 30px; line-height: 1.25; text-align: center; font-weight: 700;
    }
    .rt-toolbar .cap-row input.tbl-cap {
        width: 52px; padding: 2px 6px; font-size: 12px; height: 30px; line-height: 1.25;
        text-align: center;
        -moz-appearance: textfield;
    }
    .rt-toolbar .cap-row input.tbl-len {
        width: 64px; padding: 2px 6px; font-size: 12px; height: 30px; line-height: 1.25;
        text-align: center;
        -moz-appearance: textfield;
    }
    .rt-toolbar .tbl-scale {
        width: 64px; padding: 2px 4px; font-size: 12px; height: 30px; line-height: 1.25; text-align: center;
    }
    .rt-toolbar select.tbl-prop-type,
    .rt-toolbar select.form-control-sm {
        width: auto;
        min-width: 96px;
        height: 30px !important;
        min-height: 30px !important;
        padding: 2px 24px 2px 8px !important;
        font-size: 12px !important;
        line-height: 1.25 !important;
        box-sizing: border-box;
        overflow: visible;
        vertical-align: middle;
        appearance: auto;
        -webkit-appearance: menulist;
        -moz-appearance: menulist;
    }
    .rt-toolbar .cap-row input.tbl-cap::-webkit-outer-spin-button,
    .rt-toolbar .cap-row input.tbl-cap::-webkit-inner-spin-button,
    .rt-toolbar .cap-row input.tbl-len::-webkit-outer-spin-button,
    .rt-toolbar .cap-row input.tbl-len::-webkit-inner-spin-button {
        -webkit-appearance: none;
        margin: 0;
    }
    .rt-shape-tag {
        font-size: 10px; font-weight: 600; color: #6c757d; background: #e9ecef;
        border-radius: 4px; padding: 1px 6px;
    }
    .rt-stage {
        position: relative;
        margin: 0 auto;
        background: transparent;
    }
    .rt-stage.rt-stage-round {
        width: 340px;
        height: 340px;
        padding: 36px;
        box-sizing: border-box;
    }
    .rt-stage.rt-stage-square {
        padding: 64px 16px 64px;
        box-sizing: border-box;
        min-height: 268px;
    }
    .rt-plate {
        position: relative; width: 280px; height: 280px; margin: 0 auto;
        border-radius: 50%;
        background: radial-gradient(circle at 50% 45%, #fff 0%, #f8f9fb 55%, #eef1f5 100%);
        border: 1px solid #d0d4dc;
        box-shadow: 0 6px 18px rgba(0,0,0,.1), inset 0 0 0 1px rgba(255,255,255,.8);
        z-index: 1;
    }
    .rt-plate.rt-shape-square {
        border-radius: 10px;
        height: 120px;
        background: linear-gradient(180deg, #fff 0%, #f8f9fb 55%, #eef1f5 100%);
    }
    .rt-plate.rt-shape-square::before {
        border-radius: 6px;
        inset: 10px;
    }
    .rt-plate.rt-shape-square .rt-center {
        width: 72px;
        height: 72px;
    }
    .rt-plate.rt-shape-square .rt-center-num {
        font-size: 28px;
    }
    .rt-plate.rt-shape-square .rt-ring-svg {
        width: 72px;
        height: 72px;
    }
    .rt-plate::before {
        content: ''; position: absolute; inset: 14px; border-radius: 50%;
        border: 1px solid rgba(100, 160, 220, .25);
        pointer-events: none;
    }
    .rt-center {
        position: absolute; left: 50%; top: 50%; transform: translate(-50%, -50%);
        width: 112px; height: 112px; text-align: center; z-index: 2; pointer-events: none;
    }
    .rt-center-num {
        position: absolute; left: 50%; top: 50%; transform: translate(-50%, -52%);
        font-size: 36px; font-weight: 700; color: #a67c2d;
        text-shadow: 0 1px 0 rgba(255,255,255,.9); line-height: 1;
    }
    .rt-ring-svg { position: absolute; left: 0; top: 0; width: 112px; height: 112px; transform: rotate(-90deg); }
    .rt-ring-bg { fill: none; stroke: #e2e4e8; stroke-width: 8; }
    .rt-ring-fill { fill: none; stroke: #c9a44a; stroke-width: 8; stroke-linecap: round;
        transition: stroke-dashoffset .35s ease;
    }
    .rt-seats-layer {
        position: absolute; left: 0; top: 0; width: 100%; height: 100%; z-index: 5;
        pointer-events: none;
    }
    .rt-slot {
        position: absolute; width: 62px; height: 62px; margin-left: -31px; margin-top: -31px;
        border-radius: 50%; pointer-events: auto;
        display: flex; flex-direction: column; align-items: center; justify-content: center;
        font-size: 11px; font-weight: 600; text-align: center; line-height: 1.1;
        transition: transform .15s ease, box-shadow .15s ease;
    }
    .rt-slot .rt-seat-no {
        position: absolute; top: -12px; left: 50%; transform: translateX(-50%);
        min-width: 28px; height: 24px; padding: 0 7px;
        border-radius: 12px; background: #212529; color: #fff; font-size: 12px; font-weight: 800;
        line-height: 24px; text-align: center; z-index: 5; box-shadow: 0 1px 3px rgba(0,0,0,.28);
        pointer-events: none; white-space: nowrap;
    }
    .rt-slot.empty {
        border: 2px dashed #b8c0cc; background: rgba(255,255,255,.92); color: #6c757d;
        font-size: 12px; font-weight: 700;
        pointer-events: none;
    }
    .rt-slot.empty .rt-seat-no { background: #6c757d; }
    .rt-slot.guest {
        padding: 10px 2px 4px; overflow: visible;
        border: 3px solid transparent;
        border-top-color: var(--rt-brd, #c9a227);
        border-right-color: var(--rt-brd, #c9a227);
        border-bottom-color: var(--rt-brd, #c9a227);
        background: var(--rt-bg, #e3f0ff); color: #333;
        box-shadow: 0 2px 6px rgba(0,0,0,.12);
        cursor: pointer;
    }
    .rt-slot.guest.rt-swap-pick {
        box-shadow: 0 0 0 3px #007bff, 0 2px 8px rgba(0,123,255,.35);
        z-index: 8;
    }
    .rt-slot.guest .rt-name {
        display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        font-size: 11px; padding: 0 2px; font-weight: 700;
        pointer-events: none;
    }
    .rt-slot.companion {
        background: linear-gradient(180deg, #d9eefc 0%, #c5e3fa 100%);
        border: 1px solid #9cc8e8; color: #1a5a8a; font-size: 10px; font-weight: 700;
        box-shadow: 0 1px 4px rgba(0,0,0,.08);
        pointer-events: none;
        padding-top: 10px;
    }
    .rt-slot.companion .rt-comp-label {
        display: block; max-width: 100%; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
        font-size: 9px; line-height: 1.1; pointer-events: none;
    }
    .rt-slot .rt-remove {
        position: absolute; top: -8px; right: -8px; width: 22px; height: 22px; padding: 0;
        border: 2px solid #fff; border-radius: 50%; background: #dc3545; color: #fff; font-size: 14px; line-height: 18px;
        cursor: pointer; box-shadow: 0 2px 4px rgba(0,0,0,.25); z-index: 6;
        pointer-events: auto; font-weight: 700;
    }
    .rt-slot .rt-remove:hover { background: #a71d2a; transform: scale(1.08); }
    .rt-slot.guest:hover { transform: scale(1.06); z-index: 5; }
    .rt-swap-hint {
        font-size: 11px; color: #007bff; background: #e7f1ff; border: 1px solid #b8d4ff;
        border-radius: 4px; padding: 4px 8px; margin-bottom: 6px;
    }
    .rt-foot {
        position: relative; z-index: 20;
        margin-top: 10px; padding: 6px 8px; text-align: center; font-size: 11px; color: #6c757d;
        background: #fff; border: 1px solid #dee2e6; border-radius: 6px;
    }
    .rt-foot .btn { font-size: 11px; padding: 2px 8px; }
    .rt-assigned {
        position: relative; z-index: 20;
        margin-top: 8px; padding: 8px 10px; background: #fff; border: 1px solid #e9ecef; border-radius: 6px;
        font-size: 12px; max-height: 200px; overflow: auto; text-align: left;
    }
    .rt-assigned-title { font-weight: 700; color: #495057; margin-bottom: 6px; font-size: 12px; }
    .rt-assigned-row {
        display: flex; align-items: flex-start; gap: 6px; padding: 5px 0; border-bottom: 1px solid #f1f3f5;
    }
    .rt-assigned-row:last-child { border-bottom: none; }
    .rt-assigned-row.rt-swap-pick-row { background: #e7f1ff; border-radius: 4px; padding-left: 4px; padding-right: 4px; }
    .rt-assigned-row .seat-badge {
        flex-shrink: 0; min-width: 52px; text-align: center; background: #212529; color: #fff; border-radius: 4px;
        font-size: 11px; font-weight: 800; padding: 2px 6px; line-height: 1.3;
    }
    .rt-assigned-row .meta { flex: 1; min-width: 0; }
    .rt-assigned-row .name { display: block; overflow: hidden; text-overflow: ellipsis; white-space: nowrap; font-weight: 600; }
    .rt-assigned-row .seats-detail { display: block; color: #6c757d; font-size: 11px; margin-top: 1px; }
    .rt-assigned-row .actions { flex-shrink: 0; display: flex; flex-direction: column; gap: 2px; }
    .rt-assigned-row .btn-rm,
    .rt-assigned-row .btn-swap {
        border: none; background: transparent; cursor: pointer;
        font-size: 11px; padding: 0 4px; font-weight: 700; text-align: right;
    }
    .rt-assigned-row .btn-rm { color: #dc3545; }
    .rt-assigned-row .btn-rm:hover { color: #a71d2a; text-decoration: underline; }
    .rt-assigned-row .btn-swap { color: #007bff; }
    .rt-assigned-row .btn-swap:hover { text-decoration: underline; }
    .rt-cap-step { display: inline-flex; align-items: center; gap: 2px; }
    .rt-cap-step button {
        width: 28px; height: 30px; border: 1px solid #ced4da; border-radius: 4px;
        background: #f8f9fa; cursor: pointer; font-weight: 700; line-height: 1;
    }
    .rt-cap-step button:hover { background: #e9ecef; }
    .rt-stage.rt-stage-row {
        padding: 48px 12px 48px; box-sizing: border-box; min-height: 140px;
    }
    .rt-plate.rt-shape-row {
        border-radius: 8px; height: 36px;
        background: linear-gradient(180deg, #fff 0%, #eef1f5 100%);
        border: 1px dashed #adb5bd;
        box-shadow: none;
    }
    .rt-plate.rt-shape-row::before { display: none; }
    .rt-plate.rt-shape-row .rt-center { width: auto; height: auto; }
    .rt-plate.rt-shape-row .rt-center-num {
        position: static; transform: none; font-size: 13px; color: #6c757d;
        white-space: nowrap; padding: 0 8px;
    }
    .rt-plate.rt-shape-row .rt-ring-svg { display: none; }
    .rt-prop {
        min-width: 120px; max-width: 280px;
        border: 2px dashed #c9a227; border-radius: 10px;
        background: repeating-linear-gradient(-45deg, #fffbeb, #fffbeb 8px, #fef3c7 8px, #fef3c7 16px);
        padding: 10px; cursor: move; user-select: none;
    }
    .rt-prop .rt-prop-icon {
        font-size: 22px; text-align: center; line-height: 1.2; margin-bottom: 4px;
    }
    .rt-prop .rt-prop-title {
        font-weight: 800; font-size: 13px; text-align: center; color: #5B4A43;
        word-break: break-word;
    }
    .rt-prop .rt-prop-tag {
        display: block; text-align: center; font-size: 10px; color: #92400e;
        margin-top: 2px; font-weight: 700;
    }
    .rt-prop .rt-prop-hint {
        font-size: 10px; color: #a16207; text-align: center; margin-top: 6px;
    }
    .toolbar-top { margin-bottom: 12px; display: flex; flex-wrap: wrap; gap: 8px; align-items: center; }

    /* 匯出用：只保留枱面／座位／擺設視覺 */
    .seating-canvas.export-clean .rt-toolbar,
    .seating-canvas.export-clean .rt-foot,
    .seating-canvas.export-clean .rt-assigned,
    .seating-canvas.export-clean .rt-remove,
    .seating-canvas.export-clean .rt-swap-hint,
    .seating-canvas.export-clean .rt-prop-hint {
        display: none !important;
    }
    .seating-canvas.export-clean .round-table {
        cursor: default;
    }
    .seating-canvas.export-clean .rt-slot.guest {
        cursor: default;
    }
    /* Prop 匯出格式 */
    .seating-canvas.export-clean .rt-prop.fmt-name .rt-prop-icon,
    .seating-canvas.export-clean .rt-prop.fmt-name .rt-prop-tag,
    .seating-canvas.export-clean .rt-prop.fmt-type .rt-prop-icon,
    .seating-canvas.export-clean .rt-prop.fmt-type .rt-prop-title,
    .seating-canvas.export-clean .rt-prop.fmt-nameType .rt-prop-icon,
    .seating-canvas.export-clean .rt-prop.fmt-iconName .rt-prop-tag,
    .seating-canvas.export-clean .rt-prop.fmt-custom .rt-prop-icon,
    .seating-canvas.export-clean .rt-prop.fmt-custom .rt-prop-tag {
        display: none !important;
    }
    .seating-canvas.export-clean .rt-prop {
        max-width: none;
        padding: 14px 18px;
        background: #fffbeb;
        border: 2px solid #c9a227;
    }
    .seating-canvas.export-clean .rt-prop .rt-prop-title {
        font-size: 16px;
    }
    .seating-canvas.export-clean .rt-prop .rt-prop-tag {
        font-size: 12px;
    }
    #seating-export-host {
        position: fixed;
        left: -100000px;
        top: 0;
        z-index: -1;
        background: #f0f2f5;
        box-sizing: content-box;
    }
</style>

<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header") %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="card">
                <div class="card-header d-flex justify-content-between align-items-center flex-wrap">
                    <strong class="card-title"><%= t('seating.title') %> — <%= eventName || eventId %></strong>
                    <div>
                        <button type="button" class="btn btn-outline-secondary btn-sm" id="btnReloadApi"><%= t('seating.reloadBtn') %></button>
                        <button type="button" class="btn btn-success btn-sm" id="btnSave"><%= t('common.save') %></button>
                    </div>
                </div>
                <div class="card-body">
                    <div class="toolbar-top">
                        <label class="mb-0"><%= t('seating.categoryFieldLabel') %></label>
                        <select id="categoryField" class="form-control form-control-sm" style="width: 260px;"></select>
                        <button type="button" class="btn btn-primary btn-sm" id="btnAddTable"><%= t('seating.addTableBtn') %></button>
                        <button type="button" class="btn btn-outline-primary btn-sm" id="btnAddSquareTable"><%= t('seating.addSquareTableBtn') %></button>
                        <button type="button" class="btn btn-outline-info btn-sm" id="btnAddRowTable"><%= t('seating.addRowTableBtn') %></button>
                        <button type="button" class="btn btn-outline-warning btn-sm" id="btnAddProp"><%= t('seating.addPropBtn') %></button>
                        <span class="stat-line mb-0" id="statUnassignedToolbar"></span>
                    </div>
                    <div id="alertSeating" class="alert alert-danger" style="display:none;"></div>
                    <div class="seating-wrap">
                        <div class="seating-sidebar">
                            <div id="guestListMount"></div>
                        </div>
                        <div class="seating-canvas-wrap" id="canvasWrap">
                            <div class="seating-canvas-toolbar">
                                <span class="mb-0 font-weight-bold"><%= t('seating.canvasLabel') %></span>
                                <label class="mb-0"><%= t('seating.zoomLabel') %></label>
                                <input type="range" id="canvasZoom" min="25" max="100" step="5" value="85" title="<%= t('seating.zoomLabel') %>">
                                <span id="canvasZoomPct" class="text-monospace">85%</span>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="btnZoomFit"><%= t('seating.fitWindowBtn') %></button>
                                <button type="button" class="btn btn-sm btn-outline-primary" id="btnLayoutGrid"><%= t('seating.gridLayoutBtn') %></button>
                                <button type="button" class="btn btn-sm btn-outline-success" id="btnExportZip"><%= t('seating.exportZipBtn') %></button>
                                <span class="toolbar-hint"><%= t('seating.canvasHint') %></span>
                            </div>
                            <div class="seating-canvas-scroll" id="canvasScroll">
                                <div class="seating-canvas-scale" id="seatingCanvasScale" style="transform-origin: 0 0;">
                                    <div class="seating-canvas" id="seatingCanvas"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include ("components/footer") %>
<script src="https://cdnjs.cloudflare.com/ajax/libs/html2canvas/1.4.1/html2canvas.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdn.jsdelivr.net/npm/exceljs@4.4.0/dist/exceljs.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>
<script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js" crossorigin="anonymous" referrerpolicy="no-referrer"></script>

<script>
(function() {
    const eventId = '<%= eventId %>';
    const _SA = {
        unfilledCategory: '<%= t("seating.unfilledCategory") %>',
        noUnassigned: '<%= t("seating.noUnassigned") %>',
        unassignedStat: '<%= t("seating.unassignedStat") %>',
        companions: '<%= t("seating.companions") %>',
        tableNum: '<%= t("seating.tableNum") %>',
        tableNameLabel: '<%= t("seating.tableNameLabel") %>',
        tableNamePlaceholder: '<%= t("seating.tableNamePlaceholder") %>',
        seatLabelPrefixLabel: '<%= t("seating.seatLabelPrefixLabel") %>',
        seatLabelPrefixDefault: '<%= t("seating.seatLabelPrefixDefault") %>',
        seatLabelPrefixHint: '<%= t("seating.seatLabelPrefixHint") %>',
        shapeRound: '<%= t("seating.shapeRound") %>',
        shapeSquare: '<%= t("seating.shapeSquare") %>',
        shapeRow: '<%= t("seating.shapeRow") %>',
        shapeProp: '<%= t("seating.shapeProp") %>',
        scaleLabel: '<%= t("seating.scaleLabel") %>',
        capacityLabel: '<%= t("seating.capacityLabel") %>',
        lengthLabel: '<%= t("seating.lengthLabel") %>',
        propTypeLabel: '<%= t("seating.propTypeLabel") %>',
        propTypeStage: '<%= t("seating.propTypeStage") %>',
        propTypeBuffet: '<%= t("seating.propTypeBuffet") %>',
        propTypeBar: '<%= t("seating.propTypeBar") %>',
        propTypeEntrance: '<%= t("seating.propTypeEntrance") %>',
        propTypeRestroom: '<%= t("seating.propTypeRestroom") %>',
        propTypeFlower: '<%= t("seating.propTypeFlower") %>',
        propTypeOther: '<%= t("seating.propTypeOther") %>',
        propDefaultName: '<%= t("seating.propDefaultName") %>',
        propHint: '<%= t("seating.propHint") %>',
        removePropBtn: '<%= t("seating.removePropBtn") %>',
        seatsPlus: '<%= t("seating.seatsPlus") %>',
        seatsMinus: '<%= t("seating.seatsMinus") %>',
        propExportFormatLabel: '<%= t("seating.propExportFormatLabel") %>',
        propExportFormatName: '<%= t("seating.propExportFormatName") %>',
        propExportFormatType: '<%= t("seating.propExportFormatType") %>',
        propExportFormatNameType: '<%= t("seating.propExportFormatNameType") %>',
        propExportFormatIconName: '<%= t("seating.propExportFormatIconName") %>',
        propExportFormatCustom: '<%= t("seating.propExportFormatCustom") %>',
        propExportTextLabel: '<%= t("seating.propExportTextLabel") %>',
        propExportTextPlaceholder: '<%= t("seating.propExportTextPlaceholder") %>',
        exportCompanionSuffix: '<%= t("seating.exportCompanionSuffix") %>',
        exportColSeat: '<%= t("seating.exportColSeat") %>',
        exportColGuest: '<%= t("seating.exportColGuest") %>',
        seatNum: '<%= t("seating.seatNum") %>',
        emptySlotTitle: '<%= t("seating.emptySlotTitle") %>',
        companionSlotTitle: '<%= t("seating.companionSlotTitle") %>',
        clickToUnassign: '<%= t("seating.clickToUnassign") %>',
        removeFromTable: '<%= t("seating.removeFromTable") %>',
        swapSeatsBtn: '<%= t("seating.swapSeatsBtn") %>',
        swapPickHint: '<%= t("seating.swapPickHint") %>',
        swapDone: '<%= t("seating.swapDone") %>',
        assignedListTitle: '<%= t("seating.assignedListTitle") %>',
        seatLabelShort: '<%= t("seating.seatLabelShort") %>',
        seatRangeLabel: '<%= t("seating.seatRangeLabel") %>',
        guestSeatDetail: '<%= t("seating.guestSeatDetail") %>',
        guestSeatDetailSolo: '<%= t("seating.guestSeatDetailSolo") %>',
        companionOf: '<%= t("seating.companionOf") %>',
        occupiedStat: '<%= t("seating.occupiedStat") %>',
        removeTableBtn: '<%= t("seating.removeTableBtn") %>',
        tableFullError: '<%= t("seating.tableFullError") %>',
        saved: '<%= t("seating.saved") %>',
        saveFailed: '<%= t("seating.saveFailed") %>',
        loadFailed: '<%= t("seating.loadFailed") %>',
        exportZipBtn: '<%= t("seating.exportZipBtn") %>',
        exportFailed: '<%= t("seating.exportFailed") %>',
        exportLoadError: '<%= t("seating.exportLoadError") %>',
        exportColTable: '<%= t("seating.exportColTable") %>',
        exportColCompany: '<%= t("seating.exportColCompany") %>',
        exportSheetName: '<%= t("seating.exportSheetName") %>',
        exportEmptyCompany: '<%= t("seating.exportEmptyCompany") %>',
        exportDone: '<%= t("seating.exportDone") %>',
        gridLayoutConfirm: '<%= t("seating.gridLayoutConfirm") %>',
        noTablesAlert: '<%= t("seating.noTablesAlert") %>'
    };
    let users = <%- usersJson %>;
    let formFields = <%- formFieldsJson %>;
    let state = {
        categoryFieldName: 'company',
        companionByUserId: {},
        tables: []
    };
    (function initState() {
        const initial = <%- seatingJson %>;
        if (initial) {
            state.categoryFieldName = initial.categoryFieldName || 'company';
            // 舊版全場 seatLabelPrefix → 遷移到每桌（若該桌未設）
            var legacyPrefix = (initial.seatLabelPrefix != null ? String(initial.seatLabelPrefix) : '').trim().slice(0, 12);
            state.companionByUserId = initial.companionByUserId || {};
            state.tables = (initial.tables || []).map(function(t) {
                var p = (t.seatLabelPrefix != null ? String(t.seatLabelPrefix) : '').trim().slice(0, 12);
                if (!p && legacyPrefix) p = legacyPrefix;
                var shape = (t.shape === 'square' || t.shape === 'row' || t.shape === 'prop') ? t.shape : 'round';
                return {
                    id: t.id,
                    name: (t.name != null ? String(t.name) : '').trim(),
                    seatLabelPrefix: shape === 'prop' ? '' : p,
                    shape: shape,
                    scale: Math.max(0.5, Math.min(2, parseFloat(t.scale) || 1)),
                    length: Math.max(80, Math.min(1200, parseInt(t.length, 10) || (shape === 'row' ? 520 : shape === 'prop' ? 160 : 360))),
                    propType: t.propType || (shape === 'prop' ? 'other' : ''),
                    propExportFormat: t.propExportFormat || (shape === 'prop' ? 'nameType' : ''),
                    propExportText: (t.propExportText != null ? String(t.propExportText) : '').trim(),
                    x: t.x,
                    y: t.y,
                    capacity: shape === 'prop' ? 0 : (t.capacity || 10),
                    userIds: shape === 'prop' ? [] : (t.userIds || [])
                };
            });
        }
    })();

    const $cat = document.getElementById('categoryField');
    const $guestMount = document.getElementById('guestListMount');
    const $canvas = document.getElementById('seatingCanvas');
    const $canvasScroll = document.getElementById('canvasScroll');
    const $canvasScale = document.getElementById('seatingCanvasScale');
    const $canvasZoom = document.getElementById('canvasZoom');
    const $alert = document.getElementById('alertSeating');

    var CANVAS_TABLE_W = 360;
    var CANVAS_TABLE_H = 520;
    var CANVAS_PAD = 120;
    var DEFAULT_CANVAS_ZOOM = 85;
    var MIN_CANVAS_ZOOM = 25;
    var swapPick = null; // { tableId, uid }

    function getCanvasZoom() {
        var v = parseInt($canvasZoom.value, 10);
        if (isNaN(v) || v < MIN_CANVAS_ZOOM) v = DEFAULT_CANVAS_ZOOM;
        return v / 100;
    }
    function applyCanvasZoom() {
        var z = getCanvasZoom();
        $canvasScale.style.transform = 'scale(' + z + ')';
        var el = document.getElementById('canvasZoomPct');
        if (el) el.textContent = Math.round(z * 100) + '%';
    }
    function sizeCanvasFromTables() {
        var pad = CANVAS_PAD;
        var maxR = 800;
        var maxB = 600;
        state.tables.forEach(function(t) {
            var x = t.x != null ? t.x : 40;
            var y = t.y != null ? t.y : 40;
            var sc = Math.max(0.5, Math.min(2, parseFloat(t.scale) || 1));
            var tw, th;
            if (t.shape === 'prop') {
                tw = (Math.max(80, Math.min(1200, parseInt(t.length, 10) || 160)) + 40) * sc;
                th = 180 * sc;
            } else if (t.shape === 'row') {
                tw = (Math.max(200, Math.min(1200, parseInt(t.length, 10) || 520)) + 40) * sc;
                th = 360 * sc;
            } else if (t.shape === 'square') {
                tw = (Math.max(200, Math.min(1200, parseInt(t.length, 10) || 360)) + 40) * sc;
                th = 420 * sc;
            } else {
                tw = CANVAS_TABLE_W * sc;
                th = CANVAS_TABLE_H * sc;
            }
            maxR = Math.max(maxR, x + tw + pad);
            maxB = Math.max(maxB, y + th + pad);
        });
        // Ensure canvas at least fills visible scroll area so grid looks continuous
        if ($canvasScroll) {
            maxR = Math.max(maxR, $canvasScroll.clientWidth + 40);
            maxB = Math.max(maxB, $canvasScroll.clientHeight + 40);
        }
        $canvas.style.width = maxR + 'px';
        $canvas.style.height = maxB + 'px';
    }
    function gridColumnCount(n) {
        if (n <= 0) return 1;
        return Math.max(1, Math.ceil(Math.sqrt(n)));
    }
    function layoutTablesGrid() {
        var n = state.tables.length;
        if (n === 0) return;
        var cols = gridColumnCount(n);
        var gapX = 48;
        var gapY = 48;
        var startX = 80;
        var startY = 80;
        var cellW = CANVAS_TABLE_W + gapX;
        var cellH = CANVAS_TABLE_H + gapY;
        state.tables.forEach(function(t, i) {
            var col = i % cols;
            var row = Math.floor(i / cols);
            t.x = startX + col * cellW;
            t.y = startY + row * cellH;
        });
        renderGuestList();
        renderTables();
    }
    function zoomFitViewport() {
        if (!$canvasScroll || !$canvas) return;
        sizeCanvasFromTables();
        var w = $canvas.offsetWidth;
        var h = $canvas.offsetHeight;
        var zw = (w > 0) ? ($canvasScroll.clientWidth - 32) / w : 1;
        var zh = (h > 0) ? ($canvasScroll.clientHeight - 32) / h : 1;
        var z = Math.min(1, zw, zh);
        z = Math.max(MIN_CANVAS_ZOOM / 100, z);
        var pct = Math.round(z * 100);
        pct = Math.max(MIN_CANVAS_ZOOM, Math.min(100, Math.round(pct / 5) * 5));
        $canvasZoom.value = String(pct);
        applyCanvasZoom();
    }
    function applyInitialCanvasZoom() {
        sizeCanvasFromTables();
        $canvasZoom.value = String(DEFAULT_CANVAS_ZOOM);
        applyCanvasZoom();
    }

    function showErr(msg) {
        $alert.style.display = msg ? 'block' : 'none';
        $alert.textContent = msg || '';
    }

    function seatsForUser(uid) {
        const n = parseInt(state.companionByUserId[uid], 10) || 0;
        return 1 + Math.max(0, n);
    }
    function assignedUserIds() {
        const map = {};
        state.tables.forEach(t => {
            (t.userIds || []).forEach(id => { map[id] = true; });
        });
        return map;
    }
    function tableSeatsUsed(t) {
        let s = 0;
        (t.userIds || []).forEach(uid => { s += seatsForUser(uid); });
        return s;
    }
    function findUser(uid) {
        return users.find(u => u._id === uid);
    }
    function userDisplayName(uOrId) {
        var u = (typeof uOrId === 'object' && uOrId) ? uOrId : findUser(uOrId);
        if (!u) return String(uOrId || '');
        return (u.displayName || u.name || u.email || u._id || '').toString();
    }
    function categoryLabel(fieldName) {
        const f = formFields.find(x => x.fieldName === fieldName);
        return f ? f.label : fieldName;
    }
    function categoryValueLabel(fieldName, raw) {
        if (raw === undefined || raw === null || String(raw).trim() === '') return _SA.unfilledCategory;
        const val = String(raw).trim();
        const f = formFields.find(x => x.fieldName === fieldName);
        if (f && Array.isArray(f.options) && f.options.length) {
            const opt = f.options.find(o => String(o.value) === val);
            if (opt && opt.label) return String(opt.label);
        }
        return val;
    }
    function userFieldRaw(u, fieldName) {
        if (!u) return '';
        if (u[fieldName] !== undefined && u[fieldName] !== null && String(u[fieldName]).trim() !== '') {
            return u[fieldName];
        }
        return '';
    }

    function renderCategorySelect() {
        $cat.innerHTML = '';
        formFields.forEach(f => {
            const opt = document.createElement('option');
            opt.value = f.fieldName;
            opt.textContent = f.label + ' (' + f.fieldName + ')';
            if (f.fieldName === state.categoryFieldName) opt.selected = true;
            $cat.appendChild(opt);
        });
        if (!$cat.value && formFields.length) {
            state.categoryFieldName = formFields[0].fieldName;
            $cat.value = state.categoryFieldName;
        }
        $cat.onchange = function() {
            state.categoryFieldName = $cat.value;
            renderGuestList();
            renderTables();
        };
    }

    function renderGuestList() {
        const field = state.categoryFieldName || 'company';
        const inTable = assignedUserIds();
        const unassigned = users.filter(u => !inTable[u._id]);
        const groups = {};
        unassigned.forEach(u => {
            const raw = userFieldRaw(u, field);
            const key = categoryValueLabel(field, raw);
            if (!groups[key]) groups[key] = [];
            groups[key].push(u);
        });
        const keys = Object.keys(groups).sort((a, b) => a.localeCompare(b, 'zh-HK'));

        let html = '<div class="stat-line" id="statUnassignedInner"></div>';
        keys.forEach(k => {
            html += '<div class="guest-group-title">' + escapeHtml(k) + '</div>';
            groups[k].forEach(u => {
                const uid = u._id;
                const comp = parseInt(state.companionByUserId[uid], 10) || 0;
                const dn = userDisplayName(u);
                html += '<div class="guest-row" draggable="true" data-user-id="' + uid + '">' +
                    '<span class="guest-name" title="' + escapeAttr(dn) + '">' + escapeHtml(dn) + '</span>' +
                    '<span class="text-muted small mr-1">' + _SA.companions + '</span>' +
                    '<div class="companion-stepper" data-user-id="' + uid + '">' +
                    '<button type="button" data-d="-1">−</button>' +
                    '<span>' + comp + '</span>' +
                    '<button type="button" data-d="1">+</button>' +
                    '</div></div>';
            });
        });
        $guestMount.innerHTML = html || '<p class="text-muted small">' + _SA.noUnassigned + '</p>';

        $guestMount.querySelectorAll('.guest-row').forEach(row => {
            row.addEventListener('dragstart', function(e) {
                e.dataTransfer.setData('text/user-id', row.getAttribute('data-user-id'));
                row.classList.add('dragging');
            });
            row.addEventListener('dragend', function() { row.classList.remove('dragging'); });
        });
        $guestMount.querySelectorAll('.companion-stepper').forEach(box => {
            box.querySelectorAll('button').forEach(btn => {
                btn.addEventListener('click', function(ev) {
                    ev.preventDefault(); ev.stopPropagation();
                    const uid = box.getAttribute('data-user-id');
                    const d = parseInt(btn.getAttribute('data-d'), 10);
                    let v = parseInt(state.companionByUserId[uid], 10) || 0;
                    v = Math.max(0, Math.min(20, v + d));
                    state.companionByUserId[uid] = v;
                    validateAllTables();
                    renderGuestList();
                    renderTables();
                    updateStat();
                });
            });
        });
        updateStat();
    }

    function escapeHtml(s) {
        const d = document.createElement('div');
        d.textContent = s;
        return d.innerHTML;
    }
    function escapeAttr(s) {
        return String(s).replace(/"/g, '&quot;');
    }

    function updateStat() {
        const inTable = assignedUserIds();
        const unassigned = users.filter(u => !inTable[u._id]).length;
        const totalSeats = users.reduce((sum, u) => sum + (inTable[u._id] ? 0 : seatsForUser(u._id)), 0);
        const txt = _SA.unassignedStat.replace('{count}', unassigned).replace('{seats}', totalSeats);
        const el1 = document.getElementById('statUnassignedInner');
        const el2 = document.getElementById('statUnassignedToolbar');
        if (el1) el1.textContent = txt;
        if (el2) el2.textContent = txt;
    }

    function normalizeShape(s) {
        if (s === 'square' || s === 'row' || s === 'prop') return s;
        return 'round';
    }
    function normalizeScale(v) {
        var n = parseFloat(v);
        if (isNaN(n)) n = 1;
        return Math.max(0.5, Math.min(2, Math.round(n * 20) / 20));
    }
    function shapeLabel(shape) {
        if (shape === 'square') return _SA.shapeSquare;
        if (shape === 'row') return _SA.shapeRow;
        if (shape === 'prop') return _SA.shapeProp;
        return _SA.shapeRound;
    }
    function propTypeLabel(pt) {
        var map = {
            stage: _SA.propTypeStage,
            buffet: _SA.propTypeBuffet,
            bar: _SA.propTypeBar,
            entrance: _SA.propTypeEntrance,
            restroom: _SA.propTypeRestroom,
            flower: _SA.propTypeFlower,
            other: _SA.propTypeOther
        };
        return map[pt] || _SA.propTypeOther;
    }
    function propTypeIcon(pt) {
        var map = {
            stage: '🎭',
            buffet: '🍽️',
            bar: '🍸',
            entrance: '🚪',
            restroom: '🚻',
            flower: '🌸',
            other: '📍'
        };
        return map[pt] || '📍';
    }
    function validateAllTables() {
        state.tables.forEach(function(t) {
            t.shape = normalizeShape(t.shape);
            t.scale = normalizeScale(t.scale);
            if (t.shape === 'prop') {
                t.capacity = 0;
                t.userIds = [];
                t.propType = t.propType || 'other';
                return;
            }
            var cap = Math.max(1, parseInt(t.capacity, 10) || 10);
            t.capacity = cap;
            var used = tableSeatsUsed(t);
            while (used > cap && (t.userIds || []).length > 0) {
                t.userIds.pop();
                used = tableSeatsUsed(t);
            }
        });
    }

    var RT_PALETTE = [
        { brd: '#c9a227', bg: '#e3f0ff' },
        { brd: '#c62828', bg: '#ffebee' },
        { brd: '#2e7d32', bg: '#e8f5e9' },
        { brd: '#6a1b9a', bg: '#f3e5f5' },
        { brd: '#1565c0', bg: '#e3f2fd' },
        { brd: '#ef6c00', bg: '#fff3e0' }
    ];
    function hashCat(str) {
        var s = String(str || _SA.unfilledCategory);
        var h = 0;
        for (var i = 0; i < s.length; i++) h = ((h << 5) - h) + s.charCodeAt(i) | 0;
        return Math.abs(h);
    }
    function categoryColorsForUser(uid) {
        var u = findUser(uid);
        var field = state.categoryFieldName || 'company';
        var raw = userFieldRaw(u, field);
        var key = categoryValueLabel(field, raw);
        var p = RT_PALETTE[hashCat(key) % RT_PALETTE.length];
        return { brd: p.brd, bg: p.bg, label: key };
    }

    function buildSeatSlots(t, cap) {
        var slots = [];
        var i;
        for (i = 0; i < cap; i++) slots.push({ kind: 'empty', seatNo: i + 1 });
        var pos = 0;
        var uids = t.userIds || [];
        for (i = 0; i < uids.length; i++) {
            var uid = uids[i];
            var need = seatsForUser(uid);
            if (pos + need > cap) break;
            slots[pos] = { kind: 'guest', uid: uid, seatNo: pos + 1, seatFrom: pos + 1, seatTo: pos + need };
            var k;
            for (k = 1; k < need; k++) {
                slots[pos + k] = {
                    kind: 'companion',
                    forUid: uid,
                    idx: k,
                    seatNo: pos + k + 1,
                    ownerSeatNo: pos + 1
                };
            }
            pos += need;
        }
        return slots;
    }

    function guestSeatInfo(slots, uid) {
        var guest = null;
        var companionNos = [];
        slots.forEach(function(s) {
            if (s.kind === 'guest' && s.uid === uid) guest = s;
            if (s.kind === 'companion' && s.forUid === uid) companionNos.push(s.seatNo);
        });
        if (!guest) return null;
        return {
            main: guest.seatNo,
            from: guest.seatFrom || guest.seatNo,
            to: guest.seatTo || guest.seatNo,
            companions: companionNos
        };
    }

    function getSeatPrefix(t) {
        var p = (t && t.seatLabelPrefix != null ? String(t.seatLabelPrefix) : '').trim();
        if (p) return p.slice(0, 12);
        return _SA.seatLabelPrefixDefault || '';
    }

    function applyPrefixTemplate(tpl, map) {
        var out = String(tpl || '');
        Object.keys(map).forEach(function(k) {
            out = out.split('{' + k + '}').join(String(map[k]));
        });
        return out;
    }

    function formatSeatBadge(info, t) {
        if (!info) return '';
        var prefix = getSeatPrefix(t);
        if (info.from === info.to) {
            return applyPrefixTemplate(_SA.seatLabelShort, { prefix: prefix, num: info.from });
        }
        return applyPrefixTemplate(_SA.seatRangeLabel, { prefix: prefix, from: info.from, to: info.to });
    }

    function formatSeatDetail(info, t) {
        if (!info) return '';
        var prefix = getSeatPrefix(t);
        var mainLabel = applyPrefixTemplate(_SA.seatLabelShort, { prefix: prefix, num: info.main });
        if (!info.companions || !info.companions.length) {
            return applyPrefixTemplate(_SA.guestSeatDetailSolo, { mainLabel: mainLabel });
        }
        var companionsLabel = info.companions.map(function(n) {
            return applyPrefixTemplate(_SA.seatLabelShort, { prefix: prefix, num: n });
        }).join(', ');
        return applyPrefixTemplate(_SA.guestSeatDetail, {
            mainLabel: mainLabel,
            companionsLabel: companionsLabel
        });
    }

    function defaultTableName(idx1based) {
        return _SA.tableNum.replace('{num}', idx1based);
    }

    function tableDisplayName(t, idx) {
        var n = (t.name != null ? String(t.name) : '').trim();
        return n || defaultTableName(idx + 1);
    }

    function polarSlotXY(index, total, cx, cy, radius) {
        var angle = (index / total) * 2 * Math.PI - Math.PI / 2;
        return {
            left: cx + radius * Math.cos(angle),
            top: cy + radius * Math.sin(angle)
        };
    }

    /** 方桌：只排上／下兩邊（相對整個 stage） */
    function squareSlotXY(index, total, stageW, stageH) {
        var insetX = 32;
        var edgeY = 30;
        var topCount = Math.ceil(total / 2);
        var bottomCount = total - topCount;
        var onTop = index < topCount;
        var idxOnSide = onTop ? index : (index - topCount);
        var count = onTop ? topCount : bottomCount;
        var frac = count <= 1 ? 0.5 : (idxOnSide + 1) / (count + 1);
        return {
            left: insetX + frac * (stageW - 2 * insetX),
            top: onTop ? edgeY : (stageH - edgeY)
        };
    }

    /** 戲院式排座：單一橫排 */
    function rowSlotXY(index, total, stageW, stageH) {
        var insetX = 28;
        var frac = total <= 1 ? 0.5 : (index + 1) / (total + 1);
        return {
            left: insetX + frac * (stageW - 2 * insetX),
            top: stageH / 2
        };
    }

    function normalizeTableLength(v, shape) {
        var n = parseInt(v, 10);
        if (isNaN(n)) n = (shape === 'row' ? 520 : shape === 'prop' ? 160 : 360);
        var min = (shape === 'prop') ? 80 : 200;
        var max = 1200;
        return Math.max(min, Math.min(max, n));
    }

    function clearSwapPick() {
        swapPick = null;
    }

    function unassignGuestFromTable(t, uid) {
        if (swapPick && swapPick.uid === uid) clearSwapPick();
        t.userIds = (t.userIds || []).filter(function(id) { return id !== uid; });
        showErr('');
        renderGuestList();
        renderTables();
    }

    function swapGuestsOnTable(t, uidA, uidB) {
        var ids = (t.userIds || []).slice();
        var iA = ids.indexOf(uidA);
        var iB = ids.indexOf(uidB);
        if (iA < 0 || iB < 0 || iA === iB) return false;
        ids[iA] = uidB;
        ids[iB] = uidA;
        t.userIds = ids;
        return true;
    }

    function handleGuestSwapClick(t, uid) {
        if (!swapPick || swapPick.tableId !== t.id) {
            swapPick = { tableId: t.id, uid: uid };
            renderTables();
            return;
        }
        if (swapPick.uid === uid) {
            clearSwapPick();
            renderTables();
            return;
        }
        if (swapGuestsOnTable(t, swapPick.uid, uid)) {
            clearSwapPick();
            showErr('');
            var prev = $alert.className;
            $alert.className = 'alert alert-success';
            $alert.style.display = 'block';
            $alert.textContent = _SA.swapDone;
            setTimeout(function() {
                $alert.className = prev || 'alert alert-danger';
                showErr('');
            }, 1800);
            renderGuestList();
            renderTables();
        } else {
            clearSwapPick();
            renderTables();
        }
    }

    function nextTablePosition() {
        var n = state.tables.length + 1;
        var cols = gridColumnCount(n);
        var gapX = 48;
        var gapY = 48;
        var startX = 80;
        var startY = 80;
        var cellW = CANVAS_TABLE_W + gapX;
        var cellH = CANVAS_TABLE_H + gapY;
        var i = n - 1;
        var col = i % cols;
        var row = Math.floor(i / cols);
        return { x: startX + col * cellW, y: startY + row * cellH };
    }

    function addTable(shape) {
        var id = 'tbl_' + Date.now() + '_' + Math.random().toString(36).slice(2, 8);
        var pos = nextTablePosition();
        var sh = normalizeShape(shape);
        var isProp = sh === 'prop';
        state.tables.push({
            id: id,
            name: isProp ? _SA.propDefaultName : defaultTableName(state.tables.length + 1),
            seatLabelPrefix: '',
            shape: sh,
            scale: 1,
            length: sh === 'row' ? 520 : (isProp ? 160 : 360),
            propType: isProp ? 'stage' : '',
            propExportFormat: isProp ? 'nameType' : '',
            propExportText: '',
            x: pos.x,
            y: pos.y,
            capacity: isProp ? 0 : (sh === 'row' ? 12 : 10),
            userIds: []
        });
        renderTables();
    }

    function bindTableDrag(div, t) {
        var dragTable = false, startX, startY, origX, origY, zoomFactor = 1;
        div.addEventListener('mousedown', function(e) {
            if (e.target.closest('input') || e.target.closest('button') || e.target.closest('select') || e.target.closest('.rt-slot') || e.target.closest('.rt-assigned') || e.target.closest('.rt-toolbar') || e.target.closest('.rt-foot')) return;
            dragTable = true;
            zoomFactor = getCanvasZoom();
            startX = e.clientX;
            startY = e.clientY;
            origX = t.x || 40;
            origY = t.y || 40;
            e.preventDefault();
        });
        document.addEventListener('mousemove', function(e) {
            if (!dragTable) return;
            var dx = e.clientX - startX, dy = e.clientY - startY;
            t.x = origX + dx / zoomFactor;
            t.y = origY + dy / zoomFactor;
            div.style.left = t.x + 'px';
            div.style.top = t.y + 'px';
            sizeCanvasFromTables();
        });
        document.addEventListener('mouseup', function() { dragTable = false; });
    }

    function applyItemScale(div, sc, baseW, baseH) {
        div.style.transform = 'scale(' + sc + ')';
        div.style.transformOrigin = 'top left';
        // transform 不佔 layout 空間，用 margin 補回視覺佔位，避免重疊
        var mw = Math.max(0, (baseW || 300) * (sc - 1));
        var mh = Math.max(0, (baseH || 400) * (sc - 1));
        div.style.marginRight = mw + 'px';
        div.style.marginBottom = mh + 'px';
    }

    function normalizePropExportFormat(s) {
        var allowed = { name: 1, type: 1, nameType: 1, iconName: 1, custom: 1 };
        var v = String(s || '').trim();
        return allowed[v] ? v : 'nameType';
    }

    function renderPropItem(t, idx) {
        var sc = normalizeScale(t.scale);
        t.scale = sc;
        t.length = normalizeTableLength(t.length, 'prop');
        t.propType = t.propType || 'other';
        t.propExportFormat = normalizePropExportFormat(t.propExportFormat);
        t.propExportText = (t.propExportText != null ? String(t.propExportText) : '').trim();
        var w = t.length;
        var fmt = t.propExportFormat;

        var div = document.createElement('div');
        div.className = 'round-table';
        div.style.width = (w + 24) + 'px';
        div.style.left = (t.x || 40) + 'px';
        div.style.top = (t.y || 40) + 'px';
        div.dataset.tableId = t.id;
        applyItemScale(div, sc, w + 24, 260);

        var toolbar = document.createElement('div');
        toolbar.className = 'rt-toolbar';
        var typeOpts = ['stage', 'buffet', 'bar', 'entrance', 'restroom', 'flower', 'other'].map(function(pt) {
            return '<option value="' + pt + '"' + (t.propType === pt ? ' selected' : '') + '>' + escapeHtml(propTypeLabel(pt)) + '</option>';
        }).join('');
        var fmtOpts = [
            ['name', _SA.propExportFormatName],
            ['type', _SA.propExportFormatType],
            ['nameType', _SA.propExportFormatNameType],
            ['iconName', _SA.propExportFormatIconName],
            ['custom', _SA.propExportFormatCustom]
        ].map(function(pair) {
            return '<option value="' + pair[0] + '"' + (fmt === pair[0] ? ' selected' : '') + '>' + escapeHtml(pair[1]) + '</option>';
        }).join('');
        toolbar.innerHTML =
            '<div class="cap-row">' +
            '<input type="text" class="form-control form-control-sm tbl-name" maxlength="80" value="' + escapeAttr(t.name || '') + '" placeholder="' + escapeAttr(_SA.propDefaultName) + '" title="' + escapeAttr(_SA.tableNameLabel) + '"/>' +
            ' <span class="rt-shape-tag">' + escapeHtml(_SA.shapeProp) + '</span>' +
            '</div>' +
            '<div class="cap-row">' +
            escapeHtml(_SA.propTypeLabel) + ' <select class="form-control form-control-sm tbl-prop-type">' + typeOpts + '</select>' +
            ' ' + escapeHtml(_SA.scaleLabel) + ' <input type="number" min="0.5" max="2" step="0.05" value="' + sc + '" class="form-control form-control-sm tbl-scale"/>' +
            ' ' + escapeHtml(_SA.lengthLabel) + ' <input type="number" min="80" max="1200" step="10" value="' + w + '" class="form-control form-control-sm tbl-len"/>' +
            '</div>' +
            '<div class="cap-row">' +
            escapeHtml(_SA.propExportFormatLabel) + ' <select class="form-control form-control-sm tbl-prop-export-fmt">' + fmtOpts + '</select>' +
            ' ' + escapeHtml(_SA.propExportTextLabel) +
            ' <input type="text" class="form-control form-control-sm tbl-prop-export-text" maxlength="120" style="width:160px;" ' +
            'value="' + escapeAttr(t.propExportText || '') + '" placeholder="' + escapeAttr(_SA.propExportTextPlaceholder) + '"/>' +
            '</div>';

        var exportTitle = (fmt === 'custom' && t.propExportText)
            ? t.propExportText
            : (fmt === 'type' ? propTypeLabel(t.propType) : (t.name || _SA.propDefaultName));
        var body = document.createElement('div');
        body.className = 'rt-prop fmt-' + fmt;
        body.style.width = w + 'px';
        body.innerHTML =
            '<div class="rt-prop-icon">' + propTypeIcon(t.propType) + '</div>' +
            '<div class="rt-prop-title">' + escapeHtml(exportTitle) + '</div>' +
            '<span class="rt-prop-tag">' + escapeHtml(propTypeLabel(t.propType)) + '</span>' +
            '<div class="rt-prop-hint">' + escapeHtml(_SA.propHint) + '</div>';

        var foot = document.createElement('div');
        foot.className = 'rt-foot';
        foot.innerHTML = '<button type="button" class="btn btn-sm btn-outline-danger tbl-remove">' + _SA.removePropBtn + '</button>';

        div.appendChild(toolbar);
        div.appendChild(body);
        div.appendChild(foot);

        var nameInput = div.querySelector('.tbl-name');
        nameInput.addEventListener('change', function() {
            t.name = String(nameInput.value || '').trim().slice(0, 80);
            nameInput.value = t.name;
            renderTables();
        });
        nameInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });

        div.querySelector('.tbl-prop-type').addEventListener('change', function(e) {
            t.propType = e.target.value || 'other';
            renderTables();
        });
        div.querySelector('.tbl-prop-type').addEventListener('mousedown', function(e) { e.stopPropagation(); });

        div.querySelector('.tbl-prop-export-fmt').addEventListener('change', function(e) {
            t.propExportFormat = normalizePropExportFormat(e.target.value);
            renderTables();
        });
        div.querySelector('.tbl-prop-export-fmt').addEventListener('mousedown', function(e) { e.stopPropagation(); });

        var exportTextInput = div.querySelector('.tbl-prop-export-text');
        exportTextInput.addEventListener('change', function() {
            t.propExportText = String(exportTextInput.value || '').trim().slice(0, 120);
            exportTextInput.value = t.propExportText;
            if (t.propExportFormat === 'custom') renderTables();
        });
        exportTextInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });

        var scaleInput = div.querySelector('.tbl-scale');
        scaleInput.addEventListener('change', function() {
            t.scale = normalizeScale(scaleInput.value);
            renderTables();
        });
        scaleInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });

        var lenInput = div.querySelector('.tbl-len');
        lenInput.addEventListener('change', function() {
            t.length = normalizeTableLength(lenInput.value, 'prop');
            renderTables();
        });
        lenInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });

        div.querySelector('.tbl-remove').addEventListener('click', function(e) {
            e.stopPropagation();
            state.tables = state.tables.filter(function(x) { return x.id !== t.id; });
            renderTables();
        });

        bindTableDrag(div, t);
        $canvas.appendChild(div);
    }

    function renderTables() {
        $canvas.innerHTML = '';
        var plateSize = 268;
        var ringR = 48;
        var ringC = 2 * Math.PI * ringR;

        state.tables.forEach(function(t, idx) {
            t.shape = normalizeShape(t.shape);
            t.scale = normalizeScale(t.scale);
            if (t.shape === 'prop') {
                renderPropItem(t, idx);
                return;
            }

            var isSquare = t.shape === 'square';
            var isRow = t.shape === 'row';
            var tableLen = (isSquare || isRow) ? normalizeTableLength(t.length, t.shape) : 280;
            if (isSquare || isRow) t.length = tableLen;
            else t.length = t.length || 360;

            var plateW = (isSquare || isRow) ? tableLen : plateSize;
            var plateH = isRow ? 36 : (isSquare ? 140 : plateSize);
            var stagePadX = isRow ? 12 : (isSquare ? 16 : 36);
            var stagePadY = isRow ? 48 : (isSquare ? 64 : 36);
            var stageW = (isSquare || isRow) ? (plateW + stagePadX * 2) : 340;
            var stageH = (isSquare || isRow) ? (plateH + stagePadY * 2) : 340;

            var div = document.createElement('div');
            div.className = 'round-table';
            div.style.width = stageW + 'px';
            div.style.left = (t.x || 40) + 'px';
            div.style.top = (t.y || 40) + 'px';
            div.dataset.tableId = t.id;
            applyItemScale(div, t.scale, stageW, isRow ? 340 : (isSquare ? 420 : 500));

            var used = tableSeatsUsed(t);
            var cap = Math.max(1, parseInt(t.capacity, 10) || 10);
            t.capacity = cap;
            var pct = cap > 0 ? Math.min(1, used / cap) : 0;
            var dashOff = ringC * (1 - pct);
            var slots = buildSeatSlots(t, cap);
            var isThisTableSwap = swapPick && swapPick.tableId === t.id;

            var toolbar = document.createElement('div');
            toolbar.className = 'rt-toolbar';
            toolbar.innerHTML =
                '<div class="cap-row">' +
                '<input type="text" class="form-control form-control-sm tbl-name" maxlength="80" ' +
                'value="' + escapeAttr(t.name || '') + '" ' +
                'placeholder="' + escapeAttr(defaultTableName(idx + 1)) + '" ' +
                'title="' + escapeAttr(_SA.tableNameLabel) + '"/>' +
                ' <span class="rt-shape-tag">' + escapeHtml(shapeLabel(t.shape)) + '</span>' +
                ' ' + escapeHtml(_SA.seatLabelPrefixLabel) +
                ' <input type="text" class="form-control form-control-sm tbl-seat-prefix" maxlength="12" ' +
                'value="' + escapeAttr(t.seatLabelPrefix || '') + '" ' +
                'placeholder="' + escapeAttr(_SA.seatLabelPrefixDefault) + '" ' +
                'title="' + escapeAttr(_SA.seatLabelPrefixHint) + '"/>' +
                '</div>' +
                '<div class="cap-row">' +
                '<span class="rt-cap-step">' +
                '<button type="button" class="tbl-cap-minus" title="-">' + _SA.seatsMinus + '</button>' +
                ' ' + escapeHtml(_SA.capacityLabel) +
                ' <input type="number" min="1" max="999" value="' + cap + '" class="form-control form-control-sm tbl-cap"/>' +
                ' <button type="button" class="tbl-cap-plus" title="+">' + _SA.seatsPlus + '</button>' +
                '</span>' +
                ' ' + escapeHtml(_SA.scaleLabel) +
                ' <input type="number" min="0.5" max="2" step="0.05" value="' + t.scale + '" class="form-control form-control-sm tbl-scale"/>' +
                ((isSquare || isRow)
                    ? (' ' + escapeHtml(_SA.lengthLabel) + ' <input type="number" min="200" max="1200" step="20" value="' + tableLen + '" class="form-control form-control-sm tbl-len"/>')
                    : '') +
                '</div>';

            var stage = document.createElement('div');
            stage.className = 'rt-stage ' + (isRow ? 'rt-stage-row' : (isSquare ? 'rt-stage-square' : 'rt-stage-round'));
            stage.style.width = stageW + 'px';
            if (isSquare || isRow) stage.style.height = stageH + 'px';

            var plate = document.createElement('div');
            plate.className = 'rt-plate' + (isRow ? ' rt-shape-row' : (isSquare ? ' rt-shape-square' : ''));
            plate.style.width = plateW + 'px';
            plate.style.height = plateH + 'px';

            var center = document.createElement('div');
            center.className = 'rt-center';
            if (isRow) {
                center.innerHTML = '<div class="rt-center-num" title="' + escapeAttr(tableDisplayName(t, idx)) + '">' +
                    escapeHtml(tableDisplayName(t, idx)) + '</div>';
            } else {
                center.innerHTML =
                    '<svg class="rt-ring-svg" viewBox="0 0 112 112" aria-hidden="true">' +
                    '<circle class="rt-ring-bg" cx="56" cy="56" r="' + ringR + '"/>' +
                    '<circle class="rt-ring-fill" cx="56" cy="56" r="' + ringR + '"' +
                    ' stroke-dasharray="' + ringC + '"' +
                    ' stroke-dashoffset="' + dashOff + '"/>' +
                    '</svg>' +
                    '<div class="rt-center-num" title="' + escapeAttr(tableDisplayName(t, idx)) + '">' + (idx + 1) + '</div>';
            }

            var layer = document.createElement('div');
            layer.className = 'rt-seats-layer';

            var seatCx = stageW / 2;
            var seatCy = stageH / 2;
            var seatR = Math.min(stageW, stageH) / 2 - 28;

            var si;
            for (si = 0; si < cap; si++) {
                var slotEl = document.createElement('div');
                var slot = slots[si];
                var seatNo = slot.seatNo || (si + 1);
                var xy;
                if (isRow) xy = rowSlotXY(si, cap, stageW, stageH);
                else if (isSquare) xy = squareSlotXY(si, cap, stageW, stageH);
                else xy = polarSlotXY(si, cap, seatCx, seatCy, seatR);
                slotEl.style.left = xy.left + 'px';
                slotEl.style.top = xy.top + 'px';

                var badge = document.createElement('span');
                badge.className = 'rt-seat-no';
                badge.textContent = getSeatPrefix(t) + String(seatNo);

                if (slot.kind === 'empty') {
                    slotEl.className = 'rt-slot empty';
                    slotEl.title = _SA.emptySlotTitle.replace('{num}', seatNo);
                    slotEl.appendChild(badge);
                } else if (slot.kind === 'companion') {
                    var ownerName = userDisplayName(slot.forUid);
                    slotEl.className = 'rt-slot companion';
                    slotEl.title = _SA.companionSlotTitle.replace('{num}', seatNo) +
                        ' · ' + _SA.companionOf.replace('{name}', ownerName);
                    slotEl.appendChild(badge);
                    var compLabel = document.createElement('span');
                    compLabel.className = 'rt-comp-label';
                    compLabel.textContent = ownerName;
                    slotEl.appendChild(compLabel);
                } else {
                    slotEl.className = 'rt-slot guest';
                    if (isThisTableSwap && swapPick.uid === slot.uid) {
                        slotEl.classList.add('rt-swap-pick');
                    }
                    slotEl.title = _SA.clickToUnassign + ' · ' + _SA.seatNum.replace('{num}', seatNo);
                    var cols = categoryColorsForUser(slot.uid);
                    slotEl.style.setProperty('--rt-brd', cols.brd);
                    slotEl.style.setProperty('--rt-bg', cols.bg);
                    slotEl.appendChild(badge);
                    var nm = document.createElement('span');
                    nm.className = 'rt-name';
                    nm.textContent = userDisplayName(slot.uid);
                    slotEl.appendChild(nm);
                    var rm = document.createElement('button');
                    rm.type = 'button';
                    rm.className = 'rt-remove';
                    rm.innerHTML = '&times;';
                    rm.title = _SA.removeFromTable;
                    var uidGuest = slot.uid;
                    rm.addEventListener('click', function(ev) {
                        ev.preventDefault();
                        ev.stopPropagation();
                        unassignGuestFromTable(t, uidGuest);
                    });
                    slotEl.addEventListener('click', function(ev) {
                        if (ev.target.closest('.rt-remove')) return;
                        ev.preventDefault();
                        ev.stopPropagation();
                        handleGuestSwapClick(t, uidGuest);
                    });
                    slotEl.appendChild(rm);
                }
                layer.appendChild(slotEl);
            }

            plate.appendChild(center);
            stage.appendChild(plate);
            stage.appendChild(layer);

            var foot = document.createElement('div');
            foot.className = 'rt-foot';
            foot.innerHTML = '<span>' + _SA.occupiedStat.replace('{used}', used).replace('{cap}', cap) + '</span> ' +
                '<button type="button" class="btn btn-sm btn-outline-danger tbl-remove">' + _SA.removeTableBtn + '</button>';

            var assignedBox = document.createElement('div');
            assignedBox.className = 'rt-assigned';
            var listHtml = '<div class="rt-assigned-title">' + _SA.assignedListTitle + '</div>';
            if (isThisTableSwap) {
                var pickInfo = guestSeatInfo(slots, swapPick.uid);
                var pickSeats = pickInfo ? formatSeatBadge(pickInfo, t) : String((pickInfo && pickInfo.main) || '');
                listHtml += '<div class="rt-swap-hint">' +
                    escapeHtml(_SA.swapPickHint
                        .replace('{name}', userDisplayName(swapPick.uid))
                        .replace('{seats}', pickSeats)) +
                    '</div>';
            }
            var guestSlots = slots.filter(function(s) { return s.kind === 'guest'; });
            if (guestSlots.length === 0) {
                listHtml += '<div class="text-muted">—</div>';
            } else {
                guestSlots.forEach(function(s) {
                    var info = guestSeatInfo(slots, s.uid);
                    var pickCls = (isThisTableSwap && swapPick.uid === s.uid) ? ' rt-swap-pick-row' : '';
                    listHtml += '<div class="rt-assigned-row' + pickCls + '" data-uid="' + escapeAttr(s.uid) + '">' +
                        '<span class="seat-badge">' + escapeHtml(formatSeatBadge(info, t)) + '</span>' +
                        '<span class="meta">' +
                        '<span class="name" title="' + escapeAttr(userDisplayName(s.uid)) + '">' + escapeHtml(userDisplayName(s.uid)) + '</span>' +
                        '<span class="seats-detail">' + escapeHtml(formatSeatDetail(info, t)) + '</span>' +
                        '</span>' +
                        '<span class="actions">' +
                        '<button type="button" class="btn-swap" title="' + escapeAttr(_SA.swapSeatsBtn) + '">' + _SA.swapSeatsBtn + '</button>' +
                        '<button type="button" class="btn-rm" title="' + escapeAttr(_SA.removeFromTable) + '">' + _SA.removeFromTable + '</button>' +
                        '</span>' +
                        '</div>';
                });
            }
            assignedBox.innerHTML = listHtml;
            assignedBox.querySelectorAll('.rt-assigned-row .btn-rm').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var row = btn.closest('.rt-assigned-row');
                    var uid = row && row.getAttribute('data-uid');
                    if (uid) unassignGuestFromTable(t, uid);
                });
            });
            assignedBox.querySelectorAll('.rt-assigned-row .btn-swap').forEach(function(btn) {
                btn.addEventListener('click', function(e) {
                    e.preventDefault();
                    e.stopPropagation();
                    var row = btn.closest('.rt-assigned-row');
                    var uid = row && row.getAttribute('data-uid');
                    if (uid) handleGuestSwapClick(t, uid);
                });
            });
            assignedBox.querySelectorAll('.rt-assigned-row').forEach(function(row) {
                row.addEventListener('click', function(e) {
                    if (e.target.closest('button')) return;
                    var uid = row.getAttribute('data-uid');
                    if (uid) handleGuestSwapClick(t, uid);
                });
                row.style.cursor = 'pointer';
            });

            div.appendChild(toolbar);
            div.appendChild(stage);
            div.appendChild(foot);
            div.appendChild(assignedBox);

            function setCapacity(v) {
                t.capacity = Math.max(1, parseInt(v, 10) || 10);
                validateAllTables();
                renderGuestList();
                renderTables();
            }
            var capInput = div.querySelector('.tbl-cap');
            capInput.addEventListener('change', function() { setCapacity(capInput.value); });
            capInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });
            div.querySelector('.tbl-cap-minus').addEventListener('click', function(e) {
                e.stopPropagation();
                setCapacity(cap - 1);
            });
            div.querySelector('.tbl-cap-plus').addEventListener('click', function(e) {
                e.stopPropagation();
                setCapacity(cap + 1);
            });

            var nameInput = div.querySelector('.tbl-name');
            if (nameInput) {
                nameInput.addEventListener('change', function() {
                    t.name = String(nameInput.value || '').trim().slice(0, 80);
                    nameInput.value = t.name;
                    var tip = tableDisplayName(t, idx);
                    var centerNum = div.querySelector('.rt-center-num');
                    if (centerNum) {
                        centerNum.setAttribute('title', tip);
                        if (isRow) centerNum.textContent = tip;
                    }
                });
                nameInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });
                nameInput.addEventListener('click', function(e) { e.stopPropagation(); });
            }

            var prefixInput = div.querySelector('.tbl-seat-prefix');
            if (prefixInput) {
                prefixInput.addEventListener('change', function() {
                    t.seatLabelPrefix = String(prefixInput.value || '').trim().slice(0, 12);
                    prefixInput.value = t.seatLabelPrefix;
                    renderTables();
                });
                prefixInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });
                prefixInput.addEventListener('click', function(e) { e.stopPropagation(); });
            }

            var scaleInput = div.querySelector('.tbl-scale');
            if (scaleInput) {
                scaleInput.addEventListener('change', function() {
                    t.scale = normalizeScale(scaleInput.value);
                    renderTables();
                });
                scaleInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });
            }

            var lenInput = div.querySelector('.tbl-len');
            if (lenInput) {
                lenInput.addEventListener('change', function() {
                    t.length = normalizeTableLength(lenInput.value, t.shape);
                    renderTables();
                });
                lenInput.addEventListener('mousedown', function(e) { e.stopPropagation(); });
            }

            div.querySelector('.tbl-remove').addEventListener('click', function(e) {
                e.stopPropagation();
                if (swapPick && swapPick.tableId === t.id) clearSwapPick();
                state.tables = state.tables.filter(function(x) { return x.id !== t.id; });
                renderGuestList();
                renderTables();
            });

            div.addEventListener('dragover', function(e) {
                e.preventDefault();
                div.classList.add('drag-over');
            }, true);
            div.addEventListener('dragleave', function(e) {
                if (!div.contains(e.relatedTarget)) div.classList.remove('drag-over');
            });
            div.addEventListener('drop', function(e) {
                e.preventDefault();
                div.classList.remove('drag-over');
                var uid = e.dataTransfer.getData('text/user-id');
                if (!uid) return;
                if ((t.userIds || []).indexOf(uid) >= 0) return;
                var trial = { userIds: (t.userIds || []).concat([uid]), capacity: cap };
                var newUsed = tableSeatsUsed({ userIds: trial.userIds });
                if (newUsed > cap) {
                    showErr(_SA.tableFullError);
                    setTimeout(function() { showErr(''); }, 3500);
                    return;
                }
                t.userIds = trial.userIds;
                showErr('');
                renderGuestList();
                renderTables();
            });

            bindTableDrag(div, t);
            $canvas.appendChild(div);
        });
        sizeCanvasFromTables();
    }

    document.getElementById('btnAddTable').addEventListener('click', function() { addTable('round'); });
    document.getElementById('btnAddSquareTable').addEventListener('click', function() { addTable('square'); });
    document.getElementById('btnAddRowTable').addEventListener('click', function() { addTable('row'); });
    document.getElementById('btnAddProp').addEventListener('click', function() { addTable('prop'); });

    $canvasZoom.addEventListener('input', applyCanvasZoom);
    document.getElementById('btnZoomFit').addEventListener('click', zoomFitViewport);
    document.getElementById('btnLayoutGrid').addEventListener('click', function() {
        if (state.tables.length === 0) {
            alert(_SA.noTablesAlert);
            return;
        }
        if (!confirm(_SA.gridLayoutConfirm)) return;
        layoutTablesGrid();
        zoomFitViewport();
    });
    document.getElementById('btnExportZip').addEventListener('click', function() {
        var btn = document.getElementById('btnExportZip');
        if (typeof html2canvas === 'undefined' || typeof ExcelJS === 'undefined' || typeof JSZip === 'undefined') {
            alert(_SA.exportLoadError);
            return;
        }
        sizeCanvasFromTables();
        btn.disabled = true;
        var prevZ = $canvasZoom.value;
        $canvasZoom.value = '100';
        applyCanvasZoom();

        function canvasToBlob(canvas) {
            return new Promise(function(resolve, reject) {
                if (canvas.toBlob) {
                    canvas.toBlob(function(blob) {
                        if (blob) resolve(blob);
                        else reject(new Error('toBlob failed'));
                    }, 'image/png');
                } else {
                    try {
                        var dataUrl = canvas.toDataURL('image/png');
                        var parts = dataUrl.split(',');
                        var bin = atob(parts[1]);
                        var arr = new Uint8Array(bin.length);
                        for (var i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);
                        resolve(new Blob([arr], { type: 'image/png' }));
                    } catch (e) {
                        reject(e);
                    }
                }
            });
        }

        function guestCompanyRaw(uid) {
            var field = state.categoryFieldName || 'company';
            var u = findUser(uid);
            var raw = userFieldRaw(u, field);
            if (raw === undefined || raw === null || String(raw).trim() === '') return '';
            var label = categoryValueLabel(field, raw);
            if (!label || label === _SA.unfilledCategory) return '';
            return label;
        }

        function safeSheetName(name, idx, used) {
            var base = String(name || ('Table ' + (idx + 1)))
                .replace(/[\\\/\?\*\[\]\:]/g, ' ')
                .replace(/\s+/g, ' ')
                .trim();
            if (!base) base = 'Table ' + (idx + 1);
            base = base.slice(0, 31);
            var candidate = base;
            var n = 2;
            while (used[candidate]) {
                var suffix = ' (' + n + ')';
                candidate = (base.slice(0, Math.max(1, 31 - suffix.length)) + suffix).slice(0, 31);
                n++;
            }
            used[candidate] = true;
            return candidate;
        }

        function buildXlsxBlob() {
            var catField = formFields.find(function(f) { return f.fieldName === (state.categoryFieldName || 'company'); });
            var companyHeader = (catField && catField.label) ? catField.label : _SA.exportColCompany;
            var wb = new ExcelJS.Workbook();
            wb.creator = 'Seating Arrangement';
            var usedNames = {};
            var tableCount = 0;

            state.tables.forEach(function(t, idx) {
                if (normalizeShape(t.shape) === 'prop') return;
                tableCount++;
                var tableName = tableDisplayName(t, idx);
                var sheetName = safeSheetName(tableName, idx, usedNames);
                var ws = wb.addWorksheet(sheetName);

                var cap = Math.max(1, parseInt(t.capacity, 10) || 10);
                var slots = buildSeatSlots(t, cap);
                var seatRows = [];
                var anyCompany = false;
                slots.forEach(function(slot) {
                    if (slot.kind === 'empty') return;
                    var seatLabel = applyPrefixTemplate(_SA.seatLabelShort, {
                        prefix: getSeatPrefix(t),
                        num: slot.seatNo
                    });
                    var guestName = '';
                    var company = '';
                    if (slot.kind === 'guest') {
                        guestName = userDisplayName(slot.uid);
                        company = guestCompanyRaw(slot.uid);
                    } else if (slot.kind === 'companion') {
                        guestName = userDisplayName(slot.forUid) + _SA.exportCompanionSuffix;
                        company = guestCompanyRaw(slot.forUid);
                    }
                    if (company) anyCompany = true;
                    seatRows.push({ seat: seatLabel, guest: guestName, company: company });
                });

                // Row 1: table name (bold + larger)
                var titleCell = ws.getCell(1, 1);
                titleCell.value = tableName;
                titleCell.font = { bold: true, size: 16, name: 'Calibri' };
                titleCell.alignment = { vertical: 'middle', horizontal: 'left' };
                ws.mergeCells(1, 1, 1, anyCompany ? 3 : 2);
                ws.getRow(1).height = 26;

                // Row 2: blank spacer
                ws.getRow(2).height = 8;

                // Row 3: headers
                var headers = [_SA.exportColSeat, _SA.exportColGuest];
                if (anyCompany) headers.push(companyHeader);
                var headerRow = ws.getRow(3);
                headers.forEach(function(h, i) {
                    var cell = headerRow.getCell(i + 1);
                    cell.value = h;
                    cell.font = { bold: true, size: 11 };
                    cell.fill = {
                        type: 'pattern',
                        pattern: 'solid',
                        fgColor: { argb: 'FFF1F3F5' }
                    };
                });

                if (!seatRows.length) {
                    var emptyRow = ws.getRow(4);
                    emptyRow.getCell(1).value = '—';
                    emptyRow.getCell(2).value = '—';
                    if (anyCompany) emptyRow.getCell(3).value = '';
                } else {
                    seatRows.forEach(function(r, i) {
                        var row = ws.getRow(4 + i);
                        row.getCell(1).value = r.seat;
                        row.getCell(2).value = r.guest;
                        if (anyCompany) row.getCell(3).value = r.company || '';
                    });
                }

                ws.getColumn(1).width = 12;
                ws.getColumn(2).width = 24;
                if (anyCompany) ws.getColumn(3).width = 28;
            });

            if (tableCount === 0) {
                var emptyWs = wb.addWorksheet(_SA.exportSheetName.slice(0, 31) || 'Seating');
                var c = emptyWs.getCell(1, 1);
                c.value = '—';
                c.font = { bold: true, size: 16 };
            }

            return wb.xlsx.writeBuffer().then(function(buf) {
                return new Blob([buf], {
                    type: 'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet'
                });
            });
        }

        function downloadBlob(blob, filename) {
            var url = URL.createObjectURL(blob);
            var link = document.createElement('a');
            link.href = url;
            link.download = filename;
            document.body.appendChild(link);
            link.click();
            setTimeout(function() {
                URL.revokeObjectURL(url);
                link.remove();
            }, 1500);
        }

        var EXPORT_PAD = { top: 140, right: 72, bottom: 100, left: 72 };
        var exportHost = null;

        setTimeout(function() {
            // 用獨立容器 + 真正 padding（absolute 子元素唔受 canvas padding 影響）
            exportHost = document.createElement('div');
            exportHost.id = 'seating-export-host';
            exportHost.style.padding = EXPORT_PAD.top + 'px ' + EXPORT_PAD.right + 'px ' +
                EXPORT_PAD.bottom + 'px ' + EXPORT_PAD.left + 'px';
            exportHost.style.background = '#f0f2f5';

            var clone = $canvas.cloneNode(true);
            clone.id = 'seatingCanvasExportClone';
            clone.classList.add('export-clean');
            clone.style.position = 'relative';
            clone.style.left = '0';
            clone.style.top = '0';
            clone.style.margin = '0';
            clone.style.transform = 'none';
            clone.style.background = '#f0f2f5';
            clone.style.width = ($canvas.offsetWidth || parseInt($canvas.style.width, 10) || 800) + 'px';
            clone.style.height = ($canvas.offsetHeight || parseInt($canvas.style.height, 10) || 600) + 'px';
            exportHost.appendChild(clone);
            document.body.appendChild(exportHost);

            // 等 clone 套用 export-clean（隱藏 toolbar）後再量度，並確保頂部有空間
            requestAnimationFrame(function() {
                html2canvas(exportHost, {
                    scale: 2,
                    useCORS: true,
                    allowTaint: true,
                    backgroundColor: '#f0f2f5',
                    logging: false,
                    scrollX: 0,
                    scrollY: 0,
                    windowWidth: exportHost.scrollWidth,
                    windowHeight: exportHost.scrollHeight
                }).then(function(canvas) {
                    return canvasToBlob(canvas);
                }).then(function(pngBlob) {
                    return buildXlsxBlob().then(function(xlsxBlob) {
                        var zip = new JSZip();
                        zip.file('seating-layout.png', pngBlob);
                        zip.file('seating-tables.xlsx', xlsxBlob);
                        return zip.generateAsync({ type: 'blob' });
                    });
                }).then(function(zipBlob) {
                    downloadBlob(zipBlob, 'seating-' + eventId + '.zip');
                }).catch(function(err) {
                    console.error(err);
                    alert(_SA.exportFailed);
                }).finally(function() {
                    if (exportHost && exportHost.parentNode) exportHost.parentNode.removeChild(exportHost);
                    exportHost = null;
                    $canvasZoom.value = prevZ;
                    applyCanvasZoom();
                    btn.disabled = false;
                });
            });
        }, 80);
    });

    document.getElementById('btnSave').addEventListener('click', function() {
        showErr('');
        validateAllTables();
        fetch('/events/' + eventId + '/seating-arrangement/api', {
            method: 'PUT',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({
                categoryFieldName: state.categoryFieldName,
                companionByUserId: state.companionByUserId,
                tables: state.tables
            })
        }).then(function(r) {
            return r.json().then(function(j) {
                if (!r.ok) throw new Error(j.message || _SA.saveFailed);
                alert(_SA.saved);
            });
        }).catch(function(err) {
            alert(err.message || _SA.saveFailed);
        });
    });

    document.getElementById('btnReloadApi').addEventListener('click', function() {
        fetch('/events/' + eventId + '/seating-arrangement/api')
            .then(function(r) { return r.json(); })
            .then(function(data) {
                users = data.users || users;
                clearSwapPick();
                state.categoryFieldName = data.seating.categoryFieldName || 'company';
                var legacyPrefix = (data.seating.seatLabelPrefix != null ? String(data.seating.seatLabelPrefix) : '').trim().slice(0, 12);
                state.companionByUserId = data.seating.companionByUserId || {};
                state.tables = (data.seating.tables || []).map(function(t) {
                    var p = (t.seatLabelPrefix != null ? String(t.seatLabelPrefix) : '').trim().slice(0, 12);
                    if (!p && legacyPrefix) p = legacyPrefix;
                    var shape = (t.shape === 'square' || t.shape === 'row' || t.shape === 'prop') ? t.shape : 'round';
                    return {
                        id: t.id,
                        name: (t.name != null ? String(t.name) : '').trim(),
                        seatLabelPrefix: shape === 'prop' ? '' : p,
                        shape: shape,
                        scale: Math.max(0.5, Math.min(2, parseFloat(t.scale) || 1)),
                        length: Math.max(80, Math.min(1200, parseInt(t.length, 10) || (shape === 'row' ? 520 : shape === 'prop' ? 160 : 360))),
                        propType: t.propType || (shape === 'prop' ? 'other' : ''),
                        propExportFormat: t.propExportFormat || (shape === 'prop' ? 'nameType' : ''),
                        propExportText: (t.propExportText != null ? String(t.propExportText) : '').trim(),
                        x: t.x,
                        y: t.y,
                        capacity: shape === 'prop' ? 0 : (t.capacity || 10),
                        userIds: shape === 'prop' ? [] : (t.userIds || [])
                    };
                });
                renderCategorySelect();
                renderGuestList();
                renderTables();
            })
            .catch(function() { alert(_SA.loadFailed); });
    });

    renderCategorySelect();
    if (!state.tables || state.tables.length === 0) {
        state.tables = [
            { id: 'tbl_default_1', name: defaultTableName(1), seatLabelPrefix: 'A', shape: 'round', scale: 1, length: 360, x: 80, y: 80, capacity: 10, userIds: [] },
            { id: 'tbl_default_2', name: defaultTableName(2), seatLabelPrefix: 'B', shape: 'round', scale: 1, length: 360, x: 340, y: 120, capacity: 10, userIds: [] }
        ];
    }
    renderGuestList();
    renderTables();
    applyInitialCanvasZoom();
})();
</script>
