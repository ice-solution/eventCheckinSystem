<%- include ("components/header") %>
<%- include ("components/menu", {eventId: ''}) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<style>
    .events-table-area {
        width: 100%;
        max-width: 100%;
        min-width: 0;
        box-sizing: border-box;
        overflow: hidden;
    }
    .events-table-xscroll {
        width: 100%;
        max-width: 100%;
        overflow-x: auto;
        overflow-y: visible;
        border: 1px solid var(--border-color, #e4e9f0);
        border-radius: 8px;
        scrollbar-width: thin;
        scrollbar-color: transparent transparent;
    }
    .events-table-xscroll:hover {
        scrollbar-color: rgba(0,0,0,0.28) transparent;
    }
    .events-table-xscroll::-webkit-scrollbar { height: 8px; }
    .events-table-xscroll::-webkit-scrollbar-thumb {
        background: rgba(0,0,0,0.18);
        border-radius: 4px;
    }
    .events-table-xscroll.is-dragging { cursor: grabbing; user-select: none; }

    #eventsTable_wrapper.dataTables_wrapper {
        width: 100% !important;
        max-width: 100% !important;
        margin: 0 !important;
        padding: 0 !important;
        box-sizing: border-box;
    }
    #eventsTable_wrapper #eventsTable {
        width: max-content !important;
        min-width: 100%;
        margin: 0 !important;
        border-collapse: collapse;
    }
    #eventsTable_wrapper #eventsTable thead th,
    #eventsTable_wrapper #eventsTable tbody td {
        box-sizing: border-box !important;
        white-space: nowrap;
        vertical-align: middle;
        padding: 10px 14px !important;
        font-size: 13px;
        border-bottom: 1px solid #eef1f5;
        text-align: left;
    }
    #eventsTable_wrapper #eventsTable thead th {
        font-weight: 600;
        color: #334155;
        border-bottom: 1px solid #e4e9f0;
        background: #f8fafc;
    }
    #eventsTable_wrapper #eventsTable thead th.sorting,
    #eventsTable_wrapper #eventsTable thead th.sorting_asc,
    #eventsTable_wrapper #eventsTable thead th.sorting_desc {
        background-image: none !important;
        padding: 10px 14px !important;
        position: relative;
    }
    #eventsTable_wrapper #eventsTable thead th.sorting::before,
    #eventsTable_wrapper #eventsTable thead th.sorting_asc::before,
    #eventsTable_wrapper #eventsTable thead th.sorting_desc::before { display: none !important; }
    #eventsTable_wrapper #eventsTable thead th.sorting::after,
    #eventsTable_wrapper #eventsTable thead th.sorting_asc::after,
    #eventsTable_wrapper #eventsTable thead th.sorting_desc::after {
        position: absolute !important;
        right: 4px !important;
        top: 50% !important;
        transform: translateY(-50%) !important;
        display: block !important;
        margin: 0 !important;
        font-size: 9px !important;
        line-height: 1 !important;
        content: '▲▼' !important;
        color: #ccc !important;
        pointer-events: none;
    }
    #eventsTable_wrapper #eventsTable thead th.sorting_asc::after  { content: '▲' !important; color: #444 !important; }
    #eventsTable_wrapper #eventsTable thead th.sorting_desc::after { content: '▼' !important; color: #444 !important; }

    #eventsTable_wrapper .dataTables_info {
        padding: 14px 12px 6px !important;
        margin: 0 !important;
        font-size: 13px;
        color: #64748b;
    }
    #eventsTable_wrapper .dataTables_paginate {
        padding: 4px 12px 10px !important;
        text-align: center;
    }
    #eventsTable_wrapper .dataTables_paginate .pagination {
        display: flex !important;
        justify-content: center !important;
        align-items: center !important;
        gap: 2px;
        margin: 0 !important;
    }
    #eventsTable_wrapper .dataTables_paginate .page-link {
        display: inline-flex !important;
        align-items: center !important;
        justify-content: center !important;
        height: 32px !important;
        min-width: 32px !important;
        padding: 0 6px !important;
        border: none !important;
        border-radius: 50% !important;
        font-size: 14px !important;
        font-weight: 500 !important;
        color: #b0b8c1 !important;
        background: transparent !important;
        box-shadow: none !important;
        text-decoration: none !important;
    }
    #eventsTable_wrapper .dataTables_paginate .page-link:hover { color: #555 !important; }
    #eventsTable_wrapper .dataTables_paginate .page-item.active .page-link {
        color: #4DD0CA !important;
        font-weight: 700 !important;
    }
    #eventsTable_wrapper .dataTables_paginate .page-item.previous .page-link,
    #eventsTable_wrapper .dataTables_paginate .page-item.next .page-link {
        font-size: 26px !important;
        width: 44px !important;
        min-width: 44px !important;
        height: 30px !important;
        padding: 0 !important;
        background: transparent !important;
    }
    #eventsTable_wrapper .dataTables_paginate .page-item.previous .page-link::before,
    #eventsTable_wrapper .dataTables_paginate .page-item.next .page-link::after { content: none !important; }
    #eventsTable_wrapper .dataTables_paginate .page-item.disabled .page-link {
        color: #d5d9dd !important;
        cursor: default !important;
    }
    #eventsTable_wrapper > .row:last-child > div[class*="col-"] {
        flex: 0 0 100% !important;
        max-width: 100% !important;
    }

    /* Stat cards — same layout as users.ejs */
    .stat-cards-row {
        gap: 15px;
        margin-bottom: 20px;
        flex-wrap: wrap;
        width: 100%;
        box-sizing: border-box;
    }
    .stat-card {
        flex: 1 1 calc(33.333% - 10px);
        min-width: 280px;
        margin: 0 !important;
    }
    @media (max-width: 992px) {
        .stat-card {
            flex: 1 1 calc(50% - 8px);
            min-width: 250px;
        }
    }
    @media (max-width: 576px) {
        .stat-card {
            flex: 1 1 100%;
            min-width: 0;
        }
    }

    #batchReportModal {
        z-index: 200000 !important;
        position: fixed !important;
        pointer-events: auto !important;
    }
    #batchReportModal.show {
        display: block !important;
        opacity: 1 !important;
    }
    #batchReportModal .modal-dialog {
        z-index: 200001 !important;
    }
    #batchReportBackdrop {
        z-index: 199990 !important;
        background-color: rgba(0, 0, 0, 0.5) !important;
        opacity: 0.5 !important;
    }
    #batchReportModal .report-fields-list {
        max-height: 420px;
        overflow-y: auto;
        border: 1px solid #e9ecef;
        border-radius: 6px;
        padding: 10px 12px;
    }
    #batchReportModal .report-event-group {
        margin-bottom: 14px;
        padding-bottom: 10px;
        border-bottom: 1px solid #eef1f5;
    }
    #batchReportModal .report-event-group:last-child {
        margin-bottom: 0;
        padding-bottom: 0;
        border-bottom: none;
    }
    #batchReportModal .report-event-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 8px;
        margin-bottom: 6px;
        flex-wrap: wrap;
    }
    #batchReportModal .report-event-name {
        font-weight: 700;
        color: #1e293b;
        margin: 0;
        font-size: 14px;
    }
    #batchReportModal .report-field-item {
        display: block;
        margin-bottom: 4px;
        cursor: pointer;
    }
</style>

<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header") %>
    <div class="content">
        <div class="animated fadeIn">
            <%
                let totalGuests = 0;
                let checkedInGuests = 0;
                (events || []).forEach(function(ev) {
                    const users = ev.users || [];
                    totalGuests += users.length;
                    checkedInGuests += users.filter(function(u) { return u.isCheckIn; }).length;
                });
                const checkInRate = totalGuests > 0
                    ? ((checkedInGuests / totalGuests) * 100).toFixed(2)
                    : '0.00';
            %>
            <div class="d-flex stat-cards-row">
                <div class="card stat-card">
                    <div class="card-body">
                        <div class="stat-widget-five">
                            <div class="stat-icon dib flat-color-1">
                                <i class="pe-7s-user"></i>
                            </div>
                            <div class="stat-content">
                                <div class="text-left dib">
                                    <div class="stat-text"><span class="count"><%= checkedInGuests %></span></div>
                                    <div class="stat-heading"><%= t('users.checkedInStat') %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stat-card">
                    <div class="card-body">
                        <div class="stat-widget-five">
                            <div class="stat-icon dib flat-color-2">
                                <i class="pe-7s-users"></i>
                            </div>
                            <div class="stat-content">
                                <div class="text-left dib">
                                    <div class="stat-text"><span class="count"><%= totalGuests %></span></div>
                                    <div class="stat-heading"><%= t('users.totalStat') %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="card stat-card">
                    <div class="card-body">
                        <div class="stat-widget-five">
                            <div class="stat-icon dib flat-color-3">
                                <i class="pe-7s-calculator"></i>
                            </div>
                            <div class="stat-content">
                                <div class="text-left dib">
                                    <div class="stat-text"><span class="count"><%= checkInRate %></span>%</div>
                                    <div class="stat-heading"><%= t('users.checkInRateStat') %></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header card-header-with-action">
                            <strong class="card-title"><%= t('events_list.title') %></strong>
                            <div style="display:inline-flex; align-items:center; gap:12px; flex-wrap:wrap;">
                                <button type="button" class="btn btn-sm btn-info" id="exportCheckInListBtn">
                                    <i class="fas fa-download"></i> <%= t('events_list.exportCheckInList') %>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-info" id="exportFormPackageBtn" title="<%= t('events_list.exportFormPackageHint') %>">
                                    <i class="fas fa-file-export"></i> <%= t('events_list.exportFormPackage') %>
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-secondary" id="importFormPackageBtn" title="<%= t('events_list.importFormPackageHint') %>">
                                    <i class="fas fa-file-import"></i> <%= t('events_list.importFormPackage') %>
                                </button>
                                <input type="file" id="importFormPackageFile" accept=".json,application/json" class="d-none">
                                <a href="/auth/users" title="Login Account Management" data-toggle="tooltip" data-placement="left" style="color:#90a4ae; font-size:1.2em; line-height:1; text-decoration:none;">
                                    <i class="fa fa-users"></i>
                                </a>
                                <a href="/events/create" class="btn btn-sm btn-primary"><i class="fa fa-plus"></i> <%= t('events_list.createEvent') %></a>
                            </div>
                        </div>
                        <div class="card-body events-table-area">
                            <table id="eventsTable" class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th style="width:42px;">
                                            <input type="checkbox" id="selectAllEvents" title="<%= t('events_list.selectAll') %>">
                                        </th>
                                        <th><%= t('events_list.eventName') %></th>
                                        <th><%= t('events_list.startTime') %></th>
                                        <th><%= t('events_list.endTime') %></th>
                                        <th><%= t('events_list.createdAt') %></th>
                                        <th><%= t('events_list.userCount') %></th>
                                        <th><%= t('events_list.actions') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (events.length > 0) { %>
                                        <% events.forEach(event => { %>
                                            <tr>
                                                <td>
                                                    <input type="checkbox" class="event-export-cb" value="<%= event._id %>">
                                                </td>
                                                <td><a href="/events/<%= event._id %>"><%= event.name %></a></td>
                                                <td><%= new Date(event.from).toLocaleString() %></td>
                                                <td><%= new Date(event.to).toLocaleString() %></td>
                                                <td data-order="<%= new Date(event.created_at).getTime() %>"><%= new Date(event.created_at).toLocaleString() %></td>
                                                <td><%= event.users.length %></td>
                                                <td>
                                                    <button type="button" class="btn btn-sm btn-outline-secondary copy-event-btn"
                                                            data-event-id="<%= event._id %>"
                                                            data-event-name="<%= String(event.name || '').replace(/"/g, '&quot;') %>"
                                                            title="<%= t('events_list.copyEvent') %>">
                                                        <i class="fa fa-copy"></i> <%= t('events_list.copyEvent') %>
                                                    </button>
                                                </td>
                                            </tr>
                                        <% }); %>
                                    <% } else { %>
                                        <tr>
                                            <td colspan="7" class="text-center"><%= t('events_list.noEvents') %></td>
                                        </tr>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="batchReportModal" tabindex="-1" role="dialog" aria-labelledby="batchReportModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title" id="batchReportModalLabel"><%= t('events_list.reportModalTitle') %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2"><%= t('events_list.reportModalHint') %></p>
                <div class="mb-2">
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="batchReportSelectAllBtn"><%= t('events_list.reportSelectAll') %></button>
                    <button type="button" class="btn btn-sm btn-outline-secondary" id="batchReportDeselectAllBtn"><%= t('events_list.reportDeselectAll') %></button>
                </div>
                <div id="batchReportFieldsList" class="report-fields-list"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
                <button type="button" class="btn btn-info" id="confirmBatchReportDownload">
                    <i class="fa fa-download"></i> <%= t('events_list.reportDownload') %>
                </button>
            </div>
        </div>
    </div>
</div>

<div class="modal" id="formPackagePickModal" tabindex="-1" role="dialog" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title"><%= t('events_list.importFormPackage') %></h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p class="text-muted small mb-2"><%= t('events_list.importPickPackage') %></p>
                <div id="formPackagePickList"></div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
                <button type="button" class="btn btn-primary" id="confirmFormPackageImport"><%= t('events_list.importFormPackage') %></button>
            </div>
        </div>
    </div>
</div>

<%- include ("components/footer") %>
<script src="/admin/assets/js/lib/data-table/datatables.min.js"></script>
<script src="/admin/assets/js/lib/data-table/dataTables.bootstrap.min.js"></script>
<script type="text/javascript">
$(document).ready(function() {
    $('[data-toggle="tooltip"]').tooltip();

    var MAX_BATCH_EVENTS = 6;
    var i18n = {
        selectFirst: <%- JSON.stringify(t('events_list.selectEventsFirst')) %>,
        exportMaxEvents: <%- JSON.stringify(t('events_list.exportMaxEvents')) %>,
        exporting: <%- JSON.stringify(t('events_list.exporting')) %>,
        exportFailed: <%- JSON.stringify(t('events_list.exportFailed')) %>,
        exportLabel: <%- JSON.stringify(t('events_list.exportCheckInList')) %>,
        reportEventSelectAll: <%- JSON.stringify(t('events_list.reportEventSelectAll')) %>,
        reportEventDeselectAll: <%- JSON.stringify(t('events_list.reportEventDeselectAll')) %>,
        reportNoFields: <%- JSON.stringify(t('events_list.reportNoFields')) %>,
        reportFieldsFailed: <%- JSON.stringify(t('events_list.reportFieldsFailed')) %>,
        copyConfirm: <%- JSON.stringify(t('events_list.copyConfirm')) %>,
        copying: <%- JSON.stringify(t('events_list.copying')) %>,
        copySuccess: <%- JSON.stringify(t('events_list.copySuccess')) %>,
        copyFailed: <%- JSON.stringify(t('events_list.copyFailed')) %>,
        copyLabel: <%- JSON.stringify(t('events_list.copyEvent')) %>,
        exportFormPackage: <%- JSON.stringify(t('events_list.exportFormPackage')) %>,
        importFormPackage: <%- JSON.stringify(t('events_list.importFormPackage')) %>,
        importSelectOneTarget: <%- JSON.stringify(t('events_list.importSelectOneTarget')) %>,
        importConfirm: <%- JSON.stringify(t('events_list.importConfirm')) %>,
        importing: <%- JSON.stringify(t('events_list.importing')) %>,
        importSuccess: <%- JSON.stringify(t('events_list.importSuccess')) %>,
        importFailed: <%- JSON.stringify(t('events_list.importFailed')) %>,
        formPackageNoFile: <%- JSON.stringify(t('events_list.formPackageNoFile')) %>
    };
    var selectedIds = {};
    var pendingExportEventIds = [];
    var pendingImportFile = null;
    var pendingImportTargetId = null;

    $('#batchReportModal').appendTo('body');

    function hidePageLoadingOverlay() {
        var overlay = document.getElementById('page-loading-overlay');
        if (!overlay) return;
        overlay.classList.add('page-loaded');
        overlay.style.display = 'none';
        overlay.style.pointerEvents = 'none';
    }

    function showBatchReportModal() {
        hidePageLoadingOverlay();
        var $modal = $('#batchReportModal').appendTo('body');
        $('.modal-backdrop').remove();
        $('<div class="modal-backdrop show" id="batchReportBackdrop"></div>')
            .css({ zIndex: 199990, opacity: 0.5, display: 'block' })
            .appendTo('body');
        $modal.addClass('show').css({
            display: 'block',
            opacity: 1,
            zIndex: 200000,
            pointerEvents: 'auto'
        }).attr('aria-hidden', 'false');
        $('body').addClass('modal-open');
    }

    function hideBatchReportModal() {
        $('#batchReportModal').removeClass('show').css('display', 'none').attr('aria-hidden', 'true');
        $('#batchReportBackdrop, .modal-backdrop').remove();
        $('body').removeClass('modal-open').css({ 'padding-right': '', overflow: '' });
    }

    var table = $('#eventsTable').DataTable({
        pageLength: 25,
        dom: 'rtip',
        autoWidth: true,
        columnDefs: [
            { targets: 0, orderable: false, searchable: false },
            { targets: 4, type: 'num', orderable: true, searchable: false },
            { targets: 5, type: 'num', orderable: true },
            { targets: 6, orderable: false, searchable: false }
        ],
        order: [[4, 'desc']],
        initComplete: function() {
            if (!$('#eventsTable').parent().hasClass('events-table-xscroll')) {
                $('#eventsTable').wrap('<div class="events-table-xscroll"></div>');
            }
            fixPaginationArrows();
            initDragScroll();
        },
        drawCallback: function() {
            fixPaginationArrows();
            restoreCheckboxState();
            syncSelectAllState();
        }
    });

    function fixPaginationArrows() {
        $('#eventsTable_wrapper .paginate_button.previous a').html('&#8249;');
        $('#eventsTable_wrapper .paginate_button.next a').html('&#8250;');
        $('#eventsTable_wrapper .page-item.previous .page-link, #eventsTable_wrapper .page-item.next .page-link')
            .css({ background: 'transparent', 'border-color': 'transparent' });
    }

    function initDragScroll() {
        const el = document.querySelector('.events-table-xscroll');
        if (!el) return;
        let drag = { active: false, x: 0, scroll: 0, moved: false };
        el.addEventListener('mousedown',  function(e) {
            if (e.target && (e.target.tagName === 'INPUT' || e.target.tagName === 'BUTTON' || e.target.closest('a') || e.target.closest('button'))) return;
            drag = { active: true, x: e.clientX, scroll: el.scrollLeft, moved: false };
            el.classList.add('is-dragging');
        });
        el.addEventListener('mouseup',    function() { drag.active = false; el.classList.remove('is-dragging'); });
        el.addEventListener('mouseleave', function() { drag.active = false; el.classList.remove('is-dragging'); });
        el.addEventListener('mousemove',  function(e) {
            if (!drag.active) return;
            const dx = drag.x - e.clientX;
            if (Math.abs(dx) > 5) drag.moved = true;
            el.scrollLeft = drag.scroll + dx;
        });
        el.addEventListener('click', function(e) {
            if (drag.moved) { e.preventDefault(); e.stopPropagation(); drag.moved = false; }
        });
    }

    function restoreCheckboxState() {
        $('#eventsTable tbody .event-export-cb').each(function() {
            $(this).prop('checked', !!selectedIds[$(this).val()]);
        });
    }

    function getSelectedEventIds() {
        return Object.keys(selectedIds);
    }

    function syncSelectAllState() {
        var $boxes = $('#eventsTable tbody .event-export-cb');
        var total = $boxes.length;
        var checked = $boxes.filter(':checked').length;
        $('#selectAllEvents').prop('checked', total > 0 && checked === total);
    }

    // 全選：目前頁面所有列，最多 6 個
    $('#selectAllEvents').on('change', function() {
        var checked = $(this).is(':checked');
        if (!checked) {
            table.rows({ page: 'current' }).nodes().to$().find('.event-export-cb').each(function() {
                var id = $(this).val();
                $(this).prop('checked', false);
                delete selectedIds[id];
            });
            return;
        }
        var remaining = MAX_BATCH_EVENTS - Object.keys(selectedIds).length;
        var skipped = false;
        table.rows({ page: 'current' }).nodes().to$().find('.event-export-cb').each(function() {
            var id = $(this).val();
            if (selectedIds[id]) {
                $(this).prop('checked', true);
                return;
            }
            if (remaining <= 0) {
                skipped = true;
                $(this).prop('checked', false);
                return;
            }
            $(this).prop('checked', true);
            selectedIds[id] = true;
            remaining -= 1;
        });
        if (skipped) {
            alert(i18n.exportMaxEvents);
        }
        syncSelectAllState();
    });

    $(document).on('change', '#eventsTable .event-export-cb', function() {
        var id = $(this).val();
        if ($(this).is(':checked')) {
            if (Object.keys(selectedIds).length >= MAX_BATCH_EVENTS) {
                $(this).prop('checked', false);
                alert(i18n.exportMaxEvents);
            } else {
                selectedIds[id] = true;
            }
        } else {
            delete selectedIds[id];
        }
        syncSelectAllState();
    });

    function renderBatchReportFields(eventGroups) {
        var html = '';
        (eventGroups || []).forEach(function(group) {
            var eventId = group.eventId || '';
            var eventName = group.eventName || eventId;
            if (!eventId) return;
            html += '<div class="report-event-group" data-event-id="' + $('<div>').text(eventId).html() + '">';
            html += '<div class="report-event-head">';
            html += '<p class="report-event-name">' + $('<div>').text(eventName).html() + '</p>';
            html += '<div>';
            html += '<button type="button" class="btn btn-sm btn-outline-secondary js-event-select-all">' + i18n.reportEventSelectAll + '</button> ';
            html += '<button type="button" class="btn btn-sm btn-outline-secondary js-event-deselect-all">' + i18n.reportEventDeselectAll + '</button>';
            html += '</div></div>';
            (group.fields || []).forEach(function(field) {
                var key = field.key || '';
                var label = field.label || key;
                if (!key) return;
                html += '<label class="report-field-item">'
                    + '<input type="checkbox" class="batch-report-field-cb" data-event-id="' + $('<div>').text(eventId).html() + '" value="' + String(key).replace(/"/g, '&quot;') + '" checked> '
                    + $('<div>').text(label).html()
                    + ' <small class="text-muted">(' + $('<div>').text(key).html() + ')</small>'
                    + '</label>';
            });
            html += '</div>';
        });
        $('#batchReportFieldsList').html(html || '<p class="text-muted mb-0">—</p>');
    }

    function downloadBatchReport(eventIds, fieldsByEvent) {
        var $btn = $('#exportCheckInListBtn').prop('disabled', true);
        var originalHtml = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i> ' + i18n.exporting);
        $('#confirmBatchReportDownload').prop('disabled', true);

        fetch('/events/export-checkin-list', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ eventIds: eventIds, fieldsByEvent: fieldsByEvent }),
            credentials: 'same-origin'
        }).then(function(res) {
            if (!res.ok) {
                return res.json().catch(function() { return {}; }).then(function(body) {
                    throw new Error((body && body.message) || i18n.exportFailed);
                });
            }
            var disposition = res.headers.get('Content-Disposition') || '';
            var match = disposition.match(/filename[^;=\n]*=((['"]).*?\2|[^;\n]*)/);
            var filename = (match && match[1]) ? match[1].replace(/['"]/g, '') : 'events_checkin_list.xlsx';
            return res.blob().then(function(blob) {
                return { blob: blob, filename: filename };
            });
        }).then(function(result) {
            var url = URL.createObjectURL(result.blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = result.filename;
            document.body.appendChild(a);
            a.click();
            a.remove();
            URL.revokeObjectURL(url);
        }).catch(function(err) {
            alert(err.message || i18n.exportFailed);
        }).finally(function() {
            $btn.prop('disabled', false).html(originalHtml);
            $('#confirmBatchReportDownload').prop('disabled', false);
        });
    }

    $(document).off('click.batchReportSelectAll').on('click.batchReportSelectAll', '#batchReportSelectAllBtn', function() {
        $('#batchReportFieldsList .batch-report-field-cb').prop('checked', true);
    });
    $(document).off('click.batchReportDeselectAll').on('click.batchReportDeselectAll', '#batchReportDeselectAllBtn', function() {
        $('#batchReportFieldsList .batch-report-field-cb').prop('checked', false);
    });

    $(document).off('click.batchReportEventSelect').on('click.batchReportEventSelect', '.js-event-select-all', function() {
        $(this).closest('.report-event-group').find('.batch-report-field-cb').prop('checked', true);
    });
    $(document).off('click.batchReportEventDeselect').on('click.batchReportEventDeselect', '.js-event-deselect-all', function() {
        $(this).closest('.report-event-group').find('.batch-report-field-cb').prop('checked', false);
    });

    $(document).off('click.confirmBatchReport').on('click.confirmBatchReport', '#confirmBatchReportDownload', function() {
        var fieldsByEvent = {};
        var missing = false;
        $('#batchReportFieldsList .report-event-group').each(function() {
            var eventId = ($(this).attr('data-event-id') || '').trim();
            if (!eventId) return;
            var fields = [];
            $(this).find('.batch-report-field-cb:checked').each(function() {
                var v = ($(this).val() || '').trim();
                if (v) fields.push(v);
            });
            if (!fields.length) missing = true;
            fieldsByEvent[eventId] = fields;
        });
        if (missing || !Object.keys(fieldsByEvent).length) {
            alert(i18n.reportNoFields);
            return;
        }
        hideBatchReportModal();
        downloadBatchReport(pendingExportEventIds, fieldsByEvent);
    });

    $(document).off('click.batchReportClose').on('click.batchReportClose', '#batchReportModal [data-dismiss="modal"], #batchReportBackdrop', function() {
        hideBatchReportModal();
    });

    $(document).off('click.exportCheckInList').on('click.exportCheckInList', '#exportCheckInListBtn', function(e) {
        e.preventDefault();
        e.stopPropagation();
        var eventIds = getSelectedEventIds();
        if (!eventIds.length) {
            alert(i18n.selectFirst);
            return;
        }
        if (eventIds.length > MAX_BATCH_EVENTS) {
            alert(i18n.exportMaxEvents);
            return;
        }

        var $btn = $(this).prop('disabled', true);
        var originalHtml = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i> ' + i18n.exporting);

        fetch('/events/export-checkin-list/fields', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ eventIds: eventIds }),
            credentials: 'same-origin'
        }).then(function(res) {
            return res.json().then(function(body) {
                if (!res.ok || !body.success) {
                    throw new Error((body && body.message) || i18n.reportFieldsFailed);
                }
                return body;
            });
        }).then(function(body) {
            pendingExportEventIds = eventIds.slice();
            renderBatchReportFields(body.events || []);
            showBatchReportModal();
        }).catch(function(err) {
            alert(err.message || i18n.reportFieldsFailed);
        }).finally(function() {
            $btn.prop('disabled', false).html(originalHtml);
        });
    });

    $(document).on('click', '.copy-event-btn', function() {
        var $btn = $(this);
        var eventId = $btn.data('event-id');
        if (!eventId) return;
        if (!confirm(i18n.copyConfirm)) return;

        var originalHtml = $btn.html();
        $btn.prop('disabled', true).html('<i class="fas fa-spinner fa-spin"></i> ' + i18n.copying);

        fetch('/events/' + eventId + '/copy', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            credentials: 'same-origin'
        }).then(function(res) {
            return res.json().then(function(body) {
                if (!res.ok || !body.success) {
                    throw new Error((body && body.message) || i18n.copyFailed);
                }
                return body;
            });
        }).then(function(body) {
            var name = (body.event && body.event.name) || '';
            alert(i18n.copySuccess + name);
            window.location.reload();
        }).catch(function(err) {
            alert(err.message || i18n.copyFailed);
            $btn.prop('disabled', false).html(originalHtml);
        });
    });

    function downloadBlob(blob, filename) {
        var url = URL.createObjectURL(blob);
        var a = document.createElement('a');
        a.href = url;
        a.download = filename || 'form_package.json';
        document.body.appendChild(a);
        a.click();
        a.remove();
        setTimeout(function() { URL.revokeObjectURL(url); }, 1000);
    }

    function filenameFromContentDisposition(header) {
        if (!header) return '';
        var m = /filename\*?=(?:UTF-8''|")?([^\";]+)/i.exec(header);
        if (!m) return '';
        try { return decodeURIComponent(m[1].replace(/"/g, '').trim()); } catch (e) { return m[1].replace(/"/g, '').trim(); }
    }

    $(document).on('click', '#exportFormPackageBtn', function(e) {
        e.preventDefault();
        var eventIds = getSelectedEventIds();
        if (!eventIds.length) {
            alert(i18n.selectFirst);
            return;
        }
        if (eventIds.length > MAX_BATCH_EVENTS) {
            alert(i18n.exportMaxEvents);
            return;
        }
        var $btn = $(this).prop('disabled', true);
        var originalHtml = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i> ' + i18n.exporting);

        fetch('/events/export-form-package', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ eventIds: eventIds }),
            credentials: 'same-origin'
        }).then(function(res) {
            if (!res.ok) {
                return res.json().then(function(body) {
                    throw new Error((body && (body.message || body.error)) || i18n.exportFailed);
                }).catch(function(err) {
                    if (err instanceof Error && err.message !== i18n.exportFailed) throw err;
                    throw new Error(i18n.exportFailed);
                });
            }
            var cd = res.headers.get('Content-Disposition');
            var filename = filenameFromContentDisposition(cd) || 'form_package.json';
            return res.blob().then(function(blob) {
                downloadBlob(blob, filename);
            });
        }).catch(function(err) {
            alert(err.message || i18n.exportFailed);
        }).finally(function() {
            $btn.prop('disabled', false).html(originalHtml);
        });
    });

    function postImportFormPackage(file, targetEventId, packageIndex, preview) {
        var fd = new FormData();
        fd.append('file', file);
        fd.append('targetEventId', targetEventId);
        if (typeof packageIndex === 'number') fd.append('packageIndex', String(packageIndex));
        if (preview) fd.append('preview', '1');
        return fetch('/events/import-form-package', {
            method: 'POST',
            body: fd,
            credentials: 'same-origin'
        }).then(function(res) {
            return res.json().then(function(body) {
                if (!res.ok || !body.success) {
                    throw new Error((body && body.message) || i18n.importFailed);
                }
                return body;
            });
        });
    }

    function runImportWithIndex(packageIndex) {
        if (!pendingImportFile || !pendingImportTargetId) {
            return Promise.resolve();
        }
        if (!confirm(i18n.importConfirm)) {
            return Promise.resolve();
        }
        var $btn = $('#importFormPackageBtn').prop('disabled', true);
        var originalHtml = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i> ' + i18n.importing);
        return postImportFormPackage(pendingImportFile, pendingImportTargetId, packageIndex, false)
            .then(function(body) {
                alert(i18n.importSuccess + (body.targetEventName || ''));
                pendingImportFile = null;
                pendingImportTargetId = null;
                $('#importFormPackageFile').val('');
                $('#formPackagePickModal').modal('hide');
            })
            .catch(function(err) {
                alert(err.message || i18n.importFailed);
            })
            .finally(function() {
                $btn.prop('disabled', false).html(originalHtml);
            });
    }

    $(document).on('click', '#importFormPackageBtn', function(e) {
        e.preventDefault();
        var eventIds = getSelectedEventIds();
        if (eventIds.length !== 1) {
            alert(i18n.importSelectOneTarget);
            return;
        }
        pendingImportTargetId = eventIds[0];
        $('#importFormPackageFile').val('').trigger('click');
    });

    $(document).on('change', '#importFormPackageFile', function() {
        var file = this.files && this.files[0];
        if (!file) return;
        if (!pendingImportTargetId) {
            alert(i18n.importSelectOneTarget);
            return;
        }
        pendingImportFile = file;
        var $btn = $('#importFormPackageBtn').prop('disabled', true);
        var originalHtml = $btn.html();
        $btn.html('<i class="fas fa-spinner fa-spin"></i> ' + i18n.importing);

        postImportFormPackage(file, pendingImportTargetId, 0, true)
            .then(function(body) {
                var list = body.packages || [];
                if (list.length <= 1) {
                    $btn.prop('disabled', false).html(originalHtml);
                    return runImportWithIndex(0);
                }
                var html = '';
                list.forEach(function(p) {
                    html += '<div class="form-check mb-2">' +
                        '<input class="form-check-input" type="radio" name="formPackagePick" id="fpick' + p.index + '" value="' + p.index + '"' + (p.index === 0 ? ' checked' : '') + '>' +
                        '<label class="form-check-label" for="fpick' + p.index + '">' +
                        (p.sourceEventName || ('#' + p.index)) +
                        ' <span class="text-muted small">(' + (p.emailTemplateCount || 0) + ' emails' + (p.hasFormConfig ? ', form' : '') + ')</span>' +
                        '</label></div>';
                });
                $('#formPackagePickList').html(html);
                $('#formPackagePickModal').appendTo('body').modal('show');
            })
            .catch(function(err) {
                alert(err.message || i18n.importFailed);
                pendingImportFile = null;
                $('#importFormPackageFile').val('');
            })
            .finally(function() {
                if ($('#formPackagePickModal').hasClass('show') || $('#formPackagePickModal').is(':visible')) {
                    $btn.prop('disabled', false).html(originalHtml);
                } else if ($btn.prop('disabled') && $btn.html().indexOf('fa-spinner') >= 0) {
                    // single-package path handed off to runImportWithIndex
                } else {
                    $btn.prop('disabled', false).html(originalHtml);
                }
            });
    });

    $(document).on('click', '#confirmFormPackageImport', function() {
        var idx = parseInt($('input[name="formPackagePick"]:checked').val(), 10);
        if (Number.isNaN(idx)) idx = 0;
        runImportWithIndex(idx);
    });
});
</script>
