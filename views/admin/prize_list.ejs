<%- include ("components/header") %>
<%- include ("components/menu", {eventId: eventId }) %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<%- include("components/responsive_layout_style") %>
<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header") %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title"><%= t('prize_list.title') %> - <%= event.name %></strong>
                        </div>
                        <div class="card-body">
                            <table id="bootstrap-data-table" class="table table-bordered">
                                <thead>
                                    <tr>
                                        <th><%= t('prize_list.prizeName') %></th>
                                        <th><%= t('common.image') %></th>
                                        <th><%= t('common.quantity') %></th>
                                        <th><%= t('common.created_at') %></th>
                                        <th><%= t('common.actions') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% prizes.forEach(prize => { %>
                                        <tr>
                                            <td><%= prize.name %></td>
                                            <td>
                                                <% if (prize.picture) { %>
                                                    <img src="<%= prize.picture %>" alt="<%= prize.name %>" style="max-width: 50px; max-height: 50px; object-fit: cover; border-radius: 4px;">
                                                <% } else { %>
                                                    <span class="text-muted"><%= t('common.noImage') %></span>
                                                <% } %>
                                            </td>
                                            <td><%= prize.unit %></td>
                                            <td class="prize-date"><%= prize.created_at %></td>
                                            <td>
                                                <a href="/prizes/<%= eventId %>/prizes/<%= prize._id %>/edit" class="btn btn-sm btn-primary"><i class="fa fa-edit"></i> <%= t('common.edit') %></a>
                                                <button class="btn btn-sm btn-danger" onclick="deletePrize('<%= prize._id %>')"><i class="fa fa-trash"></i> <%= t('common.delete') %></button>
                                            </td>
                                        </tr>
                                    <% }); %>
                                </tbody>
                            </table>
                            <div class="mb-3">
                                <a href="/prizes/<%= eventId %>/prizes/create" class="btn btn-primary"><i class="fa fa-plus"></i> <%= t('prize_list.addPrize') %></a>
                                <button type="button" class="btn btn-success" data-toggle="modal" data-target="#batchUploadModal"><i class="fa fa-upload"></i> <%= t('prize_list.batchUpload') %></button>
                                <a href="/prizes/<%= eventId %>/prizes/download-sample" class="btn btn-info"><i class="fa fa-download"></i> <%= t('prize_list.downloadTemplate') %></a>
                                <button type="button" class="btn btn-danger" onclick="deleteAllPrizes()"><i class="fa fa-trash"></i> <%= t('prize_list.deleteAll') %></button>
                            </div>

                            <div class="modal fade" id="batchUploadModal" tabindex="-1" role="dialog" aria-hidden="true">
                                <div class="modal-dialog" role="document">
                                    <div class="modal-content">
                                        <div class="modal-header">
                                            <h5 class="modal-title"><%= t('prize_list.batchUploadTitle') %></h5>
                                            <button type="button" class="close" data-dismiss="modal"><span>&times;</span></button>
                                        </div>
                                        <div class="modal-body">
                                            <form id="batchUploadForm" enctype="multipart/form-data">
                                                <div class="form-group">
                                                    <label for="excelFile"><%= t('prize_list.selectExcel') %></label>
                                                    <input type="file" class="form-control-file" id="excelFile" name="file" accept=".xlsx,.xls" required>
                                                    <small class="form-text text-muted"><%= t('prize_list.excelNote') %></small>
                                                </div>
                                                <div id="uploadProgress" class="progress" style="display: none;">
                                                    <div class="progress-bar progress-bar-striped progress-bar-animated" role="progressbar" style="width: 100%"></div>
                                                </div>
                                                <div id="uploadMessage" class="alert" style="display: none;"></div>
                                            </form>
                                        </div>
                                        <div class="modal-footer">
                                            <button type="button" class="btn btn-secondary" data-dismiss="modal"><%= t('common.cancel') %></button>
                                            <button type="button" class="btn btn-primary" onclick="submitBatchUpload()"><%= t('common.upload') %></button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include ("components/footer_minimal") %>
<script src="/admin/assets/js/lib/data-table/datatables.min.js"></script>
<script src="/admin/assets/js/lib/data-table/dataTables.bootstrap.min.js"></script>
<script src="/admin/assets/js/lib/data-table/dataTables.buttons.min.js"></script>
<script src="/admin/assets/js/lib/data-table/buttons.bootstrap.min.js"></script>
<script src="/admin/assets/js/lib/data-table/jszip.min.js"></script>
<script src="/admin/assets/js/lib/data-table/vfs_fonts.js"></script>
<script src="/admin/assets/js/lib/data-table/buttons.html5.min.js"></script>
<script src="/admin/assets/js/lib/data-table/buttons.print.min.js"></script>
<script src="/admin/assets/js/lib/data-table/buttons.colVis.min.js"></script>
<script src="/admin/assets/js/init/datatables-init.js"></script>
<script>
(function () {
    var MSG = {
        confirmDelete: <%- JSON.stringify(t('prize_list.confirmDelete')) %>,
        deleteFailed: <%- JSON.stringify(t('prize_list.deleteFailed')) %>,
        selectFile: <%- JSON.stringify(t('prize_list.selectFile')) %>,
        uploadSuccess: <%- JSON.stringify(t('prize_list.uploadSuccess')) %>,
        uploadFailed: <%- JSON.stringify(t('prize_list.uploadFailed')) %>,
        noPrizes: <%- JSON.stringify(t('prize_list.noPrizes')) %>,
        deleteAllWarn: <%- JSON.stringify(t('prize_list.deleteAllWarn')) %>,
        deleteAllConfirm: <%- JSON.stringify(t('prize_list.deleteAllConfirm')) %>,
        deleteAllFinal: <%- JSON.stringify(t('prize_list.deleteAllFinal')) %>,
        deleteAllPrompt: <%- JSON.stringify(t('prize_list.deleteAllPrompt')) %>,
        deleteAllCancelled: <%- JSON.stringify(t('prize_list.deleteAllCancelled')) %>,
        deleteAllSuccess: <%- JSON.stringify(t('prize_list.deleteAllSuccess')) %>,
        deleteAllFailed: <%- JSON.stringify(t('prize_list.deleteAllFailed')) %>
    };
    var eventId = <%- JSON.stringify(String(eventId)) %>;
    var totalPrizes = <%= prizes.length %>;

    function withCount(template, count) {
        return String(template || '').replace('{count}', String(count));
    }

    document.addEventListener('DOMContentLoaded', function () {
        if (window.jQuery && jQuery.fn.DataTable) {
            jQuery('#bootstrap-data-table').DataTable();
            jQuery('.prize-date').each(function () {
                var dateStr = jQuery(this).text().trim();
                if (!dateStr) return;
                try {
                    jQuery(this).text(new Date(dateStr).toLocaleString('en-US', {
                        timeZone: 'Asia/Taipei',
                        year: 'numeric', month: '2-digit', day: '2-digit',
                        hour: '2-digit', minute: '2-digit', second: '2-digit',
                        hour12: false
                    }));
                } catch (e) {}
            });
        }
    });

    window.deletePrize = function (prizeId) {
        if (!confirm(MSG.confirmDelete)) return;
        fetch('/prizes/' + encodeURIComponent(eventId) + '/prizes/' + encodeURIComponent(prizeId), {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.message) { alert(data.message); location.reload(); }
        })
        .catch(function () { alert(MSG.deleteFailed); });
    };

    window.submitBatchUpload = function () {
        var fileInput = document.getElementById('excelFile');
        var file = fileInput && fileInput.files && fileInput.files[0];
        if (!file) { alert(MSG.selectFile); return; }
        var formData = new FormData();
        formData.append('file', file);
        var progressDiv = document.getElementById('uploadProgress');
        var messageDiv = document.getElementById('uploadMessage');
        progressDiv.style.display = 'block';
        messageDiv.style.display = 'none';
        fetch('/prizes/' + encodeURIComponent(eventId) + '/prizes/batch-upload', {
            method: 'POST',
            body: formData
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            progressDiv.style.display = 'none';
            messageDiv.style.display = 'block';
            if (data.success) {
                messageDiv.className = 'alert alert-success';
                messageDiv.textContent = withCount(MSG.uploadSuccess, data.importedCount);
                setTimeout(function () { location.reload(); }, 1500);
            } else {
                messageDiv.className = 'alert alert-danger';
                messageDiv.textContent = data.message || MSG.uploadFailed;
            }
        })
        .catch(function (err) {
            progressDiv.style.display = 'none';
            messageDiv.style.display = 'block';
            messageDiv.className = 'alert alert-danger';
            messageDiv.textContent = MSG.uploadFailed + ': ' + (err && err.message ? err.message : '');
        });
    };

    window.deleteAllPrizes = function () {
        if (totalPrizes === 0) { alert(MSG.noPrizes); return; }
        if (!confirm(withCount(MSG.deleteAllWarn, totalPrizes))) return;
        if (!confirm(withCount(MSG.deleteAllConfirm, totalPrizes))) return;
        if (!confirm(withCount(MSG.deleteAllFinal, totalPrizes))) return;
        var userInput = prompt(withCount(MSG.deleteAllPrompt, totalPrizes));
        if (userInput !== 'confirm delete') { alert(MSG.deleteAllCancelled); return; }
        fetch('/prizes/' + encodeURIComponent(eventId) + '/prizes', {
            method: 'DELETE',
            headers: { 'Content-Type': 'application/json' }
        })
        .then(function (r) { return r.json(); })
        .then(function (data) {
            if (data.success) {
                alert(withCount(MSG.deleteAllSuccess, data.deletedCount));
                location.reload();
            } else {
                alert(MSG.deleteAllFailed + (data.message || ''));
            }
        })
        .catch(function (err) {
            alert(MSG.deleteAllFailed + (err && err.message ? err.message : ''));
        });
    };
})();
</script>
