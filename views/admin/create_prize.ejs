<%- include ("components/header") %>
<%- include ("components/menu", {eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<div id="right-panel" class="right-panel">
    <%- include ("components/rightpanel_header") %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-md-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title"><%= t('create_prize.title') %> - <%= event.name %></strong>
                        </div>
                        <div class="card-body">
                            <form id="createPrizeForm">
                                <div class="form-group">
                                    <label for="name"><%= t('create_prize.prizeName') %></label>
                                    <input type="text" class="form-control" id="name" name="name" required>
                                </div>
                                <div class="form-group">
                                    <label for="prizeImage"><%= t('create_prize.prizeImage') %></label>
                                    <input type="file" class="form-control-file" id="prizeImage" name="prizeImage" accept="image/*">
                                    <small class="form-text text-muted"><%= t('create_prize.imageSupport') %></small>
                                </div>
                                <div class="form-group">
                                    <label for="picture"><%= t('create_prize.imageUrl') %></label>
                                    <input type="text" class="form-control" id="picture" name="picture" placeholder="https://example.com/image.jpg">
                                    <small class="form-text text-muted"><%= t('create_prize.imageUrlNote') %></small>
                                </div>
                                <div class="form-group">
                                    <label for="unit"><%= t('create_prize.quantity') %></label>
                                    <input type="number" class="form-control" id="unit" name="unit" value="1" min="1" required>
                                </div>
                                <button type="submit" class="btn btn-primary"><%= t('create_prize.addBtn') %></button>
                                <a href="/prizes/<%= eventId %>/prizes/list" class="btn btn-secondary"><%= t('create_prize.backToList') %></a>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include ("./components/footer") %>
<script>
    $(document).ready(function() {
        $('#createPrizeForm').on('submit', function(e) {
            e.preventDefault();
            const name = String($('#name').val() || '').trim();
            const unitRaw = String($('#unit').val() || '').trim();
            const unit = parseInt(unitRaw, 10);
            if (!name) { alert(t('create_prize.addFailed') + 'Name required'); return; }
            if (!Number.isFinite(unit) || unit < 1) { alert(t('create_prize.addFailed') + 'Invalid quantity'); return; }

            const imageFile = $('#prizeImage')[0].files[0];
            const picture = String($('#picture').val() || '').trim();
            const url = `/prizes/<%= eventId %>/prizes`;

            let req;
            if (imageFile) {
                const formData = new FormData();
                formData.append('name', name);
                formData.append('unit', String(unit));
                formData.append('prizeImage', imageFile);
                req = fetch(url, { method: 'POST', body: formData });
            } else {
                req = fetch(url, {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ name: name, unit: unit, picture: picture })
                });
            }

            req.then(async function(r) {
                let data = {};
                try { data = await r.json(); } catch (err) { data = {}; }
                if (!r.ok) {
                    alert(t('create_prize.addFailed') + (data.message || (' HTTP ' + r.status)));
                    return;
                }
                if (data._id) {
                    alert(t('create_prize.addSuccess'));
                    window.location.href = `/prizes/<%= eventId %>/prizes/list`;
                } else {
                    alert(t('create_prize.addFailed') + (data.message || ''));
                }
            }).catch(function() { alert(t('create_prize.addFailed')); });
        });
    });
</script>
