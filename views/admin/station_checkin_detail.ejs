<%- include("components/header") %>
<%- include("components/menu", { eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/style.css">
<link rel="stylesheet" href="/admin/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<style>
    .alert-container { position: fixed; top: 80px; right: 20px; z-index: 1050; min-width: 300px; }
    #reader { width: 100%; max-width: 360px; margin: 0 auto; }
    .scan-panel { border: 1px solid #e4e9f0; border-radius: 10px; padding: 16px; background: #fff; }
    .status-ok { color: #28a745; font-weight: 600; }
    .status-err { color: #dc3545; font-weight: 600; }
    .section-list-panel { border: 1px solid #e4e9f0; border-radius: 10px; padding: 16px; background: #fff; margin-bottom: 16px; }
    .section-list-hint { font-size: 0.875rem; color: #6b7a8d; }
    .badge-checked { background: #28a745; }
    .badge-pending { background: #6c757d; }
    #addUserSelect { max-width: 100%; }
</style>

<div id="right-panel" class="right-panel">
    <%- include("components/rightpanel_header", { backUrl: '/events/' + eventId + '/station-checkin' }) %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">
                                <%= t('station_checkin.stationDetailTitle') %>: <%= station.name %>
                            </strong>
                        </div>
                        <div class="card-body">
                            <div class="alert-container" id="alertContainer"></div>
                            <% if (station.description) { %>
                                <p class="text-muted"><%= station.description %></p>
                            <% } %>
                            <p class="text-muted small"><%= t('station_checkin.requireEntryNote') %></p>
                            <p class="text-muted small"><%= t('station_checkin.sectionListNote') %></p>

                            <div class="row">
                                <div class="col-md-5 mb-4">
                                    <div class="scan-panel">
                                        <h5><%= t('station_checkin.scanTitle') %></h5>
                                        <div id="reader"></div>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-primary btn-sm" id="startScanBtn"><%= t('station_checkin.startScan') %></button>
                                            <button type="button" class="btn btn-secondary btn-sm" id="stopScanBtn" disabled><%= t('station_checkin.stopScan') %></button>
                                        </div>
                                        <div id="scanResult" class="mt-3"></div>
                                    </div>

                                    <div class="scan-panel mt-3">
                                        <h5><%= t('station_checkin.manualTitle') %></h5>
                                        <div class="form-group">
                                            <label><%= t('station_checkin.selectUser') %></label>
                                            <select class="form-control" id="manualUserSelect">
                                                <option value=""><%= t('common.selectOption') %></option>
                                                <% (eligibleUsers || []).forEach(function(u) { %>
                                                    <option value="<%= u._id %>">
                                                        <%= u.name || '-' %><%= u.email ? ' (' + u.email + ')' : '' %>
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <button type="button" class="btn btn-success" id="manualCheckInBtn">
                                            <%= t('station_checkin.checkInBtn') %>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-7">
                                    <div class="section-list-panel">
                                        <div class="d-flex justify-content-between align-items-center mb-2">
                                            <h5 class="mb-0">
                                                <%= t('station_checkin.sectionListTitle') %>
                                                (<span class="badge badge-info" id="sectionListCount"><%= (sectionListUsers || []).length %></span>
                                            </h5>
                                        </div>
                                        <p class="section-list-hint mb-3"><%= t('station_checkin.sectionListHint') %></p>

                                        <div class="form-row align-items-end mb-3">
                                            <div class="form-group col-md-8 mb-2 mb-md-0">
                                                <label for="addUserSelect"><%= t('station_checkin.addToListLabel') %></label>
                                                <select class="form-control" id="addUserSelect" multiple size="6">
                                                    <% (addableUsers || []).forEach(function(u) { %>
                                                        <option value="<%= u._id %>">
                                                            <%= u.name || '-' %><%= u.email ? ' (' + u.email + ')' : '' %><%= u.isCheckIn ? '' : ' [' + t('station_checkin.notEntered') + ']' %>
                                                        </option>
                                                    <% }); %>
                                                </select>
                                                <small class="text-muted"><%= t('station_checkin.multiSelectHint') %></small>
                                            </div>
                                            <div class="form-group col-md-4 mb-0">
                                                <button type="button" class="btn btn-primary btn-block" id="addToListBtn">
                                                    <i class="fa fa-plus"></i> <%= t('station_checkin.addToListBtn') %>
                                                </button>
                                            </div>
                                        </div>

                                        <div class="table-responsive">
                                            <table id="sectionListTable" class="table table-sm table-striped table-bordered mb-0">
                                                <thead>
                                                    <tr>
                                                        <th><%= t('common.name') %></th>
                                                        <th><%= t('common.email') %></th>
                                                        <th><%= t('station_checkin.listStatus') %></th>
                                                        <th><%= t('common.actions') %></th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <% if (!sectionListUsers || sectionListUsers.length === 0) { %>
                                                        <tr class="empty-row">
                                                            <td colspan="4" class="text-muted text-center"><%= t('station_checkin.sectionListEmpty') %></td>
                                                        </tr>
                                                    <% } else { %>
                                                        <% sectionListUsers.forEach(function(u) { %>
                                                            <tr data-user-id="<%= u._id %>">
                                                                <td><%= u.name || '-' %></td>
                                                                <td><%= u.email || '-' %></td>
                                                                <td>
                                                                    <% if (u.stationCheckedIn) { %>
                                                                        <span class="badge badge-checked"><%= t('station_checkin.statusCheckedIn') %></span>
                                                                    <% } else if (!u.isCheckIn) { %>
                                                                        <span class="badge badge-warning"><%= t('station_checkin.notEntered') %></span>
                                                                    <% } else { %>
                                                                        <span class="badge badge-pending"><%= t('station_checkin.statusPending') %></span>
                                                                    <% } %>
                                                                </td>
                                                                <td>
                                                                    <% if (!u.stationCheckedIn && u.isCheckIn) { %>
                                                                        <button type="button" class="btn btn-sm btn-success list-checkin-btn"
                                                                            data-user-id="<%= u._id %>"
                                                                            data-user-name="<%= u.name || '' %>">
                                                                            <%= t('station_checkin.checkInBtn') %>
                                                                        </button>
                                                                    <% } %>
                                                                    <button type="button" class="btn btn-sm btn-outline-danger remove-from-list-btn"
                                                                        data-user-id="<%= u._id %>"
                                                                        data-user-name="<%= u.name || '' %>">
                                                                        <%= t('station_checkin.removeFromListBtn') %>
                                                                    </button>
                                                                </td>
                                                            </tr>
                                                        <% }); %>
                                                    <% } %>
                                                </tbody>
                                            </table>
                                        </div>
                                    </div>

                                    <h5><%= t('station_checkin.recordsTitle') %> (<%= (records || []).length %>)</h5>
                                    <table id="recordsTable" class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th><%= t('common.name') %></th>
                                                <th><%= t('common.email') %></th>
                                                <th><%= t('station_checkin.checkedInAt') %></th>
                                                <th><%= t('station_checkin.checkedInBy') %></th>
                                                <th><%= t('common.actions') %></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% (records || []).forEach(function(r) { %>
                                                <tr>
                                                    <td><%= r.userName || '-' %></td>
                                                    <td><%= r.userEmail || '-' %></td>
                                                    <td><%= r.checkedInAt ? new Date(r.checkedInAt).toLocaleString('zh-HK', { timeZone: 'Asia/Hong_Kong', hour12: false }) : '-' %></td>
                                                    <td><%= r.checkedInBy || '-' %></td>
                                                    <td>
                                                        <button type="button"
                                                            class="btn btn-sm btn-warning uncheck-btn"
                                                            data-user-id="<%= r.userId %>"
                                                            data-user-name="<%= r.userName || '' %>">
                                                            <%= t('station_checkin.uncheckBtn') %>
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include("components/footer_minimal") %>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="/admin/assets/js/lib/data-table/datatables.min.js"></script>
<script src="/admin/assets/js/lib/data-table/dataTables.bootstrap.min.js"></script>
<script>
jQuery(function($) {
    var eventId = '<%= eventId %>';
    var stationId = '<%= station._id %>';
    var html5QrCode = null;
    var scanning = false;
    var i18n = {
        notInList: <%- JSON.stringify(t('station_checkin.notInListAlert')) %>,
        removeConfirm: <%- JSON.stringify(t('station_checkin.removeFromListConfirm')) %>,
        removeSuccess: <%- JSON.stringify(t('station_checkin.removeFromListSuccess')) %>,
        addSuccess: <%- JSON.stringify(t('station_checkin.addToListSuccess')) %>,
        selectAddFirst: <%- JSON.stringify(t('station_checkin.selectAddFirst')) %>,
        checkInSuccess: <%- JSON.stringify(t('station_checkin.checkInSuccess')) %>,
        selectUserFirst: <%- JSON.stringify(t('station_checkin.selectUserFirst')) %>,
        uncheckConfirm: <%- JSON.stringify(t('station_checkin.uncheckConfirm')) %>,
        uncheckSuccess: <%- JSON.stringify(t('station_checkin.uncheckSuccess')) %>,
        processing: <%- JSON.stringify(t('station_checkin.processing')) %>
    };

    if ($.fn.DataTable) {
        $('#recordsTable').DataTable({ order: [[2, 'desc']], pageLength: 25 });
    }

    function showAlert(type, msg) {
        var html = '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
            msg +
            '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button></div>';
        var $a = $(html);
        $('#alertContainer').append($a);
        setTimeout(function() { $a.alert('close'); }, 4500);
    }

    function alertBox(msg) {
        window.alert(msg);
        showAlert('danger', msg);
    }

    function formatNotInListMsg(res) {
        var name = (res && res.user && res.user.name) ? res.user.name : '';
        var email = (res && res.user && res.user.email) ? res.user.email : '';
        var label = name || email || '';
        return i18n.notInList.replace('{name}', label || '-');
    }

    function handleCheckInError(xhr) {
        var body = xhr.responseJSON || {};
        if (body.code === 'NOT_IN_STATION_LIST') {
            alertBox(formatNotInListMsg(body));
            return;
        }
        showAlert('danger', body.message || 'Error');
    }

    $(document).on('click', '.uncheck-btn', function() {
        var userId = $(this).data('user-id');
        var userName = $(this).data('user-name') || userId;
        if (!userId) return;
        if (!confirm(i18n.uncheckConfirm.replace('{name}', userName))) return;

        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: '/events/' + eventId + '/station-checkin/' + stationId + '/checkin/' + userId,
            method: 'DELETE',
            success: function() {
                showAlert('success', i18n.uncheckSuccess);
                setTimeout(function() { location.reload(); }, 600);
            },
            error: function(xhr) {
                $btn.prop('disabled', false);
                showAlert('danger', (xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            }
        });
    });

    $('#addToListBtn').on('click', function() {
        var userIds = $('#addUserSelect').val() || [];
        if (!userIds.length) {
            showAlert('warning', i18n.selectAddFirst);
            return;
        }
        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: '/events/' + eventId + '/station-checkin/' + stationId + '/section-list',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ userIds: userIds }),
            success: function() {
                showAlert('success', i18n.addSuccess);
                setTimeout(function() { location.reload(); }, 500);
            },
            error: function(xhr) {
                $btn.prop('disabled', false);
                showAlert('danger', (xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            }
        });
    });

    $(document).on('click', '.remove-from-list-btn', function() {
        var userId = $(this).data('user-id');
        var userName = $(this).data('user-name') || userId;
        if (!userId) return;
        if (!confirm(i18n.removeConfirm.replace('{name}', userName))) return;

        var $btn = $(this).prop('disabled', true);
        $.ajax({
            url: '/events/' + eventId + '/station-checkin/' + stationId + '/section-list/' + userId,
            method: 'DELETE',
            success: function() {
                showAlert('success', i18n.removeSuccess);
                setTimeout(function() { location.reload(); }, 500);
            },
            error: function(xhr) {
                $btn.prop('disabled', false);
                showAlert('danger', (xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            }
        });
    });

    $(document).on('click', '.list-checkin-btn', function() {
        var userId = $(this).data('user-id');
        if (!userId) return;
        var $btn = $(this).prop('disabled', true);
        doCheckIn(userId)
            .done(function() {
                showAlert('success', i18n.checkInSuccess);
                setTimeout(function() { location.reload(); }, 600);
            })
            .fail(function(xhr) {
                $btn.prop('disabled', false);
                handleCheckInError(xhr);
            });
    });

    function parseUserId(decodedText) {
        if (!decodedText) return '';
        var text = String(decodedText).trim();
        if (text.includes(',')) {
            var parts = text.split(',');
            return (parts[parts.length - 1] || '').trim();
        }
        return text;
    }

    function doCheckIn(userId) {
        return $.ajax({
            url: '/events/' + eventId + '/station-checkin/' + stationId + '/checkin',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ userId: userId })
        });
    }

    $('#manualCheckInBtn').on('click', function() {
        var userId = $('#manualUserSelect').val();
        if (!userId) {
            showAlert('warning', i18n.selectUserFirst);
            return;
        }
        doCheckIn(userId)
            .done(function() {
                showAlert('success', i18n.checkInSuccess);
                setTimeout(function() { location.reload(); }, 800);
            })
            .fail(handleCheckInError);
    });

    function stopScanner() {
        if (!html5QrCode || !scanning) return;
        html5QrCode.stop().then(function() {
            scanning = false;
            $('#startScanBtn').prop('disabled', false);
            $('#stopScanBtn').prop('disabled', true);
        }).catch(function() {
            scanning = false;
            $('#startScanBtn').prop('disabled', false);
            $('#stopScanBtn').prop('disabled', true);
        });
    }

    $('#startScanBtn').on('click', function() {
        if (scanning) return;
        if (!html5QrCode) {
            html5QrCode = new Html5Qrcode('reader');
        }
        scanning = true;
        $('#startScanBtn').prop('disabled', true);
        $('#stopScanBtn').prop('disabled', false);
        $('#scanResult').html('');

        html5QrCode.start(
            { facingMode: 'environment' },
            { fps: 10, qrbox: { width: 220, height: 220 } },
            function(decodedText) {
                var userId = parseUserId(decodedText);
                if (!userId) return;
                stopScanner();
                $('#scanResult').html('<span class="status-ok">' + i18n.processing + '</span>');
                doCheckIn(userId)
                    .done(function(res) {
                        var name = (res.user && res.user.name) || userId;
                        $('#scanResult').html('<span class="status-ok">' + i18n.checkInSuccess + ': ' + name + '</span>');
                        setTimeout(function() { location.reload(); }, 1000);
                    })
                    .fail(function(xhr) {
                        var body = xhr.responseJSON || {};
                        var msg = body.message || 'Error';
                        if (body.code === 'NOT_IN_STATION_LIST') {
                            msg = formatNotInListMsg(body);
                            alertBox(msg);
                        } else {
                            showAlert('danger', msg);
                        }
                        $('#scanResult').html('<span class="status-err">' + msg + '</span>');
                    });
            },
            function() {}
        ).catch(function(err) {
            scanning = false;
            $('#startScanBtn').prop('disabled', false);
            $('#stopScanBtn').prop('disabled', true);
            showAlert('danger', 'Camera error: ' + (err && err.message ? err.message : err));
        });
    });

    $('#stopScanBtn').on('click', stopScanner);
});
</script>
