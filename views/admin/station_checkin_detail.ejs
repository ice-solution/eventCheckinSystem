<%- include("components/header") %>
<%- include("components/menu", { eventId: eventId }) %>
<link rel="stylesheet" href="/admin/assets/css/cs-skin-elastic.css">
<link rel="stylesheet" href="/admin/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<link rel="stylesheet" href="/admin/assets/css/style.css">
<%- include("components/responsive_layout_style") %>

<div id="right-panel" class="right-panel">
    <%- include("components/rightpanel_header", { backUrl: '/events/' + eventId + '/station-checkin' }) %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header card-header-with-action">
                            <strong class="card-title">
                                <%= t('station_checkin.stationDetailTitle') %>: <%= station.name %>
                            </strong>
                            <a href="/events/<%= eventId %>/station-checkin/<%= station._id %>/export"
                               class="btn btn-info btn-sm">
                                <i class="fa fa-download"></i> <%= t('station_checkin.exportRecordsBtn') %>
                            </a>
                        </div>
                        <div class="card-body">
                            <% if (station.description) { %>
                                <p class="text-muted mb-3"><%= station.description %></p>
                            <% } %>
                            <p class="text-muted mb-3">
                                <%= t('station_checkin.checkInCount') %>: <strong><%= (records || []).length %></strong>
                            </p>

                            <table id="stationRecordsTable" class="table table-striped table-bordered">
                                <thead>
                                    <tr>
                                        <th><%= t('common.name') %></th>
                                        <th><%= t('common.email') %></th>
                                        <th><%= t('station_checkin.checkedInAt') %></th>
                                        <th><%= t('station_checkin.checkedInBy') %></th>
                                    </tr>
                                </thead>
                                <tbody>
                                    <% if (!records || records.length === 0) { %>
                                        <tr>
                                            <td colspan="4" class="text-muted text-center">
                                                <%= t('station_checkin.recordsEmpty') %>
                                            </td>
                                        </tr>
                                    <% } else { %>
                                        <% records.forEach(function(r) { %>
                                            <%
                                                const atMs = r.checkedInAt ? new Date(r.checkedInAt).getTime() : 0;
                                                const atLabel = r.checkedInAt
                                                    ? new Date(r.checkedInAt).toLocaleString('zh-HK', {
                                                        timeZone: 'Asia/Hong_Kong',
                                                        year: 'numeric',
                                                        month: '2-digit',
                                                        day: '2-digit',
                                                        hour: '2-digit',
                                                        minute: '2-digit',
                                                        second: '2-digit',
                                                        hour12: false
                                                    })
                                                    : '-';
                                            %>
                                            <tr>
                                                <td><%= r.name || '-' %></td>
                                                <td><%= r.email || '-' %></td>
                                                <td data-order="<%= atMs %>"><%= atLabel %></td>
                                                <td><%= r.checkedInBy || '-' %></td>
                                            </tr>
                                        <% }); %>
                                    <% } %>
                                </tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<%- include("components/footer") %>
<script src="/admin/assets/js/lib/data-table/datatables.min.js"></script>
<script src="/admin/assets/js/lib/data-table/dataTables.bootstrap.min.js"></script>
<script>
jQuery(function($) {
    var hasRecords = <%= (records && records.length) ? 'true' : 'false' %>;
    if (!hasRecords || !$.fn.DataTable) return;
    var opts = {
        order: [[2, 'desc']],
        columnDefs: [{
            targets: 2,
            type: 'num',
            render: function(data, type, row, meta) {
                if (type === 'sort' || type === 'type') {
                    var tr = meta.settings.aoData[meta.row].nTr;
                    var td = tr && tr.cells ? tr.cells[meta.col] : null;
                    var v = td ? td.getAttribute('data-order') : null;
                    return v !== null && v !== '' ? parseInt(v, 10) : 0;
                }
                return data;
            }
        }]
    };
    if (typeof initStyledDT === 'function') {
        initStyledDT('stationRecordsTable', opts);
    } else {
        $('#stationRecordsTable').DataTable(opts);
    }
});
</script>
