<%- include("components/header") %>
<%- include("components/menu", { eventId: eventId }) %>
<%- include("components/responsive_layout_style") %>
<link rel="stylesheet" href="/admin/assets/css/style.css">
<link rel="stylesheet" href="/admin/assets/css/lib/datatable/dataTables.bootstrap.min.css">
<style>
    .alert-container { position: fixed; top: 80px; right: 20px; z-index: 1050; min-width: 300px; }
    #reader { width: 100%; max-width: 360px; margin: 0 auto; }
    .scan-panel { border: 1px solid #e4e9f0; border-radius: 10px; padding: 16px; background: #fff; }
    .status-ok { color: #28a745; font-weight: 600; }
    .status-err { color: #dc3545; font-weight: 600; }
</style>

<div id="right-panel" class="right-panel">
    <%- include("components/rightpanel_header", { backUrl: '/events/' + eventId + '/station-checkin' }) %>
    <div class="content">
        <div class="animated fadeIn">
            <div class="row">
                <div class="col-lg-12">
                    <div class="card">
                        <div class="card-header">
                            <strong class="card-title">
                                <%= t('station_checkin.stationDetailTitle') %>: <%= station.name %>
                            </strong>
                        </div>
                        <div class="card-body">
                            <div class="alert-container" id="alertContainer"></div>
                            <% if (station.description) { %>
                                <p class="text-muted"><%= station.description %></p>
                            <% } %>
                            <p class="text-muted small"><%= t('station_checkin.requireEntryNote') %></p>

                            <div class="row">
                                <div class="col-md-5 mb-4">
                                    <div class="scan-panel">
                                        <h5><%= t('station_checkin.scanTitle') %></h5>
                                        <div id="reader"></div>
                                        <div class="mt-2">
                                            <button type="button" class="btn btn-primary btn-sm" id="startScanBtn"><%= t('station_checkin.startScan') %></button>
                                            <button type="button" class="btn btn-secondary btn-sm" id="stopScanBtn" disabled><%= t('station_checkin.stopScan') %></button>
                                        </div>
                                        <div id="scanResult" class="mt-3"></div>
                                    </div>

                                    <div class="scan-panel mt-3">
                                        <h5><%= t('station_checkin.manualTitle') %></h5>
                                        <div class="form-group">
                                            <label><%= t('station_checkin.selectUser') %></label>
                                            <select class="form-control" id="manualUserSelect">
                                                <option value=""><%= t('common.selectOption') %></option>
                                                <% (eligibleUsers || []).forEach(function(u) { %>
                                                    <option value="<%= u._id %>">
                                                        <%= u.name || '-' %><%= u.email ? ' (' + u.email + ')' : '' %>
                                                    </option>
                                                <% }); %>
                                            </select>
                                        </div>
                                        <button type="button" class="btn btn-success" id="manualCheckInBtn">
                                            <%= t('station_checkin.checkInBtn') %>
                                        </button>
                                    </div>
                                </div>

                                <div class="col-md-7">
                                    <h5><%= t('station_checkin.recordsTitle') %> (<%= (records || []).length %>)</h5>
                                    <table id="recordsTable" class="table table-striped table-bordered">
                                        <thead>
                                            <tr>
                                                <th><%= t('common.name') %></th>
                                                <th><%= t('common.email') %></th>
                                                <th><%= t('station_checkin.checkedInAt') %></th>
                                                <th><%= t('station_checkin.checkedInBy') %></th>
                                                <th><%= t('common.actions') %></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% (records || []).forEach(function(r) { %>
                                                <tr>
                                                    <td><%= r.userName || '-' %></td>
                                                    <td><%= r.userEmail || '-' %></td>
                                                    <td><%= r.checkedInAt ? new Date(r.checkedInAt).toLocaleString('zh-HK', { timeZone: 'Asia/Hong_Kong', hour12: false }) : '-' %></td>
                                                    <td><%= r.checkedInBy || '-' %></td>
                                                    <td>
                                                        <button type="button"
                                                            class="btn btn-sm btn-warning uncheck-btn"
                                                            data-user-id="<%= r.userId %>"
                                                            data-user-name="<%= r.userName || '' %>">
                                                            <%= t('station_checkin.uncheckBtn') %>
                                                        </button>
                                                    </td>
                                                </tr>
                                            <% }); %>
                                        </tbody>
                                    </table>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>
<%- include("components/footer_minimal") %>
<script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
<script src="/admin/assets/js/lib/data-table/datatables.min.js"></script>
<script src="/admin/assets/js/lib/data-table/dataTables.bootstrap.min.js"></script>
<script>
jQuery(function($) {
    const eventId = '<%= eventId %>';
    const stationId = '<%= station._id %>';
    let html5QrCode = null;
    let scanning = false;

    if ($.fn.DataTable) {
        $('#recordsTable').DataTable({ order: [[2, 'desc']], pageLength: 25 });
    }

    function showAlert(type, msg) {
        const html = '<div class="alert alert-' + type + ' alert-dismissible fade show" role="alert">' +
            msg +
            '<button type="button" class="close" data-dismiss="alert"><span>&times;</span></button></div>';
        const $a = $(html);
        $('#alertContainer').append($a);
        setTimeout(function() { $a.alert('close'); }, 4000);
    }

    $(document).on('click', '.uncheck-btn', function() {
        const userId = $(this).data('user-id');
        const userName = $(this).data('user-name') || userId;
        if (!userId) return;
        if (!confirm('<%= t("station_checkin.uncheckConfirm") %>'.replace('{name}', userName))) return;

        const $btn = $(this).prop('disabled', true);
        $.ajax({
            url: '/events/' + eventId + '/station-checkin/' + stationId + '/checkin/' + userId,
            method: 'DELETE',
            success: function() {
                showAlert('success', '<%= t("station_checkin.uncheckSuccess") %>');
                setTimeout(function() { location.reload(); }, 600);
            },
            error: function(xhr) {
                $btn.prop('disabled', false);
                showAlert('danger', (xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            }
        });
    });

    function parseUserId(decodedText) {
        if (!decodedText) return '';
        const text = String(decodedText).trim();
        if (text.includes(',')) {
            const parts = text.split(',');
            return (parts[parts.length - 1] || '').trim();
        }
        return text;
    }

    function doCheckIn(userId) {
        return $.ajax({
            url: '/events/' + eventId + '/station-checkin/' + stationId + '/checkin',
            method: 'POST',
            contentType: 'application/json',
            data: JSON.stringify({ userId: userId })
        });
    }

    $('#manualCheckInBtn').on('click', function() {
        const userId = $('#manualUserSelect').val();
        if (!userId) {
            showAlert('warning', '<%= t("station_checkin.selectUserFirst") %>');
            return;
        }
        doCheckIn(userId)
            .done(function() {
                showAlert('success', '<%= t("station_checkin.checkInSuccess") %>');
                setTimeout(function() { location.reload(); }, 800);
            })
            .fail(function(xhr) {
                showAlert('danger', (xhr.responseJSON && xhr.responseJSON.message) || 'Error');
            });
    });

    function stopScanner() {
        if (!html5QrCode || !scanning) return;
        html5QrCode.stop().then(function() {
            scanning = false;
            $('#startScanBtn').prop('disabled', false);
            $('#stopScanBtn').prop('disabled', true);
        }).catch(function() {
            scanning = false;
            $('#startScanBtn').prop('disabled', false);
            $('#stopScanBtn').prop('disabled', true);
        });
    }

    $('#startScanBtn').on('click', function() {
        if (scanning) return;
        if (!html5QrCode) {
            html5QrCode = new Html5Qrcode('reader');
        }
        scanning = true;
        $('#startScanBtn').prop('disabled', true);
        $('#stopScanBtn').prop('disabled', false);
        $('#scanResult').html('');

        html5QrCode.start(
            { facingMode: 'environment' },
            { fps: 10, qrbox: { width: 220, height: 220 } },
            function(decodedText) {
                const userId = parseUserId(decodedText);
                if (!userId) return;
                stopScanner();
                $('#scanResult').html('<span class="status-ok"><%= t("station_checkin.processing") %></span>');
                doCheckIn(userId)
                    .done(function(res) {
                        const name = (res.user && res.user.name) || userId;
                        $('#scanResult').html('<span class="status-ok"><%= t("station_checkin.checkInSuccess") %>: ' + name + '</span>');
                        setTimeout(function() { location.reload(); }, 1000);
                    })
                    .fail(function(xhr) {
                        const msg = (xhr.responseJSON && xhr.responseJSON.message) || 'Error';
                        $('#scanResult').html('<span class="status-err">' + msg + '</span>');
                        showAlert('danger', msg);
                    });
            },
            function() {}
        ).catch(function(err) {
            scanning = false;
            $('#startScanBtn').prop('disabled', false);
            $('#stopScanBtn').prop('disabled', true);
            showAlert('danger', 'Camera error: ' + (err && err.message ? err.message : err));
        });
    });

    $('#stopScanBtn').on('click', stopScanner);
});
</script>
