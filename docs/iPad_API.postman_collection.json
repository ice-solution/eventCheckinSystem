{
  "info": {
    "name": "iPad API",
    "description": "iPad / kiosk JWT API（對照 routes/ipadApi.js）。\n\n使用前請先執行「1) 登入」取得 token，再填入 Collection 變數 eventId / userId / stationId。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3377" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "stationId", "value": "" },
    { "key": "elementId", "value": "" }
  ],
  "item": [
    {
      "name": "1) 登入取得 JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.token) { pm.collectionVariables.set('token', j.token); }",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/login",
        "description": "登入後 token 會自動寫入 collection 變數 `token`（若 Tests 腳本有跑）。"
      }
    },
    {
      "name": "2) 取得所有活動 (events)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events",
        "description": "回傳可存取活動的 name 與 _id。請將要用的 event _id 填入 eventId。"
      }
    },
    {
      "name": "3) 取得活動下的用戶列表",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users",
        "description": "取得該活動 users 陣列。請將要用的 user _id 填入 userId。"
      }
    },
    {
      "name": "3b) 取得 Registration Form Config",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/registration-config",
        "description": "取得 FormConfig，供 kiosk 動態渲染現場登記表單。"
      }
    },
    {
      "name": "3c) 取得單一用戶詳細資料",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "取得指定用戶完整資料。"
      }
    },
    {
      "name": "4a) 更新用戶 - 簽到 (Check-in)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isCheckIn\": true\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "進場簽到。"
      }
    },
    {
      "name": "4b) 更新用戶 - 修改個人資料",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"新姓名\",\n  \"email\": \"new@example.com\",\n  \"phone_code\": \"+852\",\n  \"phone\": \"98765432\",\n  \"company\": \"新公司名稱\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "只傳要更新的欄位；可與 isCheckIn 一併傳送。"
      }
    },
    {
      "name": "4c) 取消簽到",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isCheckIn\": false\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "取消進場簽到並清除 checkInAt。"
      }
    },
    {
      "name": "4d) 新增用戶 (FormConfig)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"email\": \"test@example.com\",\n  \"name\": \"測試用戶\",\n  \"phone_code\": \"+852\",\n  \"phone\": \"12345678\",\n  \"company\": \"測試公司\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users",
        "description": "依 registration-config 欄位現場新增用戶。"
      }
    },
    {
      "name": "4e) 刪除用戶",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "刪除用戶（不可逆）。"
      }
    },
    {
      "name": "5a) 取得 Badge Config",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/badge-config",
        "description": "取得徽章設計；不含 testImageUrl。"
      }
    },
    {
      "name": "5b) 刪除 Badge 元素",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/badge-config/elements/{{elementId}}",
        "description": "elementId 來自 badge-config 的 elements[]._id。"
      }
    },
    {
      "name": "5c) 更新 Badge Config",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Default Badge\",\n  \"width\": 100,\n  \"height\": 62,\n  \"dpi\": 300\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/badge-config",
        "description": "可更新 name/width/height/dpi/elements；傳 elements 會整份替換。"
      }
    },
    {
      "name": "5d) 生成用戶 Badge 圖片",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}/badge",
        "description": "回傳 { imageUrl }，完整路徑為 DOMAIN + imageUrl。"
      }
    },
    {
      "name": "6a) 取得分站列表",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations",
        "description": "請將要用的 station _id 填入 stationId。"
      }
    },
    {
      "name": "6b) 取得分站簽到記錄",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/checkins"
      }
    },
    {
      "name": "6c) 分站簽到",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/checkin",
        "description": "需已完成進場 isCheckIn。"
      }
    },
    {
      "name": "6c2) 取消分站簽到 (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/checkin/{{userId}}"
      }
    },
    {
      "name": "6c3) 取消分站簽到 (POST uncheck)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/uncheck"
      }
    },
    {
      "name": "6d) 用戶各分站簽到狀態",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}/station-checkins"
      }
    }
  ]
}
