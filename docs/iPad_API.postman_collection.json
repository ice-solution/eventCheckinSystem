{
  "info": {
    "name": "iPad API",
    "description": "iPad 端 API：登入、活動、用戶、進場簽到、分站簽到（可選 Check-in Section）、修改客戶個人資料等。\n\n使用前請先執行「1) 登入」取得 token，再呼叫其他需要 Authorization 的請求。\n\n兩個 Check-in Section：後台建立兩個分站 → 6a 拉列表 → App 選 stationId → 6c 簽到。",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:3377" },
    { "key": "token", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "userId", "value": "" },
    { "key": "stationId", "value": "" }
  ],
  "item": [
    {
      "name": "1) 登入取得 JWT",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "try {",
              "  var j = pm.response.json();",
              "  if (j.token) { pm.collectionVariables.set('token', j.token); }",
              "} catch (e) {}"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"your_password\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/login",
        "description": "登入後 token 會自動寫入 collection 變數 `token`（若 Tests 腳本有跑）。"
      }
    },
    {
      "name": "2) 取得所有活動 (events)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events",
        "description": "回傳該帳號可存取的活動 name 與 _id。請將要用的 event _id 填入 collection 變數 eventId。"
      }
    },
    {
      "name": "3) 取得活動下的用戶列表",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users",
        "description": "依 eventId 取得該活動的 users 陣列。請將要用的 user _id 填入 collection 變數 userId。"
      }
    },
    {
      "name": "3c) 取得單一用戶詳細資料",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "取得指定活動下某位用戶的完整資料。"
      }
    },
    {
      "name": "4a) 更新用戶 - 簽到 (Check-in)",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isCheckIn\": true\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "將用戶設為已進場簽到（全域 isCheckIn）。多個 Check-in Section 請改用下方 6c 分站簽到。"
      }
    },
    {
      "name": "4b) 更新用戶 - 修改客戶個人資料",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"新姓名\",\n  \"email\": \"new@example.com\",\n  \"phone_code\": \"+852\",\n  \"phone\": \"98765432\",\n  \"company\": \"新公司名稱\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "修改客戶個人資料，只傳要更新的欄位即可。可與 isCheckIn 一併傳送。"
      }
    },
    {
      "name": "4c) 取消簽到",
      "request": {
        "method": "PUT",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"isCheckIn\": false\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}",
        "description": "將用戶設為未簽到，並清除 checkInAt。"
      }
    },
    {
      "name": "6a) 取得分站列表 (stations)",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations",
        "description": "回傳該活動所有 Check-in Section／分站。請將要用的 station _id 填入 collection 變數 stationId。只顯示 enabled 的站點給操作員選擇。"
      }
    },
    {
      "name": "6b) 取得分站簽到記錄",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/checkins",
        "description": "取得指定分站的簽到記錄列表。"
      }
    },
    {
      "name": "6c) 分站簽到 (選中的 section)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/checkin",
        "description": "對目前選中的 stationId 簽到。尚未進場時會一併寫入 isCheckIn。常見錯誤：ALREADY_CHECKED_IN、NOT_IN_STATION_LIST。"
      }
    },
    {
      "name": "6c2) 取消分站簽到 (DELETE)",
      "request": {
        "method": "DELETE",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/checkin/{{userId}}",
        "description": "取消該用戶在此分站的簽到；不會取消進場 isCheckIn。"
      }
    },
    {
      "name": "6c3) 取消分站簽到 (POST uncheck)",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Authorization", "value": "Bearer {{token}}" },
          { "key": "Content-Type", "value": "application/json" }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"userId\": \"{{userId}}\"\n}"
        },
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/stations/{{stationId}}/uncheck",
        "description": "與 6c2 相同用途，用 body 傳 userId。"
      }
    },
    {
      "name": "6d) 用戶各分站簽到狀態",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/ipad/events/{{eventId}}/users/{{userId}}/station-checkins",
        "description": "查詢某用戶在各分站是否已簽到及時間。"
      }
    }
  ]
}
